{
    "configurations": [
        {
            "name": "elf2x68k",
            "includePath": [
                ".",
                "${workspaceFolder}/**",
                "/opt/homebrew/opt/elf2x68k/m68k-elf/include",
                "/opt/homebrew/opt/elf2x68k/m68k-elf/include/**",
                "/opt/homebrew/opt/elf2x68k/**"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "compilerPath": "/opt/homebrew/opt/elf2x68k/bin/m68k-xelf-gcc",
            "cStandard": "gnu23",
            "cppStandard": "c++17",
            "intelliSenseMode": "${default}",
            "compilerArgs": [
                "-c",
                "-m68000"
            ],
            "browse": {
                "path": []
            }
        },
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c23",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "mergeConfigurations": false,
            "configurationProvider": "elf2x68k",
            "browse": {
                "path": [
                    "${workspaceFolder}/**",
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}