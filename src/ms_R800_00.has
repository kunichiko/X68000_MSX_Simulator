*	------ ＣＡＬＬ ------
CALL_h:
	lea.l	17(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	CALL(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_3
	.else
	ble.s	CALL_o
	lea.l	CALL(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_3
CALL_o:	addq.w	#2,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
CALL:	* オペランド列からnnを取り出す
	move.b	(a4)+,d0		* オペランドの下位バイト
	move.b	(a4)+,d1		* オペランドの上位バイト
	lsl.w	#8,d1			* 上位へ送る。下位バイトは 0 になる
	move.b	d0,d1			* 下位バイトを入れる
	move.w	d1,-(sp)
	; 戻り先アドレスを計算
	; この時点でPC(d7)は次の命令の位置を指しているので、そこの絶対アドレスを計算し
	; スタックに積む
	move.l	d7,d0
	move.w	d7,d1
	andi.w	#PAGEADDRMASK,d1	* 位置は -8192 基準なので上位 3bit を落とす
	lsr.l	#3,d0			* d0 = ppp000??_????????
	andi.w	#%11100000_00000000,d0	* d0 = ppp00000_00000000
	or.w	d0,d1			* d1 = PC (R800)
	subq.w	#2,sp_(a3)		* PUSH	
	move.w	sp_(a3),d0
	write_mem_16	wr16f4,wr16s4,wr16e4
	move.w 	(sp)+,d7
	PC_page_set
	jmp	(a6)

CALL_C_h:
	lea.l	17(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
