*	------ ＪＲ ------
JR_h:
	lea.l	12(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	JR(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	JR_o
	lea.l	JR(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
JR_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
* 相対ジャンプの跳び先は、ほとんどが同じページ内に収まる。
* 位置は -8192 基準（$E000～$FFFF）で持っているので、変位を足した結果が
* その範囲に収まっていればページは変わらない。**16bit の PC を組み立て直す必要も、
* PC_page_set でページを引き直す必要もない。**
* 範囲判定は符号なし比較 1 つで足りる。
*   足しすぎて $0000 台へ回り込んだ → $E000 未満
*   戻しすぎて $DFxx へ下がった   → $E000 未満
JR:	move.b	(a4)+,d1		* オペランドを取得
	ext.w	d1			* ワードに符号拡張
	add.w	d1,d7			* 位置に直接足す
	adda.w	d1,a4
	cmpi.w	#$e000,d7		* ページ内に収まったか
	bcs	jr_cross		* 外れた時だけ張り直す
	jmp	(a6)

* ページをまたいだ時（コールドパス）。16bit のアドレスを組み立て直して張り直す。
* d7.w は「位置-8192＋変位」なので、8192 を足すとページ先頭からの相対位置になる。
* これにページ番号×8192 を足せば R800 の 16bit アドレスになる（桁上げも正しく伝わる）。
jr_cross:
	move.l	d7,d0
	lsr.l	#3,d0			* d0 = ppp000??_????????
	andi.w	#%11100000_00000000,d0	* d0 = ppp00000_00000000
	addi.w	#$2000,d7		* 位置を -8192 基準から戻す
	add.w	d0,d7			* d7 = PC (R800)
	PC_page_set
	jmp	(a6)

JR_NZ_h:
	lea.l	12(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	JR_NZ(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	JR_NZ_o
	lea.l	JR_NZ(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
JR_NZ_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
JR_NZ:
@@:
	btst.l	#6,d6		* Zフラグをテスト
	beq	JR		* Zが0ならジャンプ
	;　条件不成立時はサイクル数が7なので、5引く
	addq.w	#1,a4			* 分岐しない時はオペランドを読まないので進めておく
	subq.l	#5,a5
	jmp	(a6)

JR_Z_h:
