*------ ＡＤＤ ------

;---------------------------------------------------------------------------------------
ADD_A_X macro
* フラグを 8 つとも確定させる。ダーティビットは一つも立てない。
*   H  ＝ (第1項 ^ 第2項 ^ 結果) の bit4
*   C  ＝ 68000 の演算が立てる X（ANDI は X を変えないので roxl で拾える）
*   P/V ＝ 68000 の演算が立てる V
*   S・F5・F3 ＝ 結果のビットをそのまま取る
*   Z  ＝ 結果がゼロか
	move.b	d4,d1			* 第1項
	eor.b	d0,d1			* 第1項 ^ 第2項
	add.b	d0,d4			* 演算実行。C・V・X が確定する
	svs	d3			* V を取り出す
	andi.b	#%00000010,d3		* bit1 ＝ V。ANDI は X を変えない
	roxl.b	#1,d3			* V→bit2、X(＝C)→bit0
	eor.b	d4,d1			* 第1項 ^ 第2項 ^ 結果
	andi.b	#%00010000,d1		* bit4 ＝ H
	or.b	d3,d1			* H | P/V | C
	move.b	d4,d0			* 結果
	andi.b	#%10101000,d0		* S,F5,F3
	tst.b	d4
	bne	@f
	ori.b	#%01000000,d0		* Z
@@:	or.b	d0,d1
	moveq.l	#0,d6			* ダーティも F も全部落とす（N=0）
	move.b	d1,d6
	endm
;---------------------------------------------------------------------------------------

ADD_A_A_h:
	addq.w	#4,a5
ADD_A_A:
* A+A は H・C・P/V をその場で確定できるので、ADD_A_X を使わない。
*   C ＝ bit7 からの桁上げ ＝ 元の A の bit7
*   H ＝ bit3 からの桁上げ ＝ 元の A の bit3
* Z80 の F は bit0 が C、bit4 が H なので、1 ビット左回転で両方が所定の位置に来る。
*   P/V ＝ 符号付き桁溢れ。68000 の add.b が立てる V と一致する
* S,Z,F5,F3 も結果から直接作る。
	move.b	d4,d0			* 元の A
	add.b	d0,d4			* 演算実行。ここで V が確定する
	svs	d1			* V ＝ Z80 の P/V
	rol.b	#1,d0			* bit7→bit0(C)、bit3→bit4(H)
	andi.b	#%00010001,d0		* H と C だけ残す
	andi.b	#%00000100,d1		* P/V だけ残す
	or.b	d1,d0
	move.b	d4,d1			* 結果
	andi.b	#%10101000,d1		* S,F5,F3
	tst.b	d4
	bne	@f
	ori.b	#%01000000,d1		* Z
@@:	or.b	d1,d0
	moveq.l	#0,d6			* ダーティも F も全部落とす（N=0）
	move.b	d0,d6
	jmp	(a6)

ADD_A_B_h:
	addq.w	#4,a5
ADD_A_B:
	move.b	b(a3),d0
	ADD_A_X
	jmp	(a6)

ADD_A_C_h:
	addq.w	#4,a5
ADD_A_C:
	move.b	c(a3),d0
	ADD_A_X
	jmp	(a6)

ADD_A_D_h:
	addq.w	#4,a5
ADD_A_D:
	move.b	d(a3),d0
	ADD_A_X
	jmp	(a6)

ADD_A_E_h:
	addq.w	#4,a5
ADD_A_E:
	move.b	e(a3),d0
	ADD_A_X
	jmp	(a6)

ADD_A_H_h:
	addq.w	#4,a5
ADD_A_H:
	move.b	h(a3),d0
	ADD_A_X
	jmp	(a6)

ADD_A_L_h:
	addq.w	#4,a5
ADD_A_L:
	move.b	l(a3),d0
	ADD_A_X
	jmp	(a6)

ADD_A_lHLl_h:
	addq.w	#7,a5
ADD_A_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f15,rd8s15,rd8e15
	ADD_A_X
	jmp	(a6)

ADD_A_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	ADD_A_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	ADD_A_n_o
	lea.l	ADD_A_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
ADD_A_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
ADD_A_n:
	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	ADD_A_X
	jmp	(a6)

;---------------------------------------------------------------------------------------
; ADD HL,XX の挙動は以下の通り
; * S : 変化しない
; * Z : 変化しない
; * F5: 上位8bitの加算の結果のbit5
; * H : 上位8bitの加算の実行によるハーフキャリー
; * F3: 上位8bitの加算の結果のbit5
; * PV: 変化しない
; * N : 0
; * C : 上位8bitの加算の実行によるキャリー
ADD_HL_XX macro
* ADD HL,rr は S・Z・P/V を変えない。H・C・F5・F3 だけを組み立てる。
*   H  ＝ bit11 からの桁上げ ＝ (第1項 ^ 第2項 ^ 結果) の上位バイトの bit4
*   C  ＝ bit15 からの桁上げ
*   F5・F3 ＝ 結果の上位バイト
	move.b	l(a3),d0
	add.b	target_16+1(a3),d0	* 下位バイトを加算。X に桁上げが残る
	move.b	d0,l(a3)
	move.b	h(a3),d1		* 上位バイト
	move.b	target_16(a3),d2
	move.b	d1,d3
	eor.b	d2,d3			* 第1項 ^ 第2項（上位バイト）
	addx.b	d2,d1			* 上位バイトを加算。C が確定する
	scs	d2			* C を取り出す（Scc は CCR を変えない）
	move.b	d1,h(a3)
	eor.b	d1,d3			* ^ 結果 → bit4 が H
	andi.b	#%00010000,d3
	andi.b	#%00000001,d2
	or.b	d2,d3
	move.b	d1,d2			* 結果の上位バイト
	andi.b	#%00101000,d2		* F5,F3
	or.b	d2,d3
	andi.b	#%11000100,d6		* S,Z,P/V だけ残す
	or.b	d3,d6
	endm
;---------------------------------------------------------------------------------------

ADD_HL_BC_h:
	lea.l	11(a5),a5
ADD_HL_BC:
	move.w	bc(a3),target_16(a3)
	ADD_HL_XX
	jmp	(a6)

ADD_HL_DE_h:
	lea.l	11(a5),a5
ADD_HL_DE:
	move.w	de(a3),target_16(a3)
	ADD_HL_XX
	jmp	(a6)

ADD_HL_HL_h:
	lea.l	11(a5),a5
ADD_HL_HL:
	move.w	hl(a3),target_16(a3)
	ADD_HL_XX
	jmp	(a6)

ADD_HL_SP_h:
	lea.l	11(a5),a5
ADD_HL_SP:
	move.w	sp_(a3),target_16(a3)
	ADD_HL_XX
	jmp	(a6)


*	------ ＡＤＣ ------
;---------------------------------------------------------------------------------------
ADC_A_X macro
	move.w	d0,-(sp)
@@:
	move.w	(sp)+,d0
	btst.l	#0,d6
	beq	ADC_A_X_fallback	* Cy が０の時 ADD と同じ
	; b1  : 加算なのでN=0
* ADD と同じ手で 8 つとも確定させる。H の式は事前キャリーがあっても同じ
	move.b	target_8(a3),d0		* 第2項
	move.b	d4,d1
	eor.b	d0,d1			* 第1項 ^ 第2項
	or.b	#%00010000,ccr		* Xフラグをセット（事前キャリー）
	addx.b	d0,d4			* 演算実行。C・V・X が確定する
	svs	d3
	andi.b	#%00000010,d3
	roxl.b	#1,d3			* V→bit2、X(＝C)→bit0
	eor.b	d4,d1			* ^ 結果 → bit4 が H
	andi.b	#%00010000,d1
	or.b	d3,d1
	move.b	d4,d0			* 結果
	andi.b	#%10101000,d0		* S,F5,F3
	tst.b	d4
	bne	@f
	ori.b	#%01000000,d0		* Z
@@:	or.b	d0,d1
	moveq.l	#0,d6			* ダーティも F も全部落とす（N=0）
	move.b	d1,d6
	endm

ADC_A_X_fallback:
	move.b	target_8(a3),d0	* ADC/SBC は target_8 のまま渡してくる
	ADD_A_X
	jmp	(a6)
;---------------------------------------------------------------------------------------

ADC_A_A_h:
	addq.w	#4,a5
ADC_A_A:
* A+A+C も H・C はその場で確定できるので、ADC_A_X を使わない。
*   C ＝ bit7 からの桁上げ ＝ 元の A の bit7
*   H ＝ bit3 からの桁上げ ＝ 元の A の bit3
* 2A の bit0 は必ず 0 なので、事前キャリーを足しても桁上げの位置は変わらない。
*   P/V ＝ 符号付き桁溢れ。68000 の addx.b が立てる V と一致する
* S,Z,F5,F3 も結果から直接作る。
	move.b	d4,d0			* 元の A
	move.b	d6,d1			* Ｆ
	lsr.b	#1,d1			* bit0(C) を X へ送る
	addx.b	d0,d4			* 演算実行。ここで V が確定する
	svs	d1			* V ＝ Z80 の P/V
	rol.b	#1,d0			* bit7→bit0(C)、bit3→bit4(H)
	andi.b	#%00010001,d0		* H と C だけ残す
	andi.b	#%00000100,d1		* P/V だけ残す
	or.b	d1,d0
	move.b	d4,d1			* 結果
	andi.b	#%10101000,d1		* S,F5,F3
	tst.b	d4
	bne	@f
	ori.b	#%01000000,d1		* Z
@@:	or.b	d1,d0
	moveq.l	#0,d6			* ダーティも F も全部落とす（N=0）
	move.b	d0,d6
	jmp	(a6)

ADC_A_B_h:
	addq.w	#4,a5
ADC_A_B:
	move.b	b(a3),target_8(a3)
	ADC_A_X
	jmp	(a6)

ADC_A_C_h:
	addq.w	#4,a5
ADC_A_C:
	move.b	c(a3),target_8(a3)
	ADC_A_X
	jmp	(a6)

ADC_A_D_h:
	addq.w	#4,a5
ADC_A_D:
	move.b	d(a3),target_8(a3)
	ADC_A_X
	jmp	(a6)

ADC_A_E_h:
	addq.w	#4,a5
ADC_A_E:
	move.b	e(a3),target_8(a3)
	ADC_A_X
	jmp	(a6)

ADC_A_H_h:
	addq.w	#4,a5
ADC_A_H:
	move.b	h(a3),target_8(a3)
	ADC_A_X
	jmp	(a6)

ADC_A_L_h:
	addq.w	#4,a5
ADC_A_L:
	move.b	l(a3),target_8(a3)
	ADC_A_X
	jmp	(a6)

ADC_A_lHLl_h:
	addq.w	#7,a5
ADC_A_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f16,rd8s16,rd8e16
	move.b	d0,target_8(a3)
	ADC_A_X
	jmp	(a6)

ADC_A_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	ADC_A_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	ADC_A_n_o
	lea.l	ADC_A_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
ADC_A_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
ADC_A_n:
	* オペランド列からnを取り出す
	move.b	(a4)+,target_8(a3)
	ADC_A_X
	jmp	(a6)

*	------ ＳＵＢ ------
;---------------------------------------------------------------------------------------
SUB_A_X macro
* フラグを 8 つとも確定させる。ダーティビットは一つも立てない。
*   H  ＝ (第1項 ^ 第2項 ^ 結果) の bit4
*   C  ＝ 68000 の演算が立てる X（ANDI は X を変えないので roxl で拾える）
*   P/V ＝ 68000 の演算が立てる V
*   S・F5・F3 ＝ 結果のビットをそのまま取る
*   Z  ＝ 結果がゼロか
	move.b	d4,d1			* 第1項
	eor.b	d0,d1			* 第1項 ^ 第2項
	sub.b	d0,d4			* 演算実行。C（借り）・V・X が確定する
	svs	d3
	andi.b	#%00000010,d3
	roxl.b	#1,d3			* V→bit2、X(＝C)→bit0
	eor.b	d4,d1
	andi.b	#%00010000,d1		* bit4 ＝ H
	or.b	d3,d1
	move.b	d4,d0			* 結果
	andi.b	#%10101000,d0		* S,F5,F3
	tst.b	d4
	bne	@f
	ori.b	#%01000000,d0		* Z
@@:	or.b	d0,d1
	ori.b	#%00000010,d1		* N=1
	moveq.l	#0,d6			* ダーティも F も全部落とす
	move.b	d1,d6
	endm
;---------------------------------------------------------------------------------------

SUB_A_h:
	addq.w	#4,a5
SUB_A:
* A － A は必ず 0 になる。借りも桁溢れも起きないのでフラグは定数。
	moveq.l	#0,d4			* A ＝ 0
	moveq.l	#%01000010,d6		* Z=1, N=1。S,F5,F3,H,P/V,C は 0
	jmp	(a6)

SUB_B_h:
	addq.w	#4,a5
SUB_B:	move.b	b(a3),d0
	SUB_A_X
	jmp	(a6)

SUB_C_h:
	addq.w	#4,a5
SUB_C:	move.b	c(a3),d0
	SUB_A_X
	jmp	(a6)

SUB_D_h:
	addq.w	#4,a5
SUB_D:	move.b	d(a3),d0
	SUB_A_X
	jmp	(a6)

SUB_E_h:
	addq.w	#4,a5
SUB_E:	move.b	e(a3),d0
	SUB_A_X
	jmp	(a6)

SUB_H_h:
	addq.w	#4,a5
SUB_H:	move.b	h(a3),d0
	SUB_A_X
	jmp	(a6)

SUB_L_h:
	addq.w	#4,a5
SUB_L:	move.b	l(a3),d0
	SUB_A_X
	jmp	(a6)

SUB_lHLl_h:
	addq.w	#7,a5
SUB_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f17,rd8s17,rd8e17
	SUB_A_X
	jmp	(a6)

SUB_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	SUB_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	SUB_n_o
	lea.l	SUB_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
SUB_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
SUB_n:
	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	SUB_A_X
	jmp	(a6)

*	------ ＳＢＣ ------
;---------------------------------------------------------------------------------------
SBC_A_X macro
@@:
	btst.l	#0,d6
	beq	SBC_A_X_fallback		* Cy が０の時 SUB と同じ
	; b1  : 減算なのでN=1
* SUB と同じ手で 8 つとも確定させる。H の式は事前借りがあっても同じ
	move.b	target_8(a3),d0		* 第2項
	move.b	d4,d1
	eor.b	d0,d1			* 第1項 ^ 第2項
	or.b	#%00010000,ccr		* Xフラグをセット（事前借り）
	subx.b	d0,d4			* 演算実行。C・V・X が確定する
	svs	d3
	andi.b	#%00000010,d3
	roxl.b	#1,d3			* V→bit2、X(＝C)→bit0
	eor.b	d4,d1			* ^ 結果 → bit4 が H
	andi.b	#%00010000,d1
	or.b	d3,d1
	move.b	d4,d0			* 結果
	andi.b	#%10101000,d0		* S,F5,F3
	tst.b	d4
	bne	@f
	ori.b	#%01000000,d0		* Z
@@:	or.b	d0,d1
	ori.b	#%00000010,d1		* N=1
	moveq.l	#0,d6			* ダーティも F も全部落とす
	move.b	d1,d6
	endm

SBC_A_X_fallback:
	move.b	target_8(a3),d0	* ADC/SBC は target_8 のまま渡してくる
	SUB_A_X
	jmp	(a6)
;---------------------------------------------------------------------------------------

SBC_A_A_h:
	addq.w	#4,a5
SBC_A_A:
* A － A － C。結果は C が 0 なら $00、1 なら $FF で、A の値に依らない。
* フラグもそれぞれ定数になる。
	btst.l	#0,d6			* C
	bne	SBC_A_A_c
	moveq.l	#0,d4			* A ＝ $00
	moveq.l	#%01000010,d6		* Z=1, N=1
	jmp	(a6)
SBC_A_A_c:
	st.b	d4			* A ＝ $FF。上位バイトは変えない
	moveq.l	#0,d6
	move.b	#%10111011,d6		* S,F5,H,F3,N,C。moveq は符号拡張するので使えない
	jmp	(a6)

SBC_A_B_h:
	addq.w	#4,a5
SBC_A_B:
	move.b	b(a3),target_8(a3)
	SBC_A_X
	jmp	(a6)

SBC_A_C_h:
	addq.w	#4,a5
SBC_A_C:
	move.b	c(a3),target_8(a3)
	SBC_A_X
	jmp	(a6)

SBC_A_D_h:
	addq.w	#4,a5
SBC_A_D:
	move.b	d(a3),target_8(a3)
	SBC_A_X
	jmp	(a6)

SBC_A_E_h:
	addq.w	#4,a5
SBC_A_E:
	move.b	e(a3),target_8(a3)
	SBC_A_X
	jmp	(a6)

SBC_A_H_h:
	addq.w	#4,a5
SBC_A_H:
	move.b	h(a3),target_8(a3)
	SBC_A_X
	jmp	(a6)

SBC_A_L_h:
	addq.w	#4,a5
SBC_A_L:
	move.b	l(a3),target_8(a3)
	SBC_A_X
	jmp	(a6)

SBC_A_lHLl_h:
	addq.w	#7,a5
SBC_A_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f18,rd8s18,rd8e18
	move.b	d0,target_8(a3)
	SBC_A_X
	jmp	(a6)

SBC_A_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	SBC_A_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	SBC_A_n_o
	lea.l	SBC_A_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
SBC_A_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
SBC_A_n:
	* オペランド列からnを取り出す
	move.b	(a4)+,target_8(a3)
	SBC_A_X
	jmp	(a6)


*	------ ＡＮＤ ------
;---------------------------------------------------------------------------------------
AND_X	macro
	; b4  : AND演算時はH=1固定
	; b1  : 論理演算時はN=0
	; b0  : AND演算時はC=0固定
* 論理演算のフラグはすべて結果だけから決まる。S,Z,F5,F3,P/V は szp53p_tbl を
* 1 回引けば同時に得られ、H と C は固定値。
	and.b	d0,d4			* 演算実行
	moveq.l	#0,d6			* ダーティも F も全部落とす
	move.b	szp53p(a3,d4.w),d6	* S,Z,F5,F3,P/V を一度に引く
	ori.b	#%00010000,d6		* AND は H=1 固定（C=0、N=0）
	endm
;---------------------------------------------------------------------------------------

AND_A_h:
	addq.w	#4,a5
AND_A:
* A ＆ A は A のまま。フラグは結果だけから決まる。
	moveq.l	#0,d6			* C=0、N=0
	move.b	szp53p(a3,d4.w),d6	* S,Z,F5,F3,P/V を一度に引く
	ori.b	#%00010000,d6		* AND は H=1 固定
	jmp	(a6)

AND_B_h:
	addq.w	#4,a5
AND_B:	move.b	b(a3),d0
	AND_X
	jmp	(a6)

AND_C_h:
	addq.w	#4,a5
AND_C:	move.b	c(a3),d0
	AND_X
	jmp	(a6)

AND_D_h:
	addq.w	#4,a5
AND_D:	move.b	d(a3),d0
	AND_X
	jmp	(a6)

AND_E_h:
	addq.w	#4,a5
AND_E:	move.b	e(a3),d0
	AND_X
	jmp	(a6)

AND_H_h:
	addq.w	#4,a5
AND_H:	move.b	h(a3),d0
	AND_X
	jmp	(a6)

AND_L_h:
	addq.w	#4,a5
AND_L:	move.b	l(a3),d0
	AND_X
	jmp	(a6)

AND_lHLl_h:
	addq.w	#7,a5
AND_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f19,rd8s19,rd8e19
	AND_X
	jmp	(a6)

AND_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	AND_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	AND_n_o
	lea.l	AND_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
AND_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
AND_n:	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	AND_X
	jmp	(a6)

*	------ ＸＯＲ ------
;---------------------------------------------------------------------------------------
_OR_X	macro	opname
	; b4  : OR/XOR演算時はH=0固定
	; b1  : 論理演算時はN=0
	; b0  : AND演算時はC=0固定
* 論理演算のフラグはすべて結果だけから決まる。S,Z,F5,F3,P/V は szp53p_tbl を
* 1 回引けば同時に得られ、H と C は固定値。
	opname.b	d0,d4			* 演算実行
	moveq.l	#0,d6			* ダーティも F も全部落とす（H=0、C=0、N=0）
	move.b	szp53p(a3,d4.w),d6	* S,Z,F5,F3,P/V を一度に引く
	endm
;---------------------------------------------------------------------------------------

XOR_A_h:
	addq.w	#4,a5
XOR_A:
* A ^ A は必ず 0 になる。フラグも定数で、szp53p_tbl の先頭と一致する。
	moveq.l	#0,d4			* A ＝ 0
	moveq.l	#%01000100,d6		* Z=1, P/V=1。S,F5,F3,H,N,C は 0
	jmp	(a6)	

XOR_B_h:
	addq.w	#4,a5
XOR_B:	move.b	b(a3),d0
	_OR_X	eor
	jmp	(a6)

XOR_C_h:
	addq.w	#4,a5
XOR_C:	move.b	c(a3),d0
	_OR_X	eor
	jmp	(a6)

XOR_D_h:
	addq.w	#4,a5
XOR_D:	move.b	d(a3),d0
	_OR_X	eor
	jmp	(a6)

XOR_E_h:
	addq.w	#4,a5
XOR_E:	move.b	e(a3),d0
	_OR_X	eor
	jmp	(a6)

XOR_H_h:
	addq.w	#4,a5
XOR_H:	move.b	h(a3),d0
	_OR_X	eor
	jmp	(a6)

XOR_L_h:
	addq.w	#4,a5
XOR_L:	move.b	l(a3),d0
	_OR_X	eor
	jmp	(a6)

XOR_lHLl_h:
	addq.w	#7,a5
XOR_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f20,rd8s20,rd8e20
	_OR_X	eor
	jmp	(a6)

XOR_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	XOR_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	XOR_n_o
	lea.l	XOR_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
XOR_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
XOR_n:	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	_OR_X	eor
	jmp	(a6)

*	------ ＯＲ ------
