*	------ ＡＤＣ ------

;---------------------------------------------------------------------------------------
; ADC HL,XX の挙動は以下の通り
; * S : 結果のHLのbit15
; * Z : 結果のHLが0の時1、それ以外の時0
; * F5: 上位8bitの加算の結果のbit5
; * H : 上位8bitの加算の実行によるハーフキャリー
; * F3: 上位8bitの加算の結果のbit5
; * PV: 上位8bitの加算の実行によるオーバーフロー
; * N : 0
; * C : 上位8bitの加算の実行によるキャリー
ADC_HL_XX macro
* 16bit も 8bit と同じ手で 8 つとも確定させる。上位バイトの演算で得られる
*   H  ＝ (第1項上位 ^ 第2項上位 ^ 結果上位) の bit4 ＝ bit11 からの桁上げ
*   C  ＝ bit15 からの桁上げ / P/V ＝ 16bit の符号付き桁溢れ
* Z だけは 16bit 全体を見る。
	move.b	l(a3),d0
	move.b	target_16+1(a3),d2
	btst.l	#0,d6			* 演算前のキャリーを X へ
	bne	1f
	andi.b	#%11101111,ccr
	bra	2f
1:	ori.b	#%00010000,ccr
2:	addx.b	d2,d0			* 下位バイト。X に桁上げが残る
	move.b	d0,l(a3)
	move.b	h(a3),d1		* 上位バイト
	move.b	target_16(a3),d2
	move.b	d1,d3
	eor.b	d2,d3			* 第1項上位 ^ 第2項上位
	addx.b	d2,d1			* 上位バイト。C・V・X が確定する
	svs	d2
	andi.b	#%00000010,d2
	roxl.b	#1,d2			* V→bit2、X(＝C)→bit0
	eor.b	d1,d3			* ^ 結果上位 → bit4 が H
	andi.b	#%00010000,d3
	or.b	d2,d3
	move.b	d1,h(a3)
	move.b	d1,d2			* 結果の上位バイト
	andi.b	#%10101000,d2		* S,F5,F3
	or.b	d2,d3
	move.w	hl(a3),d2		* Z は 16bit 全体で見る
	bne	@f
	ori.b	#%01000000,d3		* Z
@@:
	moveq.l	#0,d6			* ダーティも F も全部落とす
	move.b	d3,d6
	endm
;---------------------------------------------------------------------------------------

ADC_HL_BC_h:
	lea.l	15(a5),a5
ADC_HL_BC:
	move.w	bc(a3),target_16(a3)
	ADC_HL_XX
	jmp	(a6)

ADC_HL_DE_h:
	lea.l	15(a5),a5
ADC_HL_DE:
	move.w	de(a3),target_16(a3)
	ADC_HL_XX
	jmp	(a6)

ADC_HL_HL_h:
	lea.l	15(a5),a5
ADC_HL_HL:
	move.w	hl(a3),target_16(a3)
	ADC_HL_XX
	jmp	(a6)

ADC_HL_SP_h:
	lea.l	15(a5),a5
ADC_HL_SP:
	move.w	sp_(a3),target_16(a3)
	ADC_HL_XX
	jmp	(a6)

*	------ ＳＢＣ ------

;---------------------------------------------------------------------------------------
; SBC HL,XX の挙動は以下の通り
; * S : 結果のHLのbit15
; * Z : 結果のHLが0の時1、それ以外の時0
; * F5: 上位8bitの減算の結果のbit5
; * H : 上位8bitの減算の実行によるハーフキャリー
; * F3: 上位8bitの減算の結果のbit5
; * PV: 上位8bitの減算の実行によるオーバーフロー
; * N : 1
; * C : 上位8bitの減算の実行によるキャリー
SBC_HL_XX macro
* 16bit も 8bit と同じ手で 8 つとも確定させる。上位バイトの演算で得られる
*   H  ＝ (第1項上位 ^ 第2項上位 ^ 結果上位) の bit4 ＝ bit11 からの桁上げ
*   C  ＝ bit15 からの桁上げ / P/V ＝ 16bit の符号付き桁溢れ
* Z だけは 16bit 全体を見る。
	move.b	l(a3),d0
	move.b	target_16+1(a3),d2
	btst.l	#0,d6			* 演算前のキャリーを X へ
	bne	1f
	andi.b	#%11101111,ccr
	bra	2f
1:	ori.b	#%00010000,ccr
2:	subx.b	d2,d0			* 下位バイト。X に桁上げが残る
	move.b	d0,l(a3)
	move.b	h(a3),d1		* 上位バイト
	move.b	target_16(a3),d2
	move.b	d1,d3
	eor.b	d2,d3			* 第1項上位 ^ 第2項上位
	subx.b	d2,d1			* 上位バイト。C・V・X が確定する
	svs	d2
	andi.b	#%00000010,d2
	roxl.b	#1,d2			* V→bit2、X(＝C)→bit0
	eor.b	d1,d3			* ^ 結果上位 → bit4 が H
	andi.b	#%00010000,d3
	or.b	d2,d3
	move.b	d1,h(a3)
	move.b	d1,d2			* 結果の上位バイト
	andi.b	#%10101000,d2		* S,F5,F3
	or.b	d2,d3
	move.w	hl(a3),d2		* Z は 16bit 全体で見る
	bne	@f
	ori.b	#%01000000,d3		* Z
@@:
	ori.b	#%00000010,d3		* N=1
	moveq.l	#0,d6			* ダーティも F も全部落とす
	move.b	d3,d6
	endm
;---------------------------------------------------------------------------------------

SBC_HL_BC_h:
	lea.l	15(a5),a5
SBC_HL_BC:
	move.w	bc(a3),target_16(a3)
	SBC_HL_XX
	jmp	(a6)

SBC_HL_DE_h:
	lea.l	15(a5),a5
SBC_HL_DE:
	move.w	de(a3),target_16(a3)
	SBC_HL_XX
	jmp	(a6)

SBC_HL_HL_h:
	lea.l	15(a5),a5
SBC_HL_HL:
	move.w	hl(a3),target_16(a3)
	SBC_HL_XX
	jmp	(a6)

SBC_HL_SP_h:
	lea.l	15(a5),a5
SBC_HL_SP:
	move.w	sp_(a3),target_16(a3)
	SBC_HL_XX
	jmp	(a6)

*	------ ＬＤＩ ------
; LDI の挙動は以下の通り
; (de) <= (hl)
; hl += 1, de += 1, bc -= 1
; フラグ変化は以下の通り
; * S : 変化しない
; * Z : 変化しない
; * F5: (転送された値にAレジスタを足した値)のbit1 (5ではなく1)
; * H : 0
; * F3: (転送された値にAレジスタを足した値)のbit3
; * PV: bc が 0 の時0、それ以外の時1
; * N : 0
; * C : 変化しない
LDI_dispatch_h:
	lea.l	16(a5),a5
LDI_dispatch:
	bsr	LDI			* LDIR が部品として使うため LDI は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
LDI:	andi.b	#%11000001,d6		* S,Z,Ｃ だけ残す
	move.w	hl(a3),d0
	read_mem_8	rd8f38,rd8s38,rd8e38
	move.b	d0,d1
	add.b	d4,d0			* 転送値にAレジスタを足す
	move.b	d0,d2
	andi.b	#%00001000,d0
	or.b	d0,d6			* F3をセット
	andi.b	#%00000010,d2
	lsl.b	#4,d2
	or.b	d2,d6			* F5をセット
	move.w	de(a3),d0
	write_mem_8	wr8f24,wr8s24,wr8e24
	addq.w	#1,hl(a3)
	addq.w	#1,de(a3)
	subq.w	#1,bc(a3)
	beq	@f
	ori.b	#%00000100,d6		* PVをセット
@@:	rts


; LDIR の挙動は以下の通り
; LDI実行後、
; if bc != 0 then
;     PC -=2 (LDIRを繰り返す)
; else
;     終了
;
; LDIRの命令内で転送を繰り返すのではなく、PCを-2するというのがポイント
; なのでLDIRの実行中に割り込みが入ることも想定される(はず)
LDIR_h:
	lea.l	21(a5),a5
LDIR:
	bsr	LDI
	cmpi.w	#0,bc(a3)
	bne	@f
	; 最終の場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7	* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)

; LDD の挙動は以下の通り
; (de) <= (hl)
; hl -= 1, de -= 1, bc -= 1
; フラグ変化は以下の通り
; * S : 変化しない
; * Z : 変化しない
; * F5: (転送された値にAレジスタを足した値)のbit1 (5ではなく1)
; * H : 0
; * F3: (転送された値にAレジスタを足した値)のbit3
; * PV: bc が 0 の時0、それ以外の時1
; * N : 0
; * C : 変化しない
LDD_dispatch_h:
	lea.l	16(a5),a5
LDD_dispatch:
	bsr	LDD			* LDDR が部品として使うため LDD は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
LDD:	andi.b	#%11000001,d6		* S,Z,Ｃ だけ残す
	move.w	hl(a3),d0
	read_mem_8	rd8f39,rd8s39,rd8e39
	move.b	d0,d1
	add.b	d4,d0			* 転送値にAレジスタを足す
	move.b	d0,d2
	andi.b	#%00001000,d0
	or.b	d0,d6			* F3をセット
	andi.b	#%00000010,d2
	lsl.b	#4,d2
	or.b	d2,d6			* F5をセット
	move.w	de(a3),d0
	write_mem_8	wr8f25,wr8s25,wr8e25
	subq.w	#1,hl(a3)
	subq.w	#1,de(a3)
	subq.w	#1,bc(a3)
	beq	@f
	ori.b	#%00000100,d6		* PVをセット
@@:	rts

; LDDR の挙動は以下の通り
; LDD実行後、
; if bc != 0 then
;     PC -=2 (LDDRを繰り返す)
; else
;     終了
;
; LDDRの命令内で転送を繰り返すのではなく、PCを-2するというのがポイント
; なのでLDDRの実行中に割り込みが入ることも想定される(はず)
LDDR_h:
	lea.l	21(a5),a5
LDDR:
	bsr	LDD
	cmpi.w	#0,bc(a3)
	bne	@f
	; 最終の場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7	* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)


*	------ ＣＰＩ ------
; CPI の挙動は以下の通り
; A - (HL) を実行した結果をフラグに反映(S,Z,HC)
; hl += 1, bc -= 1
; フラグ変化は以下の通り
; * S : 結果のbit7
; * Z : 結果が0の時1、それ以外の時0
; * F5: (A - (HL) - HC)のbit1 (5ではなく1)
; * H : 結果のハーフキャリー
; * F3: (A - (HL) - HC)のbit3
; * PV: BC が 0 の時0、それ以外の時1
; * N : 1
; * C : 変化しない
CPI_dispatch_h:
	lea.l	16(a5),a5
CPI_dispatch:
	bsr	CPI			* CPIR が部品として使うため CPI は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
CPI:
1:
	move.w	hl(a3),d0
	read_mem_8	rd8f40,rd8s40,rd8e40
	move.b	d4,d2
	move.b	d2,d1
	eor.b	d0,d1			* Ａ ^ 引く数
	sub.b	d0,d2			* Ａ - 引く数
	eor.b	d2,d1			* ^ 結果 → bit4 ＝ H
	andi.b	#%00010000,d1
	move.b	d2,d0
	andi.b	#%10000000,d0		* S
	or.b	d1,d0			* H
	tst.b	d2
	bne	2f
	ori.b	#%01000000,d0		* Z
2:	lsr.b	#4,d1			* H を 0/1 に
	sub.b	d1,d2			* F5,F3 は H を引いた値から取る
	move.b	d2,d1
	andi.b	#%00001000,d1
	or.b	d1,d0			* F3
	andi.b	#%00000010,d2
	lsl.b	#4,d2
	or.b	d2,d0			* F5
	ori.b	#%00000010,d0		* N
	addq.w	#1,hl(a3)
	subq.w	#1,bc(a3)
	beq	3f
	ori.b	#%00000100,d0		* PV
3:	andi.b	#%00000001,d6		* Ｃ だけ残す
	or.b	d0,d6
	rts

CPIR_h:
	lea.l	21(a5),a5
CPIR:	bsr	CPI
	cmpi.w	#0,bc(a3)
	bne	@f
	; 最終の場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:
@@:
	btst.l	#6,d6			* Zフラグを評価
	beq	@f
	; 最終の場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7	* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)

*	------ ＣＰＤ ------
; CPD の挙動は以下の通り
; A - (HL) を実行した結果をフラグに反映(S,Z,HC)
; hl -= 1, bc -= 1
; フラグ変化は以下の通り
; * S : 結果のbit7
; * Z : 結果が0の時1、それ以外の時0
; * F5: (A - (HL) - HC)のbit1 (5ではなく1)
; * H : 結果のハーフキャリー
; * F3: (A - (HL) - HC)のbit3
; * PV: BC が 0 の時0、それ以外の時1
; * N : 1
; * C : 変化しない
CPD_dispatch_h:
	lea.l	16(a5),a5
CPD_dispatch:
	bsr	CPD			* CPDR が部品として使うため CPD は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
CPD:
1:
	move.w	hl(a3),d0
	read_mem_8	rd8f41,rd8s41,rd8e41
	move.b	d4,d2
	move.b	d2,d1
	eor.b	d0,d1			* Ａ ^ 引く数
	sub.b	d0,d2			* Ａ - 引く数
	eor.b	d2,d1			* ^ 結果 → bit4 ＝ H
	andi.b	#%00010000,d1
	move.b	d2,d0
	andi.b	#%10000000,d0		* S
	or.b	d1,d0			* H
	tst.b	d2
	bne	2f
	ori.b	#%01000000,d0		* Z
2:	lsr.b	#4,d1			* H を 0/1 に
	sub.b	d1,d2			* F5,F3 は H を引いた値から取る
	move.b	d2,d1
	andi.b	#%00001000,d1
	or.b	d1,d0			* F3
	andi.b	#%00000010,d2
	lsl.b	#4,d2
	or.b	d2,d0			* F5
	ori.b	#%00000010,d0		* N
	subq.w	#1,hl(a3)
	subq.w	#1,bc(a3)
	beq	3f
	ori.b	#%00000100,d0		* PV
3:	andi.b	#%00000001,d6		* Ｃ だけ残す
	or.b	d0,d6
	rts


CPDR_h:
	lea.l	21(a5),a5
CPDR:	bsr	CPD
	cmpi.w	#0,bc(a3)
	bne	@f
	; 最終の場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:
@@:
	btst.l	#6,d6			* Zフラグを評価
	beq	@f
	; 最終の場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7	* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)



*	------ ＮＥＧ ------
; NEG の挙動は以下の通り
; A = 0 - A
; フラグ変化は以下の通り
; * S : 結果のbit7
; * Z : 結果が0の時1、それ以外の時0
; * F5: 結果のbit5
; * H : 結果のハーフキャリー
; * F3: 結果のbit3
; * PV: 結果がオーバーフローした時1、それ以外の時0
; * N : 1
; * C : 結果がキャリーした時1、それ以外の時0
NEG_h:
	lea.l	8(a5),a5
NEG:
	; b1  : 減算なのでN=1
* SUB と同じ手で 8 つとも確定させる。第1項は 0 なので
* H ＝ (0 ^ A ^ 結果) の bit4、P/V は 68000 の V、C は借り。
	move.b	d4,d1			* 第1項(0) ^ 第2項(A) ＝ A
	moveq.l	#0,d0
	sub.b	d4,d0			* 演算実行。C（借り）・V・X が確定する
	svs	d3
	andi.b	#%00000010,d3
	roxl.b	#1,d3			* V→bit2、X(＝C)→bit0
	eor.b	d0,d1			* ^ 結果 → bit4 が H
	andi.b	#%00010000,d1
	or.b	d3,d1
	move.b	d0,d3			* 結果
	andi.b	#%10101000,d3		* S,F5,F3
	tst.b	d0
	bne	@f
	ori.b	#%01000000,d3		* Z
@@:	or.b	d3,d1
	ori.b	#%00000010,d1		* N=1
	moveq.l	#0,d6			* ダーティも F も全部落とす
	move.b	d1,d6
	move.b	d0,d4			* 結果をAレジスタに保存
	jmp	(a6)

*	------ 掛け算命令 ------

;---------------------------------------------------------------------------------------
; MULB A,X の挙動は以下の通り https://www.msx.org/forum/development/msx-development/r800-multiply-instruction
; HL <= A * X
; ※ ただしXがb,c,d,eのとき以外は動作が保証されないという仕様がある
; フラグ変化は以下の通り
; * S : 0
; * Z : 結果が0の時1、それ以外の時0
; * F5: 変化しない
; * H : 変化しない
; * F3: 変化しない
; * PV: 0
; * N : 変化しない
; * C : 掛け算の結果が8bitを超えた時1、それ以外の時0
;
MULB_A_X macro
	andi.b	#%00111010,d6		* F5,H,F3,Ｎ だけ残す
	clr.w	d0
	andi.w	#$ff,d1		* 引数が d1 で渡ってくるので上位だけ落とす
	move.b	d4,d0			* d0 <- A
	mulu.w	d1,d0
	bne	@f
	ori.w	#%01000000,d6		* Zフラグをセット
@@:	move.w	d0,hl(a3)		* 結果をHLに保存
	andi.w	#$ff00,d0
	beq	@f
	ori.w	#%00000001,d6		* Cフラグをセット
@@:
	endm
;---------------------------------------------------------------------------------------

MULB_A_A_h:
	lea.l	0(a5),a5
MULB_A_A:
	move.b	d4,d1
	MULB_A_X
	jmp	(a6)

MULB_A_B_h:
	lea.l	0(a5),a5
MULB_A_B:
	move.b	b(a3),d1
	MULB_A_X
	jmp	(a6)

MULB_A_C_h:
	lea.l	0(a5),a5
MULB_A_C:
	move.b	c(a3),d1
	MULB_A_X
	jmp	(a6)

MULB_A_D_h:
	lea.l	0(a5),a5
MULB_A_D:
	move.b	d(a3),d1
	MULB_A_X
	jmp	(a6)

MULB_A_E_h:
	lea.l	0(a5),a5
MULB_A_E:
	move.b	e(a3),d1
	MULB_A_X
	jmp	(a6)

MULB_A_H_h:
	lea.l	0(a5),a5
MULB_A_H:
	move.b	h(a3),d1
	MULB_A_X
	jmp	(a6)

MULB_A_L_h:
	lea.l	0(a5),a5
MULB_A_L:
	move.b	l(a3),d1
	MULB_A_X
	jmp	(a6)

;---------------------------------------------------------------------------------------
; MULW HL,XX の挙動は以下の通り https://www.msx.org/forum/development/msx-development/r800-multiply-instruction
; DE:HL <= HL * XX
; ※ ただしXがBC,SPのとき以外は動作が保証されないという仕様がある
; フラグ変化は以下の通り
; * S : 0
; * Z : 結果が0の時1、それ以外の時0
; * F5: 変化しない
; * H : 変化しない
; * F3: 変化しない
; * PV: 0
; * N : 変化しない
; * C : 掛け算の結果が16bitを超えた時1、それ以外の時0
MULW_HL_XX macro
	andi.b	#%00111010,d6		* F5,H,F3,Ｎ だけ残す
	move.w	hl(a3),d0		* d0 <- HL
	move.w	target_16(a3),d1	* d1 <- target
	mulu.w	d1,d0			* d0.l <= d0.w * d1.w (mulu.wは結果が32bitでd0に格納されるので注意)
	bne	@f
	ori.w	#%01000000,d6		* Zフラグをセット
@@:	move.w	d0,hl(a3)		* 結果の下位16bitをHLに保存
	swap	d0
	move.w	d0,de(a3)		* 結果の上位16bitをDEに保存
	beq	@f
	ori.w	#%00000001,d6		* 上位16bitが0じゃない場合はCフラグをセット
@@:
	endm
;---------------------------------------------------------------------------------------

MULW_HL_BC_h:
	lea.l	0(a5),a5
MULW_HL_BC:
	move.w	bc(a3),target_16(a3)
	MULW_HL_XX
	jmp	(a6)

MULW_HL_DE_h:
	lea.l	0(a5),a5
MULW_HL_DE:
	move.w	de(a3),target_16(a3)
	MULW_HL_XX
	jmp	(a6)

MULW_HL_HL_h:
	lea.l	0(a5),a5
MULW_HL_HL:
	move.w	hl(a3),target_16(a3)
	MULW_HL_XX
	jmp	(a6)

MULW_HL_SP_h:
	lea.l	0(a5),a5
MULW_HL_SP:
	move.w	sp_(a3),target_16(a3)
	MULW_HL_XX
	jmp	(a6)


*	------ ＬＤ Ｒ ------
*	RレジスタはM1サイクルごとにインクリメントされるレジスタ
*	LD R,A で代入も可能。インクリメントされるのは下位7bit(Z80)のため、
*	bit7は LR R,Aで代入した値がそのまま残る
*	ms.x では、M1サイクルを正確に数えていないので、emu_counterで代用
; LD A,R の挙動は以下の通り
; * S : Rのbit7
; * Z : Rが0の時1、それ以外の時0
; * F5: 変化しない
; * H : 0
; * F3: 変化しない
; * PV: IFF2の値
; * N : 0
; * C : 変化しない
LD_A_R_h:
	lea.l	9(a5),a5
LD_A_R:
@@:
	andi.b	#%00101001,d6		* S,Z,H,P/V,Ｎ を落とす
	move.b	r(a3),d4
	; bit7はLD R,Aで代入した値がそのまま残る
	andi.b	#%10000000,d4		* bit7 を取り出す
	; Rレジスタは下位7bitのみがインクリメントされる
	tst.b	cpu_fast_enabled
	bne	2f
	move.l	emu_counter,d0
	sub.l	emu_counter_latch_r,d0
	bra	3f
*	高速版では emu_counter が進まないので、Ｔステートの累算から作る
2:	move.l	a5,d0
	sub.l	cpu_cycle_latch_r,d0
	lsr.l	#2,d0			* Ｔステートから M1 回数へ均す
3:	add.b	r(a3),d0
	andi.b	#%01111111,d0		* 下位7bitのみ
	or.b	d0,d4
	bne	1f
	ori.w	#%01000000,d6		* Zフラグをセット
1:	btst.l	#7,d4
	beq	1f
	ori.w	#%10000000,d6		* Sフラグをセット
1:
	cmpi.b	#0,interrupt_enable	* IFF の状態を反映
	beq	1f			* DI 状態の時 P/V <= 0
	ori.w	#%00000100,d6		* EI 状態の時 P/V <= 1
1:	jmp	(a6)

LD_R_A_h:
	lea.l	9(a5),a5
LD_R_A:	move.b	d4,r(a3)
	move.l	emu_counter,emu_counter_latch_r	* Rレジスタがセットされたときのカウンタを覚えておく
	move.l	a5,cpu_cycle_latch_r
	jmp	(a6)

*	------ ＬＤ Ｉ ------
LD_A_I_h:
	lea.l	9(a5),a5
LD_A_I:
@@:
	andi.b	#%00101001,d6		* S,Z,H,P/V,Ｎ を落とす
	move.b	i(a3),d4
	bne	1f
	ori.w	#%01000000,d6		* Zフラグをセット
1:	btst.l	#7,d4
	beq	1f
	ori.w	#%10000000,d6		* Sフラグをセット
1:
	cmpi.b	#0,interrupt_enable	* IFF の状態を反映
	beq	1f			* DI 状態の時 P/V <= 0
	ori.w	#%00000100,d6		* EI 状態の時 P/V <= 1
1:	jmp	(a6)

LD_I_A_h:
	lea.l	9(a5),a5
LD_I_A:	move.b	d4,i(a3)
	jmp	(a6)

*	ちゃんとやってない
*	------ ＲＥＴＮ ------
RETN_h:
	lea.l	14(a5),a5
RETN:	move.w	sp_(a3),d0
	read_mem_16	rd16f11,rd16s11,rd16e11
	addq.w	#2,sp_(a3)
	move.w	d0,d7
	PC_page_set
	jmp	(a6)

*	------ ＲＥＴＩ ------
RETI_h:
	lea.l	14(a5),a5
RETI:	move.w	sp_(a3),d0
	read_mem_16	rd16f12,rd16s12,rd16e12
	addq.w	#2,sp_(a3)
	; RETI 命令が来たら無条件で割り込みが終わったと判断する (framecon=autoの対応)
	bsr	int_ret_notify
	move.w	d0,d7
	PC_page_set
	jmp	(a6)

*************************************************************************
*
*	＄ＤＤ,＄ＦＤライン命令
*		（Ｉｎｄｅｘ関係）
*
*************************************************************************
;	DDライン命令のサイクル数は不定なので0にしておき、各命令ごとに加算する
;	DDラインの命令語長は2-4バイトなので、ここは2にしておき、各命令ごとに加算する
*
*	前置き DD / FD。DD のほうが多いので、共通部分の直前に置いて分岐を一つ省く。
*	境界判定は「またがない」を不成立側にして、常用経路を 2 サイクル安くする。
*
DD_edge:
	lea.l	DD(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
FD_edge:
	lea.l	FD(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2

;	FDライン命令のサイクル数は不定なので0にしておき、各命令ごとに加算する
;	FDラインの命令語長は2-4バイトなので、ここは2にしておき、各命令ごとに加算する
FD_h:
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	bra	FD_edge			* 検証用: 常にエッジ処理を通す
	.else
	bgt	FD_edge
	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
FD:	moveq.l	#2,d2
	bra	DDFD_2nd

DD_h:
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	bra	DD_edge			* 検証用: 常にエッジ処理を通す
	.else
	bgt	DD_edge
	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
DD:	moveq.l	#0,d2

	* オペランド列から第二オペコードを取り出す
DDFD_2nd:
	clr.w	d0
	move.b	(a4)+,d0
	add.w	d0,d0
	add.w	d0,d0
	movea.l	DDFD_JPT(pc,d0.w),a0	* 表は前置きの先頭を指している
	jmp	(a0)
DDFD_JPT:
	.dc.l	none_DDFD_h		* $00
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	LD_B_n_2_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h		* $08
	.dc.l	ADD_Idx_BC_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	LD_C_n_2_h
	.dc.l	none_DDFD_h		* $0f

	.dc.l	none_DDFD_h		* $10
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	LD_D_n_2_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h		* $18
	.dc.l	ADD_Idx_DE_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	LD_E_n_2_h
	.dc.l	none_DDFD_h		* $1f

	.dc.l	none_DDFD_h		* $20
	.dc.l	LD_Idx_nn_h
	.dc.l	LD_lnnl_Idx_h
	.dc.l	INC_Idx_h
	.dc.l	INC_IdxH_h
	.dc.l	DEC_IdxH_h
	.dc.l	LD_IdxH_n_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h		* $28
	.dc.l	ADD_Idx_Idx_h
	.dc.l	LD_Idx_lnnl_h
	.dc.l	DEC_Idx_h
	.dc.l	INC_IdxL_h
	.dc.l	DEC_IdxL_h
	.dc.l	LD_IdxL_n_h
	.dc.l	none_DDFD_h		* $2f

	.dc.l	none_DDFD_h		* $30
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	INC_lIdx_dl_h
	.dc.l	DEC_lIdx_dl_h
	.dc.l	LD_lIdx_dl_n_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h		* $38
	.dc.l	ADD_Idx_SP_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	none_DDFD_h
	.dc.l	LD_A_n_2_h
	.dc.l	none_DDFD_h		* $3f

	.dc.l	LD_B_B_2_h		* $40
	.dc.l	LD_B_C_2_h
	.dc.l	LD_B_D_2_h
	.dc.l	LD_B_E_2_h
	.dc.l	LD_B_IdxH_h
	.dc.l	LD_B_IdxL_h
	.dc.l	LD_B_lIdx_dl_h
	.dc.l	LD_B_A_2_h
	.dc.l	LD_C_B_2_h		* $48
	.dc.l	LD_C_C_2_h
	.dc.l	LD_C_D_2_h
	.dc.l	LD_C_E_2_h
	.dc.l	LD_C_IdxH_h
	.dc.l	LD_C_IdxL_h
	.dc.l	LD_C_lIdx_dl_h
	.dc.l	LD_C_A_2_h		* $4f

	.dc.l	LD_D_B_2_h		* $50
	.dc.l	LD_D_C_2_h
	.dc.l	LD_D_D_2_h
	.dc.l	LD_D_E_2_h
	.dc.l	LD_D_IdxH_h
	.dc.l	LD_D_IdxL_h
	.dc.l	LD_D_lIdx_dl_h
	.dc.l	LD_D_A_2_h
	.dc.l	LD_E_B_2_h		* $58
	.dc.l	LD_E_C_2_h
	.dc.l	LD_E_D_2_h
	.dc.l	LD_E_E_2_h
	.dc.l	LD_E_IdxH_h
	.dc.l	LD_E_IdxL_h
	.dc.l	LD_E_lIdx_dl_h
	.dc.l	LD_E_A_2_h		* $5f

	.dc.l	LD_IdxH_B_h		* $60
	.dc.l	LD_IdxH_C_h
	.dc.l	LD_IdxH_D_h
	.dc.l	LD_IdxH_E_h
	.dc.l	LD_IdxH_IdxH_h
	.dc.l	LD_IdxH_IdxL_h
	.dc.l	LD_H_lIdx_dl_h
	.dc.l	LD_IdxH_A_h
	.dc.l	LD_IdxL_B_h		* $68
	.dc.l	LD_IdxL_C_h
	.dc.l	LD_IdxL_D_h
	.dc.l	LD_IdxL_E_h
	.dc.l	LD_IdxL_IdxH_h
	.dc.l	LD_IdxL_IdxL_h
	.dc.l	LD_L_lIdx_dl_h
	.dc.l	LD_IdxL_A_h		* $6f

	.dc.l	LD_lIdx_dl_B_h	* $70
	.dc.l	LD_lIdx_dl_C_h
	.dc.l	LD_lIdx_dl_D_h
	.dc.l	LD_lIdx_dl_E_h
