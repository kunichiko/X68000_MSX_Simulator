	.cpu 68000
*
*	Ｍｓｘ Ｓｉｍｕｌａｔｅｒ
*
*		[[[ Ｒ８００ Ｓｉｍｕｌａｔｅｒ ]]]		
*			ＭＣ６８０３０以降専用バージョン
*
*				1995.9.24		by Kuni.
*

*	TODO:
*	ＲＥＴＮとＲＥＴＩをちゃんとやってない

; TODO lists
;
; # WZレジスタの実装
; WZレジスタは、LD A,(nn) の nnの値など、内部的なメモリアクセスの際のアドレスを保持するためのレジスタです。
; Z80の表面的なスペック上は見えませんが、F5,F3レジスタなどにこの値が反映されるケースがあるため、内部的には
; WZレジスタの値も追従する必要があります。
;
; # iレジスタの正確な実装
; iレジスタは、Mode2割り込みで使用される割り込みベクタの上位8ビットとして使用されます。
; MSXでは Mode2割り込みは使わないため、正確に実装していません。
;
; # rレジスタの正確な実装
; rレジスタはリフレッシュカウンタとして使われるレジスタのため、正確に実装していません。
; ただ、稀に乱数のシードなどに使われるケースがあるので、定数だとまずいケースがあり、
; 適当に実装しています。
; 正確に実装するためには、後述のZ80のサイクルを正確にカウントする必要があります。
; 
; # サイクルカウントの正確な実装
; Z80のサイクルカウントは、命令ごとに異なるサイクル数が必要です。
; これを正確に実装するためには、命令ごとにサイクル数をカウントする必要があります。

*	 31     16 15 8 7  0
*	|         |    | A  |  d4	Ａレジスタ（bit8 以上は常に 0。表の添字に使える）
*	|         |    | F  |  d6	Ｆレジスタ
*	| PC page | PC (8k) |  d7
*	|     registers     |  a3	a3 = レジスターの格納されているアドレス
*	|    PC Base ADD    |  a4	a4 = PC
*	|  operand pointer  |  a2	a2 = オペランド列へのポインタ
*
*	a2 は命令語長が2以上のときのみ有効で、1段目のオペコードの次のバイトを指す。
*	ページ境界をまたぐ場合は a4 が operand_buffer を指し、そこに PC+1～PC+3 が複写されている。
*
*	【不変条件】
*	・オペランドの読み出しは、メモリ書き込み・I/O出力・C関数呼び出しより
*	  先に行う。呼び出し先はいずれも a4 を退避するが、
*	  Z80の仕様（オペランドは実行前にフェッチ済み）に一致させるため順序を守る。
*	・読み方は属するジャンプテーブルで決まる。
*	    instructions      : 前置きで a4 を進めないので (a4)+ で順に読む
*	    ED_JPT / DDFD_JPT : 前置きが a4 を命令末尾まで進めてあるので
*	                        負のディスプレースメント -2(a4) / -1(a4) で読む
*	    DDFD_CB_JPT       : 参照しない（d と OP CODE は DDFD_CB で取得済み）
*
*	PC Base ADD + PC(16k) = 実アドレス
*
*	PC page は PC(R800) の上位3ビットの値が入っている
*	PC(8k)  は PC(R800) の下位13ビットの値
*
*		PC(R800)  $8100  =  %100____00001_00000000 
*
*		=> d7 %00000000_00000100_00000001_00000000
*
*	registers:
*	a:	.dc.b	0	* Aレジスタは d4 を使うから使わない
*	f:	.dc.b	0	* Fレジスタは d6 を使うから使わない
*	b:	.dc.b	0
*	c:	.dc.b	0
*	d:	.dc.b	0
*	e:	.dc.b	0
*	h:	.dc.b	0
*	l:	.dc.b	0
*
*	ix_h:	.dc.b	0
*	ix_l:	.dc.b	0
*	iy_h:	.dc.b	0
*	iy_l:	.dc.b	0
*
*	s:	.dc.b	0
*	p:	.dc.b	0
*


	.include	iocscall.mac
	.include	doscall.mac
	.include	ms.mac

	.text
	.even

	.xref	ms_vdp_slice_exec
	.xref	ms_vdp_draw_on_int_return
	.xref	ms_vdp_shared
offset_ms_vdp_s02		equ	50

	; CPUから見える8Kバイト単位のメモリのポインタ配列。この中で定義する
	.xdef	ms_cpu_mem_ptr_array

	.xref	dumpsp_c

	.xref	ms_read_mem_8
	.xdef	ms_cpu_mem_rptr_array
	.xdef	ms_cpu_mem_wptr_array
	.xref	ms_read_mem_16
	.xref	ms_write_mem_8
	.xref	ms_write_mem_16

	.xref	ms_io_input_table
	.xref	ms_io_output_table

	.xref	native_jpt_add		* ６８ネイティブルーチンのジャンプテーブル

	; CPUコアに対する割り込み要求フラグ(実CPUのINT端子に相当する)
	; この1バイトの値が1になるとCPUに対する割り込み要求となる
	; このフラグ領域は本CPUコアは定義していないので、外部で定義する必要がある
	; MSXの場合はVDPのステータスレジスタ0のbit7の値が割り込み要求フラグになる
	.xref	ms_cpu_int

	.xref	HEX
	.xref	framerate_control

	.xref	ms_vsync_interrupt_tick	; TODO VDP依存を除去


	.xdef	f

	.xdef	ms_cpu_emulate
	.xdef	ms_cpu_step
	.xdef	ms_cpu_step_break
	.xdef	ms_instructions_ptr
	.xdef	ms_cpu_registers_ptr
	.xdef	ms_cpu_needs_refresh_PC

	.xdef	emu_counter
	.xdef	emu_counter_latch

	;.xdef	cpu_main
	.xdef	cpu_sub_emu_yield
	.xdef	force_yield_check	* 中断要求を立てた側が呼ぶ
	.xdef	emu_counter_skew	* 前倒しで水増しした分
	.xdef	cpu_yield		* 一定周期(VSYNC)などで必ず呼び出される割り込み要求
	.xdef	sub_yield		* その他の要因で呼ばれる割り込み要求
	.xdef	emu_yield
	.xdef	cpu_cycle_last
	.xdef	cpu_cycle_wait
	.xdef	debug_log_level
	.xdef	int_skip_counter
	.xdef	cpu_fast_enabled
	.xdef	int_exec_counter
	.xdef	interrupt_history_ptr
	.xdef	interrupt_history_wr
	.xdef	interrupt_history_rd
	.xdef	cpu_in_interrupt
	.xdef	vdp_draw_pending
	.xdef	cpu_in_interrupt_d

	.xdef	base
	.xdef	refresh_PC_if_needed

* レジスタは a3 からの差で引く。base の位置が変わっても追随するよう
* registers-base を基準にする
regs	equ	registers-base
a	equ	regs+0
f	equ	regs+1
b	equ	regs+2
c	equ	regs+3
d	equ	regs+4
e	equ	regs+5
h	equ	regs+6
l	equ	regs+7
ix_h	equ	regs+8
ix_l	equ	regs+9
iy_h	equ	regs+10
iy_l	equ	regs+11
s	equ	regs+12
p	equ	regs+13

bc	equ	regs+2
de	equ	regs+4
hl	equ	regs+6
ix	equ	regs+8
iy	equ	regs+10
sp_	equ	regs+12

a_	equ	regs+14
f_	equ	regs+15
b_	equ	regs+16
c_	equ	regs+17
d_	equ	regs+18
e_	equ	regs+19
h_	equ	regs+20
l_	equ	regs+21

af_	equ	regs+14
bc_	equ	regs+16
de_	equ	regs+18
hl_	equ	regs+20

r	equ	r_-base
i	equ	i_-base

wz	equ	wz_-base
w	equ	w_-base
z	equ	z_-base

target_16 equ	target_16_-base
target_8 equ	target_8_-base
o_yield		equ	cpu_sub_emu_yield-base	* = -8
o_emucnt	equ	emu_counter-base	* = -4
* ページポインタ配列も a3 の負オフセットで引く。範囲外なら HAS がエラーを出す
o_ptr		equ	ms_cpu_mem_ptr_array-base
o_rptr		equ	ms_cpu_mem_rptr_array-base
o_wptr		equ	ms_cpu_mem_wptr_array-base
szp53p		equ	szp53p_tbl-base

MS_LOG_FATAL	equ	1
MS_LOG_ERROR	equ	2
MS_LOG_INFO	equ	3
MS_LOG_DEBUG	equ	4
MS_LOG_FINE 	equ	5
MS_LOG_TRACE	equ	6
MS_LOG_CPUTRACE equ	7


PC_page_inc	macro
		swap	d7
		addq.w	#1,d7
		andi.w	#PAGENUMMASK,d7
		add.w	d7,d7
		add.w	d7,d7
		movea.l	o_ptr(a3,d7.w),a4
		lea.l	$2000(a4),a4		* ページ先頭+8192 を指す
		lsr.w	#2,d7
		swap	d7
		ori.w	#$e000,d7		* 位置を -8192 基準に直す
		adda.w	d7,a4			* a4 は現在位置を指す
		endm

PC_page_dec	macro
		swap	d7
		subq.w	#1,d7
		andi.w	#PAGENUMMASK,d7
		add.w	d7,d7
		add.w	d7,d7
		movea.l	o_ptr(a3,d7.w),a4
		lea.l	$2000(a4),a4		* ページ先頭+8192 を指す
		lsr.w	#2,d7
		swap	d7
		ori.w	#$e000,d7		* 位置を -8192 基準に直す
		adda.w	d7,a4			* a4 は現在位置を指す
		endm

PC_page_set	macro			* JP命令等で PCが変わった時の処理
		* d7.w に新しい PC が入っている。抜けた時は
		*   d7 上位ワード ＝ ページ番号
		*   d7 下位ワード ＝ ページ内の位置-8192（$E000～$FFFF）
		*   a4 ＝ ページの先頭+8192
		* 位置を負値で持つと、addq のあと 0 になったかどうかだけで
		* 繰り上がりが分かり、毎命令のマスク 8 サイクルが要らなくなる
		* d0 は壊す（全 14 箇所で使われていないことを確認済み）
		move.w	d7,d0
		andi.w	#$e000,d0
		rol.w	#5,d0		* ページ番号×4。3 連シフトより 26 サイクル安い
		ori.w	#$e000,d7		* 位置を -8192 基準にする
		movea.l	o_ptr(a3,d0.w),a4
		lea.l	$2000(a4),a4		* ページ先頭+8192 を指す
		lsr.w	#2,d0		* ページ番号へ戻す
		swap	d7
		move.w	d0,d7
		swap	d7
		adda.w	d7,a4			* a4 は現在位置を指す
		endm

*
*	メモリから 8bit 読む。d0.w のアドレスから読み、d0.b に返す。
*	高速パスをその場に展開し、ドライバ経由のページと $FFFF の時だけ呼び出す。
*	ラベルは呼び出し箇所ごとに違う名前を渡すこと。
*
read_mem_8	macro	lbl_fast, lbl_slow, lbl_end
	cmpi.w	#$ffff,d0		* 拡張スロット選択レジスタ
	bne	lbl_fast		* 低速パスを先に置き、高速パスから bra を外す
lbl_slow:
	jsr	ms_read_mem_8
	bra	lbl_end
lbl_fast:
	move.w	d0,d2
	and.w	d5,d2			* d5 ＝ $E000
	rol.w	#5,d2			* ページ番号×4
	move.l	o_rptr(a3,d2.w),d2
	beq	lbl_slow		* NULL = ドライバ経由
	movea.l	d2,a1
	move.b	(a1,d0.w),d0
lbl_end:
	endm

*
*	メモリへ 8bit 書く。d0.w のアドレスへ d1.b を書く。
*	高速パスをその場に展開し、ドライバ経由のページと $FFFF の時だけ呼び出す。
*	呼び出した場合はページ切り替えの確認まで行われる。
*	ラベルは呼び出し箇所ごとに違う名前を渡すこと。
*
write_mem_8	macro	lbl_fast, lbl_slow, lbl_end
	cmpi.w	#$ffff,d0		* 拡張スロット選択レジスタ
	bne	lbl_fast		* 低速パスを先に置き、高速パスから bra を外す
lbl_slow:
	jsr	ms_write_mem_8		* 内部でページ切り替えの確認まで行う
	bra	lbl_end
lbl_fast:
	move.w	d0,d2
	and.w	d5,d2			* d5 ＝ $E000
	rol.w	#5,d2			* ページ番号×4
	move.l	o_wptr(a3,d2.w),d2
	beq	lbl_slow		* NULL = ドライバ経由
	movea.l	d2,a1
	move.b	d1,(a1,d0.w)
lbl_end:
	endm

*
*	メモリから 16bit 読む。d0.w のアドレスから読み、d0.w に返す。
*	高速パスをその場に展開し、ドライバ経由のページとページ跨ぎの時だけ呼び出す。
*	ラベルは呼び出し箇所ごとに違う名前を渡すこと。
*
read_mem_16	macro	lbl_fast, lbl_slow, lbl_end
	move.w	d0,d2
	and.w	d5,d2			* d5 ＝ $E000
	rol.w	#5,d2			* ページ番号×4
	move.l	o_rptr(a3,d2.w),d2
	bne	lbl_fast		* 低速パスを先に置き、高速パスから bra を外す
lbl_slow:
	jsr	ms_read_mem_16
	bra	lbl_end
lbl_fast:
	movea.l	d2,a1
	move.w	d0,d2
	andi.w	#$1fff,d2
	cmpi.w	#$1ffe,d2		* 8Kページをまたぐ組か？
	bcc	lbl_slow
	adda.w	d0,a1			* 表がページ先頭を引いてあるので生アドレスを足す
	move.b	1(a1),d0		* 上位バイト
	ror.w	#8,d0
	move.b	(a1),d0			* 下位バイト
lbl_end:
	endm

*
*	メモリへ 16bit 書く。d0.w のアドレスへ d1.w を書く。
*	高速パスをその場に展開し、ドライバ経由のページとページ跨ぎの時だけ呼び出す。
*	呼び出した場合はページ切り替えの確認まで行われる。
*	ラベルは呼び出し箇所ごとに違う名前を渡すこと。
*
write_mem_16	macro	lbl_fast, lbl_slow, lbl_end
	move.w	d0,d2
	and.w	d5,d2			* d5 ＝ $E000
	rol.w	#5,d2			* ページ番号×4
	move.l	o_wptr(a3,d2.w),d2
	bne	lbl_fast		* 低速パスを先に置き、高速パスから bra を外す
lbl_slow:
	jsr	ms_write_mem_16		* 内部でページ切り替えの確認まで行う
	bra	lbl_end
lbl_fast:
	movea.l	d2,a1
	move.w	d0,d2
	andi.w	#$1fff,d2
	cmpi.w	#$1ffe,d2		* 8Kページをまたぐ組か？
	bcc	lbl_slow
	adda.w	d0,a1			* 表がページ先頭を引いてあるので生アドレスを足す
	move.b	d1,(a1)			* 下位バイト
	ror.w	#8,d1
	move.b	d1,1(a1)		* 上位バイト
lbl_end:
	endm

	.text

;
;
refresh_PC_if_needed:
	tst.w	ms_cpu_needs_refresh_PC
	beq	1f
	move.w	#0,ms_cpu_needs_refresh_PC
	swap	d7
	lea	ms_cpu_mem_ptr_array,a4
	add.w	d7,d7
	add.w	d7,d7
	movea.l	(a4,d7.w),a4
	lea.l	$2000(a4),a4		* ページ先頭+8192 を指す
	lsr.w	#2,d7
	swap	d7
	adda.w	d7,a4			* a4 は現在位置を指す
1:	rts


	.data

; メモリ書き込みやI/Oポートへの書き込みをした後にこのフラグがセットされていたら、
; エミュレータはPCを再読み込みする必要がある
ms_cpu_needs_refresh_PC:
	.dc.w	0

; 中断確認を前倒しするために emu_counter へ水増しした分。繰り上がり時に差し引く
	.even
emu_counter_skew:
	.dc.l	0

; 中断確認の受け皿として選んだ cpu_main の入口
	.even
cpu_main_entry:
	.dc.l	0

; 選んだ入口が高速版なら 1
cpu_fast_enabled:
	.dc.b	0

; EI の次の 1 命令で必ず中断確認へ落とすなら 1
ei_force_always:
	.dc.b	0

; EI が実行された印。中断確認へ落ちた時点で写し取って落とす
ei_pending:
	.dc.b	0

; 中断確認へ入った時点の ei_pending の写し
ei_at_yield:
	.dc.b	0

; cpu_main_patch の元の 1 語と、書き換えて入れる 1 語
	.even
cpu_main_patch_org:
	.dc.w	0
cpu_main_patch_word:
	.dc.w	0

; ページ境界をまたぐ命令のオペランドを複写する領域
	.even
operand_buffer:
	.ds.b	4

	.even
; エッジ処理のアドレス累算器。レジスタに置かない（呼び出し規約に依存しないため）
edge_addr:
	.dc.w	0
edge_next:			* 命令語長ぶん進めた次の PC
	.dc.w	0

cpu_cycle:
	.dc.l	0
cpu_cycle_latch:		* クリアする前にラッチした値
	.dc.l	0
cpu_cycle_last:			* C側に見せている値(デバッグ表示中に重くなって値が変わるのを回避)
	.dc.l	0
cpu_cycle_wait:
	.dc.l	0
emu_counter_latch:
	.dc.l	0
emu_counter_latch_r:		* Rレジスタ用のラッチ
	.dc.l	0
cpu_cycle_latch_r:		* Rレジスタ用のラッチ（高速版はサイクル数から作る）
	.dc.l	0
int_skip_counter:
	.dc.l	0
int_exec_counter:
	.dc.l	0
emu_yield_div:
	.dc.w	0

interrupt_history_ptr:
	.dc.l	interrupt_history
interrupt_history:
	; ロングワード*2 *32個のリングバッファ
	; struct interrupt_history_st {
	;    unsigned short int_tick;
	;    unsigned short process_type;
	;    unsigned long emu_counter;
	; }
	; int_tick はその時点の interrupt_tick の値
	; reason は割り込みが発生した時にどう処理したかを示す
	; 0x00: EI状態で、正常にZ80に割り込みがかかった
	; 0x01: EIだったが、emu_counterが framerate_control に達していなかったのでスキップ
	; 0x02: DI状態のため、Z80の割り込みがスキップされた
	; emu_counterには、割り込み時の emu_counter - emu_counter_latch の値を格納

	.ds.l	2*32
interrupt_history_wr:
	.dc.w	0
interrupt_history_rd:
	.dc.w	0

	.text
	.ifdef	FASTAUDIT
*
*	検証用: 旧述語と新述語が一致することを高速経路そのもので確かめる。
*	bra.b の変位を食わないよう、書き換え語から遠い位置に置く。
*	破壊: d0/d1/d2
*
ei_audit_check:
	move.l	emu_counter,d0
	sub.l	ei_at,d0
	subq.l	#1,d0
	seq	d1
	tst.b	ei_at_yield
	sne	d2
	cmp.b	d1,d2
	beq	@f
	illegal
@@:	rts
	.endif

*
*	命令キャッシュを持たない MPU かどうかを調べる。
*	IOCS ワークの MPU 種別は 0=68000 1=68010 3=68030 4=68040 6=68060。
*	通すのは 0 と 1 だけで、それ以外は必ず 0 を返す。
*	戻り値: d0.b  0 ＝ 通さない／1 ＝ 通す
*
cpu_has_no_icache:
	move.l	a1,-(sp)
	lea.l	$0cbc.w,a1
	IOCS	__B_BPEEK
	andi.l	#$000000ff,d0
	cmpi.l	#2,d0
	bcs	@f
	moveq.l	#0,d0
	movea.l	(sp)+,a1
	rts
@@:	moveq.l	#1,d0
	movea.l	(sp)+,a1
	rts

*
*	高速版を使えるかどうかを判定する。
*	使えるときだけ a0 に高速版の入口を入れて帰る。
*	破壊: d0/a0/a1
*
cpu_main_select:
	lea.l	cpu_main_safe(pc),a0
	.ifdef	NOFAST
	rts
	.endif
	.ifdef	DEBUG
	rts
	.endif
	tst.l	cpu_cycle_wait
	bne	9f
	move.l	framerate_control,d0
	beq	1f			* none
	addq.l	#1,d0
	bne	9f			* 1〜99999 は命令数基準なので使えない
1:
	.ifndef	FORCEFAST
	bsr	cpu_has_no_icache
	tst.b	d0
	beq	9f
	.endif
	lea.l	cpu_main_fast(pc),a0
	lea.l	cpu_main_patch(pc),a1
	.ifndef	FASTAUDIT
	cmpa.l	a0,a1
	bne	9f			* 入口と書き換え番地が一致しない版では使わない
	.endif
	move.l	a1,d0
	btst.l	#0,d0
	bne	9f			* 奇数番地では 1 語書き込みができない
	move.w	(a1),d0
	cmpi.w	#$4240,d0		* clr.w d0
	bne	9f			* 想定した 1 語でなければ使わない
	move.w	d0,cpu_main_patch_org
	lea.l	cpu_main_fast_wrap(pc),a0
	suba.l	a1,a0
	move.l	a0,d0
	subq.l	#2,d0			* bra.b の変位
	cmpi.l	#-128,d0
	blt	9f
	cmpi.l	#127,d0
	bgt	9f
	tst.b	d0
	beq	9f			* 変位 0 は bra.w になってしまう
	andi.w	#$00ff,d0
	ori.w	#$6000,d0
	move.w	d0,cpu_main_patch_word
	move.b	#1,cpu_fast_enabled
	move.b	#1,ei_force_always
	lea.l	cpu_main_fast(pc),a0
	rts
9:	clr.b	cpu_fast_enabled
	lea.l	cpu_main_safe(pc),a0
	rts

*
*	void ms_cpu_emulate(emu_loop_func, cpu_wait);
*
ms_cpu_emulate:
	link	a6,#0
	movem.l	d3-d7/a0-a5,-(sp)	* ※1 emu_endと対応
	
	move.l	8(a6),emu_loop_func	* 引数1のループ関数のポインタを保存しておく
	move.l	12(a6),cpu_cycle_wait	* 引数2のCPUウエイトを保存しておく

	lea.l	base,a3
	clr.l	d4			* Ａレジスタ。bit8 以上を 0 にして表の添字に使えるようにする
	move.l	#$0000e000,d5		* メモリアクセスで使うページ番号の取り出しマスク
	clr.w	d7			* pc = 0
	PC_page_set
	clr.w	ms_cpu_needs_refresh_PC	* 実行開始時。PC_page_set がリフレッシュそのもの
	clr.w	sp_(a3)			* sp = 0
	move.b	#$00,interrupt_enable	* DI に
	clr.b	interrupt_mode		* IM を０に

	clr.l	emu_counter
	suba.l	a5,a5			* cpu_cycle は a5 に持たせる
	move.l	#-1,ei_at		* 最初の命令で EI 直後と誤判定しないように
	clr.l	emu_counter_latch
	clr.w	emu_yield_div
	clr.w	interrupt_history_wr
	clr.w	interrupt_history_rd
	clr.b	cpu_fast_enabled
	clr.b	ei_force_always
	clr.b	ei_pending
	clr.b	ei_at_yield
	bsr	cpu_main_select		* ハンドラの戻り先を決める
	move.l	a0,cpu_main_entry
	movea.l	a0,a6
	.ifdef	DEBUG
	move.b	#1,ei_force_always	* 新旧の述語を毎回突き合わせるため
	.endif
	jmp	(a6)

;
;
do_wait:
	cmp.w	#0,interrupt_return		* 割り込み中はウエイトを入れない
 	beq	@f
 	rts
@@:	move.l	cpu_cycle_wait,d0
	bne	1f
	rts
	; 単純ループだとアクセラレータなどで負荷がかからないので、VRAMの読み込み&書き込みを行う
1:	move.w	$C00000,d1
	move.w	d1,$C00000
	dbra	d0,1b
	rts

;
;
debug_log_pc:
	cmp.w	#MS_LOG_CPUTRACE,debug_log_level
	bge	@f				* ログレベルがCPUTRACEの時のみ
	rts
@@:	cmp.w	#0,cpu_in_interrupt		* 割り込み中はログを出力しない
 	beq	@f
 	rts
@@:	link	a6,#-2
	movem.l	d0-d7/a0-a6,-(sp)
	move.l	d7,d0
	move.l	d7,d1			* d1.w = 000?????_????????
	andi.w	#PAGEADDRMASK,d1	* 位置は -8192 基準なので上位 3bit を落とす
	lsr.l	#3,d0			* d0.w = ppp000??_????????
	andi.w	#%11100000_00000000,d0	* d1.w = ppp00000_00000000
	or.w	d1,d0			* d0.w = ppp?????_???????? = PC (R800)

	move.w	d0,-2(a6)		* PCを保存

	cmpi.w	#$0454,d0
	blt	@f
	cmpi.w	#$045d,d0
	ble	9f

@@:	cmpi.w	#$04b7,d0
	blt	@f
	cmpi.w	#$04c0,d0
	ble	9f

@@:	cmpi.w	#$0980,d0
	blt	@f
	cmpi.w	#$098f,d0
	ble	9f

@@:	cmpi.w	#$7b70,d0
	blt	@f
	cmpi.w	#$7b7f,d0
	ble	9f

@@:	cmpi.w	#$7d60,d0
	blt	@f
	cmpi.w	#$7d6f,d0
	ble	9f

@@:	lea.l	HEX,a0

	; PC
	lea.l	cpu_pc_msg_pc,a1
	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	; OPCODE
	move.w	-2(a6),d0
	read_mem_16	rd16f1,rd16s1,rd16e1
	ror.w	#8,d0			* エンディアンを逆にする

	lea.l	HEX,a0
	lea.l	cpu_pc_msg_opcode,a1
	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	add.l	#1,a1

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+


	; SP
	move.w	sp_(a3),d0
	lea.l	cpu_pc_msg_sp,a1

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	; HL
	move.w	hl(a3),d0
	lea.l	cpu_pc_msg_hl,a1

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	; IX
	move.w	ix(a3),d0
	lea.l	cpu_pc_msg_ix,a1

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+

	rol.w	#4,d0
	move.w	d0,d1
	andi.w	#$0f,d1
	move.b	(a0,d1.w),(a1)+


	pea.l	cpu_pc_msg
	DOS	__PRINT
	lea.l	4(sp),sp

;	move.w	#$d,d1
;	IOCS	__BITSNS
	; BITSNSのワークエリアを直接参照
	move.b	$80d,d0			* F6    : bit0
	and.b	$80e,d0			* SHIFT : bit0
	andi.b	#%00000001,d0		* F6とSHIFTの両方が押されているか？
	move.b	cpu_pc_f6_flg,d1
	lsl.b	#1,d1
	or.b	d0,d1			* b1:前回、b0:今回
	move.b	d1,cpu_pc_f6_flg
	cmp.b	#%01,d1
	bne	9f
	* SHIFT+F6が押されたらこの場でログレベルを一つ戻す(ここで調べないと止まらなくなるため)
	sub.w	#1,debug_log_level

9:	movem.l	(sp)+,d0-d7/a0-a6
	unlk	a6
	rts

	.data

cpu_pc_f6_flg:
	.dc.b	1

cpu_pc_msg:
	.dc.b	'PC:'
cpu_pc_msg_pc:
	.dc.b	'0000 '
	.dc.b	'OP:'
cpu_pc_msg_opcode:
	.dc.b	'00,00 '
	.dc.b	'SP:'
cpu_pc_msg_sp:
	.dc.b	'0000 '
	.dc.b	'HL:'
cpu_pc_msg_hl:
	.dc.b	'0000 '
	.dc.b	'IX:'
cpu_pc_msg_ix:
	.dc.b	'0000'
	.dc.b	$0d,$0a,$00

	.text
	.even

;---------------------------------------------------------------------------------------
*
*	yield フラグが立っているときだけ通る冷たい経路。
*	cpu_main の直前に置く（bne が短分岐に収まるようにするため）。
*
*
*	前倒しで落ちてきた時の後始末
*
*	水増しした分を戻す。下位バイトも元の位相に戻るので、
*	自然な 256 回目の繰り上がりは狂わない。
*	68000 は命令の途中で割り込まれないので、sub.l は競合しても安全。
*
cpu_main_forced:
	move.w	sr,-(sp)
	ori.w	#%00000111_00000000,sr	* 補正の途中で前倒しされないようにする
	move.l	emu_counter_skew,d0	* マスクしてから読み直す
	sub.l	d0,emu_counter
	sub.l	d0,emu_counter_skew
	move.w	(sp)+,sr
	bra	cpu_main_checked

*
*	中断要求を立てた側が呼ぶ。次の命令で必ず cpu_main の繰り上がりへ落とす。
*	emu_counter を水増しし、その分を emu_counter_skew に記録する。
*	d0 と割り込みマスクは自分で退避する。
*
*
*	割り込み処理から戻ったことを VDP 側へ知らせる。
*	毎走査線で cpu_in_interrupt を見張る代わりに、下ろす側から通知する。
*
int_ret_notify:
	tst.w	interrupt_return
	beq	9f			* もともと 0 なら立ち下がりではない
	move.w	#0,interrupt_return
	move.w	#1,vdp_draw_pending
	bra	force_yield_check	* 次の命令で cpu_main_wrap へ落とす
9:	rts

force_yield_check:
	tst.b	cpu_fast_enabled
	bne	9f
	move.l	d0,-(sp)
	move.w	sr,-(sp)
	ori.w	#%00000111_00000000,sr	* 読んで書くまでの間に割り込ませない
	moveq.l	#0,d0
	move.b	emu_counter+3,d0
	not.b	d0			* $ff - 現在値 ＝ 水増しする分
	add.l	d0,emu_counter_skew
	move.b	#$ff,emu_counter+3
	move.w	(sp)+,sr
	move.l	(sp)+,d0
	rts
*	高速版は入口の 1 語を書き換えて次の命令を落とす。
*	1 語の書き込みは分割されず、値も冪等なので割り込みを塞ぐ必要がない。
9:	move.w	cpu_main_patch_word,cpu_main_patch
	rts

cpu_main_yield:
	bsr	check_yield

	; VDPコマンドの時分割実行
	;cmp.w	#0,cpu_in_interrupt		* 割り込み中は実行しない
 	;bne	cpu_main_next
	movea.l	ms_vdp_shared,a0
	btst.b	#0,offset_ms_vdp_s02(a0)
	beq	cpu_main_yield_end
	movem.l	d1-d7/a1-a5,-(sp)
	move.l	a0,-(sp)	* 構造体のアドレスを引数に
	jsr	ms_vdp_slice_exec
	lea	4(sp),sp
	movem.l	(sp)+,d1-d7/a1-a5

	bra	cpu_main_yield_end

cpu_main_yield_end:
	tst.l	o_yield(a3)		* まだ残っているなら次の命令でも確認する
	beq	cpu_main_next
	bsr	force_yield_check
	tst.b	cpu_fast_enabled
	bne	cpu_exec_core		* 高速版は 1 命令実行してから落とす
	bra	cpu_main_next

*
*	CPU メインループ。ハンドラは jmp (a6) でここへ戻る（a6 ＝ cpu_main）。
*
*
*	ここへ来るのは 256 回に 1 回、または中断要求が前倒しした時。
*	中断要求は毎命令調べない。立てた側が force_yield_check で
*	最下位バイトを $FF にし、次の命令をここへ落とす。
*
*
*	高速版で書き換えによって落ちてきた時の入口。
*	先に元の 1 語へ戻してから、共通の後段へ合流する。
*	この順序を入れ替えてはならない。状態を読んでから戻すと、
*	その間に立った要求を消して永久に取りこぼす。
*
cpu_main_fast_wrap:
	move.w	cpu_main_patch_org,cpu_main_patch
	move.b	ei_pending,ei_at_yield
	clr.b	ei_pending
	.ifdef	FASTAUDIT
	bsr	ei_audit_check
	.endif
	bra	cpu_main_checked

cpu_main_wrap:
	.ifdef	DEBUG
	move.b	ei_pending,ei_at_yield
	clr.b	ei_pending
	.endif
	add.l	#$100,emu_counter
	move.l	emu_counter_skew,d0
	bne	cpu_main_forced		* 前倒しされた時はウエイトを入れない
	; このタイミングでちょっと重めの処理を入れると、影響が1/256になる
	; ウエイトが必要な場合はウエイトを入れる
	bsr	do_wait
cpu_main_checked:
	tst.w	vdp_draw_pending
	bne	cpu_main_draw
	tst.l	o_yield(a3)
	bne	cpu_main_yield		* 後方短分岐
	bra	cpu_main_next

cpu_main_draw:
	clr.w	vdp_draw_pending
	jsr	ms_vdp_draw_on_int_return
	tst.l	o_yield(a3)
	bne	cpu_main_yield
	bra	cpu_main_next

cpu_main_safe:
	.ifdef	CHECKMAIN
*	検証用: 高速版を選んだ版がここへ来たら a6 の取り違えである
	tst.b	cpu_fast_enabled
	beq	@f
	illegal
@@:
	.endif
	addq.b	#1,(a3)			* emu_counter の最下位バイト
	bcs	cpu_main_wrap		* 繰り上がった時だけ落ちる。255/256 は不成立の 8 サイクル
cpu_main_next:
cpu_main_fast:
	.ifdef	FASTAUDIT
*	検証用: 高速経路でも emu_counter を命令数として生かす。
*	書き換えで飛ぶ命令ぶんも数えるため、書き換え語の手前に置く。
	addq.l	#1,emu_counter
	.endif
	.ifdef	DEBUG
	bsr	debug_log_pc
	.endif
*
*	ここから下へ落ちて入る。戻りはハンドラ末尾の jmp (a6) だけで 8 サイクル。
*
cpu_dispatch:
cpu_main_patch:				* 中断要求で書き換えられる 1 語
	clr.w	d0			* d0 の上位ビットを０にクリア
cpu_dispatch_body:
	.ifdef	CHECKPC
*	検証用: PC のページ内位置は常に $E000～$FFFF（位置-8192）でなければならない。
*	外れていたら直前に実行した命令を d0 に載せて illegal で落とす。
	cmpi.w	#$e000,d7
	bcc	@f
	moveq.l	#0,d0
	move.b	last_opcode,d0
	illegal
@@:
*	検証用: a4 は常に「現在のページの先頭＋位置」を指していなければならない。
	movem.l	d0/a0,-(sp)
	move.l	d7,d0
	swap	d0			* d0.w = ページ番号
	andi.w	#PAGENUMMASK,d0
	add.w	d0,d0
	add.w	d0,d0
	movea.l	o_ptr(a3,d0.w),a0
	lea.l	$2000(a0),a0
	adda.w	d7,a0
	cmpa.l	a0,a4
	beq	9f
	moveq.l	#0,d0
	move.b	last_opcode,d0
	illegal
9:	movem.l	(sp)+,d0/a0
	.endif
	move.b	(a4)+,d0		* 命令を読み込む
	.ifdef	CHECKPC
	move.b	d0,last_opcode
	.endif
	.ifdef	DEBUG
	move.b	d0,last_opcode		* 旧判定との照合用
	moveq.l	#-1,d1			* 前置き方式ではハンドラへ d1/d2 を渡さない
	moveq.l	#-1,d2
	.endif
	add.w	d0,d0
	add.w	d0,d0
	movea.l	instructions(pc,d0.w),a0	* 前置きの先頭を取得
	addq.w	#1,d7			* PC をオペコードのぶんだけ進める。0 になったら境界
	beq	cpu_page_inc_1		* 8192 回に 1 回だけ。常用経路は不成立の 8 サイクル
ms_cpu_jmp:				* デバッガでBP設定する時用のラベル
	.ifdef	CHECKA0
*	検証用: 表から引いた飛び先が 0 なら、そこで止める
	move.l	a0,-(sp)
	tst.l	(sp)+
	bne	@f
	illegal
@@:
	.endif
	jmp	(a0)

cpu_page_inc_1:
	PC_page_inc
	jmp	(a0)

*
*	オペランドがページ境界をまたぐ命令の入口。命令語長ごとに用意する。
*	a0 には前置きがハンドラ本体の先頭を積み直してある。
*
cpu_edge_2:
	moveq.l	#2-1,d2
	bra	cpu_exec_core_edge
cpu_edge_3:
	moveq.l	#3-1,d2
	bra	cpu_exec_core_edge

cpu_exec_core:				* none_DDFD / ms_cpu_step 用の入口
	clr.w	d0
	bra	cpu_dispatch_body

	.even
*******************************************************************
*	基本命令ジャンプテーブル
*	d8(PC,Xn) で引くため cpu_dispatch の近くに置かなければならない。
*	変位は 8bit しかなく、届かなければ HAS がエラーを出す。
*******************************************************************
instructions:
	.dc.l	nop_h				* $00
	.dc.l	LD_BC_nn_h
	.dc.l	LD_lBCl_A_h
	.dc.l	INC_BC_h
	.dc.l	INC_B_h
	.dc.l	DEC_B_h
	.dc.l	LD_B_n_h
	.dc.l	RLCA_h
	.dc.l	EX_AF_AFd_h			* $08
	.dc.l	ADD_HL_BC_h
	.dc.l	LD_A_lBCl_h
	.dc.l	DEC_BC_h
	.dc.l	INC_C_h
	.dc.l	DEC_C_h
	.dc.l	LD_C_n_h
	.dc.l	RRCA_h				* $0f

	.dc.l	DJNZ_h				* $10
	.dc.l	LD_DE_nn_h
	.dc.l	LD_lDEl_A_h
	.dc.l	INC_DE_h
	.dc.l	INC_D_h
	.dc.l	DEC_D_h
	.dc.l	LD_D_n_h
	.dc.l	RLA_h
	.dc.l	JR_h				* $18
	.dc.l	ADD_HL_DE_h
	.dc.l	LD_A_lDEl_h
	.dc.l	DEC_DE_h
	.dc.l	INC_E_h
	.dc.l	DEC_E_h
	.dc.l	LD_E_n_h
	.dc.l	RRA_h				* $1f

	.dc.l	JR_NZ_h				* $20
	.dc.l	LD_HL_nn_h
	.dc.l	LD_lnnl_HL_h
	.dc.l	INC_HL_h
	.dc.l	INC_H_h
	.dc.l	DEC_H_h
	.dc.l	LD_H_n_h
	.dc.l	DAA_h
	.dc.l	JR_Z_h				* $28
	.dc.l	ADD_HL_HL_h
	.dc.l	LD_HL_lnnl_h
	.dc.l	DEC_HL_h
	.dc.l	INC_L_h
	.dc.l	DEC_L_h
	.dc.l	LD_L_n_h
	.dc.l	CPL_h				* $2f

	.dc.l	JR_NC_h				* $30
	.dc.l	LD_SP_nn_h
	.dc.l	LD_lnnl_A_h
	.dc.l	INC_SP_h
	.dc.l	INC_lHLl_h
	.dc.l	DEC_lHLl_h
	.dc.l	LD_lHLl_n_h
	.dc.l	SCF_h
	.dc.l	JR_C_h				* $38
	.dc.l	ADD_HL_SP_h
	.dc.l	LD_A_lnnl_h
	.dc.l	DEC_SP_h
	.dc.l	INC_A_h
	.dc.l	DEC_A_h
	.dc.l	LD_A_n_h
	.dc.l	CCF_h				* $3f

	.dc.l	LD_B_B_h				* 0
	.dc.l	LD_B_C_h
	.dc.l	LD_B_D_h
	.dc.l	LD_B_E_h
	.dc.l	LD_B_H_h
	.dc.l	LD_B_L_h
	.dc.l	LD_B_lHLl_h
	.dc.l	LD_B_A_h
	.dc.l	LD_C_B_h				* $08
	.dc.l	LD_C_C_h
	.dc.l	LD_C_D_h
	.dc.l	LD_C_E_h
	.dc.l	LD_C_H_h
	.dc.l	LD_C_L_h
	.dc.l	LD_C_lHLl_h
	.dc.l	LD_C_A_h				* $0f

	.dc.l	LD_D_B_h				* $50
	.dc.l	LD_D_C_h
	.dc.l	LD_D_D_h
	.dc.l	LD_D_E_h
	.dc.l	LD_D_H_h
	.dc.l	LD_D_L_h
	.dc.l	LD_D_lHLl_h
	.dc.l	LD_D_A_h
	.dc.l	LD_E_B_h				* $58
	.dc.l	LD_E_C_h
	.dc.l	LD_E_D_h
	.dc.l	LD_E_E_h
	.dc.l	LD_E_H_h
	.dc.l	LD_E_L_h
	.dc.l	LD_E_lHLl_h
	.dc.l	LD_E_A_h				* $5f

	.dc.l	LD_H_B_h				* $60
	.dc.l	LD_H_C_h
	.dc.l	LD_H_D_h
	.dc.l	LD_H_E_h
	.dc.l	LD_H_H_h
	.dc.l	LD_H_L_h
	.dc.l	LD_H_lHLl_h
	.dc.l	LD_H_A_h
	.dc.l	LD_L_B_h				* $68
	.dc.l	LD_L_C_h
	.dc.l	LD_L_D_h
	.dc.l	LD_L_E_h
	.dc.l	LD_L_H_h
	.dc.l	LD_L_L_h
	.dc.l	LD_L_lHLl_h
	.dc.l	LD_L_A_h				* $6f

	.dc.l	LD_lHLl_B_h			* $70
	.dc.l	LD_lHLl_C_h
	.dc.l	LD_lHLl_D_h
	.dc.l	LD_lHLl_E_h
	.dc.l	LD_lHLl_H_h
	.dc.l	LD_lHLl_L_h
	.dc.l	HALT_h
	.dc.l	LD_lHLl_A_h
	.dc.l	LD_A_B_h				* $78
	.dc.l	LD_A_C_h
	.dc.l	LD_A_D_h
	.dc.l	LD_A_E_h
	.dc.l	LD_A_H_h
	.dc.l	LD_A_L_h
	.dc.l	LD_A_lHLl_h
	.dc.l	LD_A_A_h				* $7f

	.dc.l	ADD_A_B_h				* $80
	.dc.l	ADD_A_C_h
	.dc.l	ADD_A_D_h
	.dc.l	ADD_A_E_h
	.dc.l	ADD_A_H_h
	.dc.l	ADD_A_L_h
	.dc.l	ADD_A_lHLl_h
	.dc.l	ADD_A_A_h
	.dc.l	ADC_A_B_h				* $88
	.dc.l	ADC_A_C_h
	.dc.l	ADC_A_D_h
	.dc.l	ADC_A_E_h
	.dc.l	ADC_A_H_h
	.dc.l	ADC_A_L_h
	.dc.l	ADC_A_lHLl_h
	.dc.l	ADC_A_A_h				* $8f

	.dc.l	SUB_B_h				* $90
	.dc.l	SUB_C_h
	.dc.l	SUB_D_h
	.dc.l	SUB_E_h
	.dc.l	SUB_H_h
	.dc.l	SUB_L_h
	.dc.l	SUB_lHLl_h
	.dc.l	SUB_A_h
	.dc.l	SBC_A_B_h				* $98
	.dc.l	SBC_A_C_h
	.dc.l	SBC_A_D_h
	.dc.l	SBC_A_E_h
	.dc.l	SBC_A_H_h
	.dc.l	SBC_A_L_h
	.dc.l	SBC_A_lHLl_h
	.dc.l	SBC_A_A_h				* $9f

	.dc.l	AND_B_h				* $A0
	.dc.l	AND_C_h
	.dc.l	AND_D_h
	.dc.l	AND_E_h
	.dc.l	AND_H_h
	.dc.l	AND_L_h
	.dc.l	AND_lHLl_h
	.dc.l	AND_A_h
	.dc.l	XOR_B_h				* $A8
	.dc.l	XOR_C_h
	.dc.l	XOR_D_h
	.dc.l	XOR_E_h
	.dc.l	XOR_H_h
	.dc.l	XOR_L_h
	.dc.l	XOR_lHLl_h
	.dc.l	XOR_A_h				* $Af

	.dc.l	OR_B_h				* $B0
	.dc.l	OR_C_h
	.dc.l	OR_D_h
	.dc.l	OR_E_h
	.dc.l	OR_H_h
	.dc.l	OR_L_h
	.dc.l	OR_lHLl_h
	.dc.l	OR_A_h
	.dc.l	CP_B_h				* $B8
	.dc.l	CP_C_h
	.dc.l	CP_D_h
	.dc.l	CP_E_h
	.dc.l	CP_H_h
	.dc.l	CP_L_h
	.dc.l	CP_lHLl_h
	.dc.l	CP_A_h				* $Bf

	.dc.l	RET_NZ_h				* $C0
	.dc.l	POP_BC_h
	.dc.l	JP_NZ_h
	.dc.l	JP_h
	.dc.l	CALL_NZ_h
	.dc.l	PUSH_BC_h
	.dc.l	ADD_A_n_h
	.dc.l	RST_00H_h
	.dc.l	RET_Z_h				* $C8
	.dc.l	RET_h
	.dc.l	JP_Z_h
	.dc.l	CB_h				* $CB ライン命令
	.dc.l	CALL_Z_h
	.dc.l	CALL_h
	.dc.l	ADC_A_n_h
	.dc.l	RST_08H_h				* $Cf

	.dc.l	RET_NC_h				* $D0
	.dc.l	POP_DE_h
	.dc.l	JP_NC_h
	.dc.l	OUT_n_A_h
	.dc.l	CALL_NC_h
	.dc.l	PUSH_DE_h
	.dc.l	SUB_n_h
	.dc.l	RST_10H_h
	.dc.l	RET_C_h				* $D8
	.dc.l	EXX_h
	.dc.l	JP_C_h
	.dc.l	IN_A_n_h
	.dc.l	CALL_C_h
	.dc.l	DD_h				* $DD ライン命令
	.dc.l	SBC_A_n_h
	.dc.l	RST_18H_h				* $Df

	.dc.l	RET_PO_h				* $E0
	.dc.l	POP_HL_h
	.dc.l	JP_PO_h
	.dc.l	EX_lSPl_HL_h
	.dc.l	CALL_PO_h
	.dc.l	PUSH_HL_h
	.dc.l	AND_n_h
	.dc.l	RST_20H_h
	.dc.l	RET_PE_h				* $E8
	.dc.l	JP_lHLl_h
	.dc.l	JP_PE_h
	.dc.l	EX_DE_HL_h
	.dc.l	CALL_PE_h
	.dc.l	ED_h				* $ED ライン命令
	.dc.l	XOR_n_h
	.dc.l	RST_28H_h				* $Ef

	.dc.l	RET_P_h				* $F0
	.dc.l	POP_AF_h
	.dc.l	JP_P_h
	.dc.l	DI_h
	.dc.l	CALL_P_h
	.dc.l	PUSH_AF_h
	.dc.l	OR_n_h
	.dc.l	RST_30H_h
	.dc.l	RET_M_h				* $F8
	.dc.l	LD_SP_HL_h
	.dc.l	JP_M_h
	.dc.l	EI_h
	.dc.l	CALL_M_h
	.dc.l	FD_h				* $FD ライン命令
	.dc.l	CP_n_h
	.dc.l	RST_38H_h				* $ff

* オペランドがページ境界をまたぐ命令はここが扱う（コールドパス）。
*	d2 ＝ 命令語長-1 / a0 ＝ ハンドラ本体 / d7・a4 ＝ オペコードの次の位置
* このルーチンは ms_read_mem_8 の呼び出し規約に一切依存しない形で書いてある。
* 復帰後に保証されるのは d7 / a3 / a4 だけであると仮定している。
* アドレス累算器は edge_addr、書き込み先は絶対アドレス、a0 はスタックに退避する。
* ここをレジスタ渡しに戻してはならない。
cpu_exec_core_edge:
	move.l	a0,-(sp)		* ハンドラを保存
	; d7 と上位ワードのページ番号から R800 の 16bit アドレスを組み立てる
	move.l	d7,d0
	lsr.l	#3,d0			* d0 = ppp000??_????????
	andi.w	#%11100000_00000000,d0	* d0 = ppp00000_00000000
	move.w	d7,d1
	andi.w	#PAGEADDRMASK,d1	* 位置は -8192 基準なので上位 3bit を落とす
	or.w	d1,d0			* d0.w = オペランド列の先頭
	move.w	d0,edge_addr		* ここでレジスタ依存を切る
	add.w	d2,d0			* 語長-1 を足すと次の命令の先頭
	move.w	d0,edge_next
	; オペランドを 3 バイト読み直す
	move.w	edge_addr,d0
	read_mem_8	rd8f2,rd8s2,rd8e2
	move.b	d0,operand_buffer+0
	move.w	edge_addr,d0
	addq.w	#1,d0
	read_mem_8	rd8f3,rd8s3,rd8e3
	move.b	d0,operand_buffer+1
	move.w	edge_addr,d0
	addq.w	#2,d0
	read_mem_8	rd8f4,rd8s4,rd8e4
	move.b	d0,operand_buffer+2
	; PC を命令語長ぶん進めた位置へ張り直す
	move.w	edge_next,d7
	PC_page_set
	lea.l	operand_buffer,a4	* (a4)+ で読むハンドラのために a4 も向ける
	lea.l	cpu_main_after_edge(pc),a6	* 戻り先を差し替える
	movea.l	(sp)+,a0
	jmp	(a0)

*	エッジ経路から戻ってきた時だけ通る。ハンドラが PC を変えた場合もあるので
*	a4 は控えから戻さず d7 から作り直す。
cpu_main_after_edge:
	movea.l	cpu_main_entry,a6
	move.l	d7,d0
	swap	d0			* d0.w = ページ番号
	andi.w	#PAGENUMMASK,d0
	add.w	d0,d0
	add.w	d0,d0
	movea.l	o_ptr(a3,d0.w),a4
	lea.l	$2000(a4),a4
	adda.w	d7,a4
	jmp	(a6)


;---------------------------------------------------------------------------------------


*
*	次に実行する命令が EI の直後かどうかを返す。
*	Z=1 のとき EI の直後。
*	破壊: d0
*
ei_just_executed:
	tst.b	cpu_fast_enabled
	bne	1f
	move.l	emu_counter,d0
	sub.l	ei_at,d0
	subq.l	#1,d0			* EI の次の命令なら 0
	rts
1:	move.b	ei_at_yield,d0
	subq.b	#1,d0			* 1 なら 0
	rts

; cpu_yield, sub_yield, emu_yieldのいずれかが0でない場合の中断処理
check_yield:
	move.w	sr,d0
	move.w	d0,-(sp)
	or.w	#%00000111_00000000,d0	* 一時的に割り込み禁止
	move.w	d0,sr

	; cpu_yieldの処理
	cmpi.b	#0,cpu_yield
	beq	next_sub_yield
	subq.b	#1,cpu_yield
	bne	next_sub_yield
	bra	next_cpu_yield

next_sub_yield:
	; sub_yieldの処理
	cmpi.b	#0,sub_yield
	beq	next_emu_yield
	subq.b	#1,sub_yield
	bne	next_emu_yield
	; sub_yieldが1→0になったので、走査線割り込み処理
	cmpi.b	#0,interrupt_enable
	beq	next_emu_yield	* DIなら割り込まない
	; EI = 1だった場合、割り込みを処理するが、
	; EIの実行直後の場合は割り込みをスキップする
	.ifdef	DEBUG
	; 新旧の述語が一致することを確かめる
	move.l	emu_counter,d0
	sub.l	ei_at,d0
	subq.l	#1,d0
	seq	d1			* 旧述語
	tst.b	ei_at_yield
	sne	d2			* 新述語
	cmp.b	d1,d2
	bne	ei_chk_ng1
	cmpi.b	#$fb,last_opcode
	seq	d2
	cmp.b	d1,d2
	beq	ei_chk_ok1
ei_chk_ng1:
	illegal
ei_chk_ok1:
	.endif
	bsr	ei_just_executed
	bne	@f
	move.b	#1,sub_yield	; 1つ命令を実行した後にもう一度割り込みを確認するためにsub_yieldを1にする
	bra	next_emu_yield
@@:	; あらためて割り込み要求端子の値(ms_cpu_int)を見て割り込み要求があるかどうかを見る
	cmpi.b	#0,ms_cpu_int
	beq	next_emu_yield
	bsr	INT
	bra	check_yield_rts

next_cpu_yield:
	; cpu_yieldが1→0になったので、1/60ごとの定期処理を行う

	; まずはCPUサイクル数の保存
	move.l	a5,d0
	move.l	d0,cpu_cycle_latch
	suba.l	a5,a5

	; 割り込み処理
check_interrupt:
	cmpi.b	#0,interrupt_enable
	beq	skip_interrupt	* DIなら割り込まない
	; EI = 1だった場合、割り込みを処理するが、
	; EIの実行直後の場合は割り込みをスキップする
	.ifdef	DEBUG
	; 新旧の述語が一致することを確かめる
	move.l	emu_counter,d0
	sub.l	ei_at,d0
	subq.l	#1,d0
	seq	d1			* 旧述語
	tst.b	ei_at_yield
	sne	d2			* 新述語
	cmp.b	d1,d2
	bne	ei_chk_ng2
	cmpi.b	#$fb,last_opcode
	seq	d2
	cmp.b	d1,d2
	beq	ei_chk_ok2
ei_chk_ng2:
	illegal
ei_chk_ok2:
	.endif
	bsr	ei_just_executed
	bne	@f
	move.b	#1,cpu_yield	; 1つ命令を実行した後にもう一度割り込みを確認するためにcpu_yieldを1にする
	bra	skip_interrupt
@@:	; あらためて割り込み要求端子の値(ms_cpu_int)を見て割り込み要求があるかどうかを見る
	cmpi.b	#0,ms_cpu_int
	beq	next_emu_yield			* 割り込み要求がない場合は次の処理へ
	addq.l	#1,int_exec_counter
	bsr	INT
	move.w	#0,d0
	bsr	add_interrupt_history
	move.l	emu_counter,emu_counter_latch	* この時点の値を覚えておく
	bra	check_yield_rts

skip_interrupt:
	move.w	#2,d0
	bsr	add_interrupt_history
	bra	next_emu_yield

	; emu_yieldの処理
next_emu_yield:
	bsr	get_emu_yield_func
	cmpi.l	#0,d0
	beq	check_yield_rts
	; C側の処理を呼び出す
	movea.l	d0,a0
	move.l	emu_counter,d0
	sub.l	emu_counter_latch,d0
	move.l	cpu_cycle_latch,cpu_cycle_last
	move.w	(sp)+,sr			* ここで割り込み許可に戻す
	movem.l	d1-d7/a0-a6,-(sp)
	move.l	d0,-(sp)			* カウンタ差分を引数として渡す
	move.l	d7,-(sp)			* PCを引数として渡す
	jsr	(a0)
	lea.l	8(sp),sp
	movem.l	(sp)+,d1-d7/a0-a6

	; C側がメモリマップを変更していた場合に備えて a4 を張り直す。
	; write_mem_* マクロは refresh_PC_if_needed を呼ばないため、
	; ここで張り直さないと古いページを指したまま実行が続く。
	; d7 は上の movem で復元済みなので a4 を正しく再計算できる。
	; 1/60秒に1回しか通らないコールドパスであり、速度への影響はない。
	jsr	refresh_PC_if_needed
	move.l	d0,d0
	bne	@f
	rts					* 割り込許可済みなのでそのままrts
@@:	
	; 0以外が帰ってきたのでエミュレータを終了
	; サブルーチンを1段飛ばすために、SPをインクリメント
	lea.l	4(sp),sp
	bra	emu_end

check_yield_rts:
	move.w	(sp)+,sr			* ここで割り込み許可に戻す
	rts

; emu_yieldの処理
;
; 返り値: d0 : C側の処理ルーチンのアドレス(NULLなら何もしない)
get_emu_yield_func:
	cmpi.w	#0,emu_yield
	bne	@f
	clr.l	d0
	rts
@@:	subq.w	#1,emu_yield
	beq	@f
	clr.l	d0
	rts

	; emu_yieldが0になったので、C側の処理を呼び出す
@@:	move.l	emu_loop_func,d0
	rts

emu_end:
	move.l	a5,cpu_cycle		* a5 に持たせていた値をメモリ側へ戻す
	movem.l	(sp)+,d3-d7/a0-a5
	movea.l	(sp)+,a6		* a6 は cpu_main を指しているので unlk は使えない
	moveq.l #-1,d0
	rts
dumpsp:
	movem.l	d0-d7/a0-a6,-(sp)
	move.l	d6,-(sp)
	move.l	d4,-(sp)
	move.l	d7,-(sp)
	move.l	a4,-(sp)
	move.l	a0,-(sp)
	move.w	sp_(a3),-(sp)
	move.w	#0,-(sp)
	pea.l	registers
	jsr	dumpsp_c
	lea	28(sp),sp
	movem.l	(sp)+,d0-d7/a0-a6
	rts

*
*	void step(ms_cpu_state* context, int count);
*
ms_cpu_step_break:
	.dc.l	0

ms_cpu_step:
	link	a6,#0
	movem.l	d3-d7/a0-a5,-(sp)
	
	move.l	8(a6),a5	* 引数1のcpu contextへのポインタを取得
	move.l	a5,step_ctx	* 実行中は a5 を cpu_cycle に使うので控えておく
	move.l  12(a6),d0	* 引数2のステップ数を取得

	move.l	d0,-(sp)

;	 31     16 15 8 7  0
;	|         |    | A  |  d4	Ａレジスタ
;	|         |    | F  |  d6	Ｆレジスタ
;	| PC page | PC (8k) |  d7
;	|     registers     |  a3	a3 = レジスターの格納されているアドレス
;	|    PC Base ADD    |  a4	a4 = PC
;
; struct ms_cpu_state {
;	void* pc_base_addr;
; 	uint16_t pc, sp, ix, iy;
; 	uint8_t a, b, c, d, e, h, l;
; 	uint8_t a_, b_, c_, d_, e_, h_, l_, f_;
; 	uint8_t i, r;
;
; 	uint8_t f;
;
;	uint16_t wz;					// 30,31
;
; 	uint8_t iff_delay;
; 	uint8_t interrupt_mode;  // 0: IM0, 1: IM1, 2: IM2
;
; 	uint8_t halted;	// 0: normal, 1: halted
; };

	clr.l	d4
	move.l	#$0000e000,d5		* メモリアクセスで使うページ番号の取り出しマスク
	clr.l	d6
	clr.l	d7
	lea.l	base,a3
	;movea.l	(a5),a4			* PC Base ADD
	move.w	4(a5),d7		* PC(64k)
	PC_page_set			* 64kのPCをページ番号と16kのPCに分解
	clr.w	ms_cpu_needs_refresh_PC	* 実行開始時。PC_page_set がリフレッシュそのもの
	move.w	6(a5),sp_(a3)		* SP
	move.w	8(a5),ix_h(a3)		* IX
	move.w	10(a5),iy_h(a3)		* IY
	move.b	12(a5),d4		* A register
	move.b	d4,a(a3)		* f5,f3の値などはメモリ上に保持。その他フラグは各種レジスタに保持
	move.b	13(a5),b(a3)		* B
	move.b	14(a5),c(a3)		* C
	move.b	15(a5),d(a3)		* D
	move.b	16(a5),e(a3)		* E
	move.b	17(a5),h(a3)		* H
	move.b	18(a5),l(a3)		* L
	move.b	19(a5),a_(a3)
	move.b	20(a5),b_(a3)
	move.b	21(a5),c_(a3)
	move.b	22(a5),d_(a3)
	move.b	23(a5),e_(a3)
	move.b	24(a5),h_(a3)
	move.b	25(a5),l_(a3)
	move.b	26(a5),f_(a3)

	move.b	27(a5),i(a3)
	move.b	28(a5),r(a3)

	; フラグのセット
	clr.l	d6
	move.b	29(a5),d6		* F

	; WZレジスタのセット
	move.w	30(a5),wz(a3)

	; cycles
	movea.l	36(a5),a5		* ここから a5 は cpu_cycle

	;
	;	d0個の命令を実行
	clr.l	ms_cpu_step_break
@@:
	move.l	(sp)+,d0
@@:	move.l	d0,-(sp)

	lea.l	ms_cpu_step_ret(pc),a6	* ハンドラは jmp (a6) で帰るので継続先を渡す
	bra	cpu_exec_core
ms_cpu_step_ret:

	;bsr	dumpsp

	move.l	(sp)+,d0
	tst.l	ms_cpu_step_break
	bne	@f
	subq.l	#1,d0
	bne	@b

@@:	
	;	実行後の結果を書き戻す
	move.l	a5,d0			* a5 に持たせていた cpu_cycle を退避
	movea.l	step_ctx,a5		* a5 を context ポインタに戻す
	move.l	d0,36(a5)		* cycles
	;move.l	a4,(a5)			* PC Base ADD
	move.l	d7,d0
	andi.w	#PAGEADDRMASK,d0	* 位置は -8192 基準なので上位 3bit を落とす
	swap	d7			* d7 = 00000000_00000ppp
	ror.w	#PAGENUMBIT,d7		* d7 = ppp00000_00000000
	or.w	d7,d0			* d0 = pppaaaaa_aaaaaaaa = PC (64k)
	move.w	d0,4(a5)		* PC(64k)
	move.w	sp_(a3),6(a5)		* SP
	move.w	ix_h(a3),8(a5)		* IX
	move.w	iy_h(a3),10(a5)		* IY	
	move.b	d4,12(a5)		* A
	move.b	b(a3),13(a5)		* B
	move.b	c(a3),14(a5)		* C
	move.b	d(a3),15(a5)		* D
	move.b	e(a3),16(a5)		* E
	move.b	h(a3),17(a5)		* H
	move.b	l(a3),18(a5)		* L
	move.b	a_(a3),19(a5)
	move.b	b_(a3),20(a5)
	move.b	c_(a3),21(a5)
	move.b	d_(a3),22(a5)
	move.b	e_(a3),23(a5)
	move.b	h_(a3),24(a5)
	move.b	l_(a3),25(a5)
	move.b	f_(a3),26(a5)

	move.b	i(a3),27(a5)
	move.b	r(a3),28(a5)

	; フラグの書き戻し処理
@@:
	move.b	d6,29(a5)

	; WZレジスタの書き戻し処理
	move.w	wz(a3),30(a5)

	; cycles

	movem.l	(sp)+,d3-d7/a0-a5
	movea.l	(sp)+,a6		* a6 は継続先に使ったので unlk は使えない
	moveq.l #0,d0
	rts

*
* 割り込みヒストリに情報を追記します
*	入力: d0.w	割り込みに対する対応の結果:
*		 0: EI状態で割り込みがかかった
*		 1: EIだったがスキップ
*		 2: DI状態で割り込みがスキップ
* 	破壊: a0, d0, d1
*
add_interrupt_history:
	lea	interrupt_history,a0
	move.w	interrupt_history_wr,d1
	lsl.w	#3,d1
	move.w	ms_vsync_interrupt_tick,(a0,d1.w)
	move.w	d0,2(a0,d1.w)
	move.l	emu_counter,d0
	sub.l	emu_counter_latch,d0
	move.l	d0,4(a0,d1.w)
	lsr.w	#3,d1
	addq.w	#1,d1				* wrを一つ進める
	andi.w	#$1f,d1
	move.w	interrupt_history_rd,d0
	cmp.w	d0,d1
	bne	history_not_full
	; 履歴が一杯になったので、読み出し開始位置をずらず
	addq.w	#1,d0				※ rdを一つ進める
	andi.w	#$1f,d0
history_not_full:
	move.w	d1,interrupt_history_wr
	move.w	d0,interrupt_history_rd

	rts


*******************************************************************
* 基本命令ジャンプテーブル
*******************************************************************

	.data
	.quad

ms_instructions_ptr:
	.dc.l	instructions

	.text

*	------ 割り込み処理 ------
INT:	move.b	#0,interrupt_enable	* DI に
	cmpi.b	#1,interrupt_mode	* 割り込みがかかった時の処理
	bhi	mode2
					* モード０割り込みは実現できない
mode1:	move.l	d7,d1
	andi.w	#PAGEADDRMASK,d1	* 位置は -8192 基準なので上位 3bit を落とす
	swap	d7		* d7 = 00000000_00000ppp
	ror.w	#PAGENUMBIT,d7	* d7 = ppp00000_00000000
	or.w	d7,d1		* d1 = pppaaaaa_aaaaaaaa = PC (64k)
	move.w	d1,interrupt_return	* 戻り先アドレスを保存
	subq.w	#2,sp_(a3)	* PUSH	
	move.w	sp_(a3),d0
	write_mem_16	wr16f1,wr16s1,wr16e1

	move.w	#$0038,d7
	PC_page_set
	rts

mode2:	move.l	d7,d1
	andi.w	#PAGEADDRMASK,d1	* 位置は -8192 基準なので上位 3bit を落とす
	swap	d7		* d7 = 00000000_00000ppp
	ror.w	#PAGENUMBIT,d7	* d7 = ppp00000_00000000
	or.w	d7,d1		* d1 = pppaaaaa_aaaaaaaa = PC (64k)
	subq.w	#2,sp_(a3)	* PUSH	
	move.w	sp_(a3),d0
	write_mem_16	wr16f2,wr16s2,wr16e2

	move.b	i(a3),d0
	lsl.w	#8,d0

	read_mem_16	rd16f2,rd16s2,rd16e2
	move.w	d0,d7
	PC_page_set
	rts


nop_h:
	addq.w	#4,a5
nop:	jmp	(a6)

*
*	-------- ＬＤ --------
*
*	------ ＬＤ Ａ,？ ------
LD_A_A_h:
	addq.w	#4,a5
LD_A_A:	jmp	(a6)

LD_A_B_h:
	addq.w	#4,a5
LD_A_B:	move.b	b(a3),d4
	jmp	(a6)

LD_A_C_h:
	addq.w	#4,a5
LD_A_C:	move.b	c(a3),d4
	jmp	(a6)

LD_A_D_h:
	addq.w	#4,a5
LD_A_D:	move.b	d(a3),d4
	jmp	(a6)

LD_A_E_h:
	addq.w	#4,a5
LD_A_E:	move.b	e(a3),d4
	jmp	(a6)

LD_A_H_h:
