;---------------------------------------------------------------------------------------
; ADD Idx,XX の挙動は以下の通り
; * S : 変化しない
; * Z : 変化しない
; * F5: 上位8bitの加算の結果のbit5
; * H : 上位8bitの加算の実行によるハーフキャリー
; * F3: 上位8bitの加算の結果のbit5
; * PV: 変化しない
; * N : 0
; * C : 上位8bitの加算の実行によるキャリー
ADD_Idx_XX macro	ixiy
* ADD_HL_XX と同じ手順。S・Z・P/V は変わらない。
	move.b	(ixiy+1)(a3),d0
	add.b	target_16+1(a3),d0	* 下位バイトを加算。X に桁上げが残る
	move.b	d0,(ixiy+1)(a3)
	move.b	(ixiy+0)(a3),d1		* 上位バイト
	move.b	target_16(a3),d2
	move.b	d1,d3
	eor.b	d2,d3			* 第1項 ^ 第2項（上位バイト）
	addx.b	d2,d1			* 上位バイトを加算。C が確定する
	scs	d2			* C を取り出す（Scc は CCR を変えない）
	move.b	d1,(ixiy+0)(a3)
	eor.b	d1,d3			* ^ 結果 → bit4 が H
	andi.b	#%00010000,d3
	andi.b	#%00000001,d2
	or.b	d2,d3
	move.b	d1,d2			* 結果の上位バイト
	andi.b	#%00101000,d2		* F5,F3
	or.b	d2,d3
	andi.b	#%11000100,d6		* S,Z,P/V だけ残す
	or.b	d3,d6
	endm
;---------------------------------------------------------------------------------------

ADD_Idx_BC_h:
	lea.l	15(a5),a5
ADD_Idx_BC:
	move.w	bc(a3),target_16(a3)
	cmpi.w	#0,d2
	bne	ADD_IY_XX
	ADD_Idx_XX	ix
	jmp	(a6)
ADD_IY_XX:
	ADD_Idx_XX	iy
	jmp	(a6)

ADD_Idx_DE_h:
	lea.l	15(a5),a5
ADD_Idx_DE:
	move.w	de(a3),target_16(a3)
	cmpi.w	#0,d2
	bne	ADD_IY_XX
	ADD_Idx_XX	ix
	jmp	(a6)

ADD_Idx_SP_h:
	lea.l	15(a5),a5
ADD_Idx_SP:
	move.w	sp_(a3),target_16(a3)
	cmpi.w	#0,d2
	bne	ADD_IY_XX
	ADD_Idx_XX	ix
	jmp	(a6)

ADD_Idx_Idx_h:
	lea.l	15(a5),a5
ADD_Idx_Idx:
	cmpi.w	#0,d2
	bne	ADD_IY_IY
	move.w	ix(a3),target_16(a3)
	ADD_Idx_XX	ix
	jmp	(a6)

	.dc.w	15			* サイクル数
	.dc.w	2-1			* 命令語長-1
ADD_IY_IY:
	move.w	iy(a3),target_16(a3)
	ADD_Idx_XX	iy
	jmp	(a6)


