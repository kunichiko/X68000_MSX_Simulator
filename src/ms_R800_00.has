PUSH_Idx_h:
	lea.l	15(a5),a5
PUSH_Idx:
	subq.w	#2,sp_(a3)
	move.w	sp_(a3),d0
	move.w	ix(a3,d2.w),d1
	write_mem_16	wr16f12,wr16s12,wr16e12
	jmp	(a6)

POP_Idx_h:
	lea.l	14(a5),a5
POP_Idx:
	move.w	d2,-(sp)
	move.w	sp_(a3),d0
	read_mem_16	rd16f14,rd16s14,rd16e14
	addq.w	#2,sp_(a3)
	move.w	(sp)+,d2
	move.w	d0,ix(a3,d2.w)
	jmp	(a6)


*	------ ＪＰ (Ｉｄｘ) ------
JP_lIdxl_h:
	lea.l	8(a5),a5
JP_lIdxl:
	move.w	ix(a3,d2.w),d7
	PC_page_set
	jmp	(a6)


*	------ ＥＸ ------
EX_lSPl_Idx_h:
	lea.l	23(a5),a5
EX_lSPl_Idx:
	move.w	d2,-(sp)
	move.w	sp_(a3),d0
	read_mem_16	rd16f15,rd16s15,rd16e15
	move.w	(sp)+,d2
	move.w	ix(a3,d2.w),d1
	move.w	d0,ix(a3,d2.w)
	move.w	sp_(a3),d0
	write_mem_16	wr16f13,wr16s13,wr16e13
	jmp	(a6)

*	------ Ｓｙｓｔｅｍ Ｅｎｄ ------
system_end:
	bra	emu_end

*	------ デバッガに制御を渡す ------
stop:
	jmp	(a6)



**********************************************************************
*
*	ＤＤ/ＦＤ ＣＢライン命令
*
**********************************************************************
;	DD/FD CBライン命令の命令語長は 4 バイト
;	サイクル数は BIT が 20、それ以外は 23。ここで 23 を加算し、BIT だけ 3 を減算する
DDFD_CB_h:
	lea.l	23(a5),a5		* BIT 以外のサイクル数
	addq.w	#2,d7			* オペランドのぶん PC を進める
	addq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	DDFD_CB_h9
	PC_page_inc
DDFD_CB_h9:
DDFD_CB:
	move.w	ix(a3,d2.w),d0		* IX or IYを読む
	* オペランド列から dを取り出す
	move.b	-2(a4),d1		* オペランドを取得
	ext.w	d1
	add.w	d1,d0			* d0 = Idx + d
	* オペランド列から OP CODEを取り出す
	moveq.l	#0,d1
	move.b	-1(a4),d1		* オペランドを取得
	add.w	d1,d1
	add.w	d1,d1
	movea.l	DDFD_CB_JPT(pc,d1.w),a0	* ジャンプ先を取得
	; この時点のレジスタは以下の通り
	; d0.l : IX or IY + d
	; d1.l : OP CODE * 4
	; d2.l : DDの場合は0、FDの場合は2
	; d7.l : 命令語長だけ進めたPCの値
	jmp	(a0)

DDFD_CB_JPT:
	.dc.l	none_DDFD_CB	* $00
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	RLC_lIdx_dl	* $06
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB	* $08
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	RRC_lIdx_dl	* $0e
	.dc.l	none_DDFD_CB	* $0f

	.dc.l	none_DDFD_CB	* $10
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	RL_lIdx_dl		* $16
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB	* $18
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	RR_lIdx_dl		* $1e
	.dc.l	none_DDFD_CB	* $1f

	.dc.l	none_DDFD_CB	* $20
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	SLA_lIdx_dl	* $26
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB	* $28
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	SRA_lIdx_dl	* $2e
	.dc.l	none_DDFD_CB	* $2f

	.dc.l	none_DDFD_CB	* $30
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	SLI_lIdx_dl	* $36
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB	* $38
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	none_DDFD_CB
	.dc.l	SRL_lIdx_dl	* $3e
	.dc.l	none_DDFD_CB	* $3f

	.dc.l	BIT_lIdx_dl	* $40
