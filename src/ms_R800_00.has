; d0 には Idx + d がセットされて呼ばれる

none_DDFD_CB:				* おかしな命令を実行しました
	lsr.w	#2,d1			* d1 を OP CODE に復元
	move.w	d1,d0			* d1はOP CODE
	lsr.w	#4,d0
	lea.l	HEX,a0
	move.b	(a0,d0.w),number_ddfdcb+0
	andi.w	#$0f,d1
	move.b	(a0,d1.w),number_ddfdcb+1

	pea.l	errms_ddfdcb
	DOS	__PRINT
	lea.l	4(sp),sp
	move.b	#$ff,d0
	jmp	(a6)

errms_ddfdcb:
	.dc.b	'おかしな命令を実行しました。0xdd or 0xfd,0xcb,nn,0x'
number_ddfdcb:
	.dc.b	'00'
	.dc.b	0x0d,0x0a,0x00

	.even


; d0 には Idx + d がセットされて呼ばれる
RLC_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f59,rd8s59,rd8e59
	move.b	d0,target_8(a3)
	RXX_	1, 1
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f36,wr8s36,wr8e36
	jmp	(a6)

RRC_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f60,rd8s60,rd8e60
	move.b	d0,target_8(a3)
	RXX_	0, 1
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f37,wr8s37,wr8e37
	jmp	(a6)

RL_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f61,rd8s61,rd8e61
	move.b	d0,target_8(a3)
	RXX_	1, 0
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f38,wr8s38,wr8e38
	jmp	(a6)

RR_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f62,rd8s62,rd8e62
	move.b	d0,target_8(a3)
	RXX_	0, 0
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f39,wr8s39,wr8e39
	jmp	(a6)

SLA_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f63,rd8s63,rd8e63
	move.b	d0,target_8(a3)
	SXX	1, 0
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f40,wr8s40,wr8e40
	jmp	(a6)

SRA_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f64,rd8s64,rd8e64
	move.b	d0,target_8(a3)
	SXX	0, 2
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f41,wr8s41,wr8e41
	jmp	(a6)

SRL_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f65,rd8s65,rd8e65
	move.b	d0,target_8(a3)
	SXX	0, 0
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f42,wr8s42,wr8e42
	jmp	(a6)

SLI_lIdx_dl:
	move.w	d0,-(sp)		* Idx + d を退避
	read_mem_8	rd8f66,rd8s66,rd8e66
	move.b	d0,target_8(a3)
	SXX	1, 1
	move.b	d0,d1
	move.w	(sp)+,d0
	write_mem_8	wr8f43,wr8s43,wr8e43
	jmp	(a6)

*	------ ＢＩＴ n,(Idx+d) ------
; ＢＩＴ命令の挙動は以下の通り
; * S : BIT 7,?の時だけ、対象のbit7が1なら1。それ以外の時は0
; * Z : 対象のbitが0なら1。それ以外の時は0
; * F5: Idx+d の上位8bitの値(bit13)が入る
; * H : 1
; * F3: Idx+d の上位8bitの値(bit11)が入る
; * PV: Zフラグと同じ
; * N : 0
; * C : 変化しない
; ただし、対象が(HL)の場合だけ、F5,F3は内部のWZレジスタの上位8bitの値(bit13,11)が入るらしい

; d0 には Idx + d がセットされて呼ばれる
; d1 には DD CB dd XX の XX (OP CODE) を 4 倍した値が入っている
BIT_lIdx_dl:
	lea.l	-3(a5),a5		* BIT のサイクル数は 20
	andi.w	#%00000000_11100000,d1	* BIT_n_? の n を d1にロード
	lsr.w	#5,d1
	moveq.l	#1,d2
	lsl	d1,d2			* 対象位置のビットをセット
	move.w	d0,-(sp)		* Idx + d を退避
	move.w	d2,-(sp)
	move.w	d0,-(sp)		* Idx + d を退避
@@:
	andi.b	#%00000001,d6		* Ｃ だけ残す
	ori.b	#%00010000,d6		* H をセット
	move.w	(sp)+,d0		* Idx + d を復帰
	read_mem_8	rd8f67,rd8s67,rd8e67
	move.w	(sp)+,d2
	move.w	(sp)+,d1		* Idx + d を復帰
	lsr.w	#8,d1			* (Idx)の時、F5,F3には読み出したアドレス(=Idx+d)の上位8bitを使う
	andi.b	#%00101000,d1		* F5,F3を取得
	or.b	d1,d6			* F5,F3をFレジスタに反映
	and.b	d2,d0			* レジスタの nビット目をテストするためにマスク
	bne	1f
	ori.b	#%01000100,d6		* Z,P/V をセット
1:	andi.b	#%10000000,d0		* bit7のみ残す
	or.b	d0,d6			* bit7を Sフラグに反映
	jmp	(a6)


*	------ ＳＥＴ n,(Idx+d) ------
; d0 には Idx + d がセットされて呼ばれる
; d1 には DD CB dd XX の XX (OP CODE) を 4 倍した値が入っている
SET_lIdx_dl_dispatch:
	bsr	SET_lIdx_dl			* SET n,(Idx+d) が部品として使うため SET_lIdx_dl は rts のまま
	jmp	(a6)

SET_lIdx_dl:
	andi.w	#%00000000_11100000,d1	* BIT_n_? の n を d1にロード
	lsr.w	#5,d1
	move.w	d0,-(sp)			* Idx + d を退避
	move.w	d1,-(sp)
	read_mem_8	rd8f68,rd8s68,rd8e68
	move.w	(sp)+,d1
	bset.l	d1,d0				* (Idx + d)の nビット目をセット
	move.b	d0,d1
	move.w	(sp)+,d0
	move.b	d1,-(sp)			* 結果を残しておく
	write_mem_8	wr8f44,wr8s44,wr8e44
	move.b	(sp)+,d0			* 結果を d0に入れて戻る(SET n,(Idx+d),Xのため)
	rts

*	------ ＳＥＴ n,(Idx+d),X ------
;---------------------------------------------------------------------------------------
; 未定義命令。SET n,(Idx+d)の実行後、結果をXレジスタにストアする命令。
; XはOP Codeの下位3ビットで指定され、以下のように対応している。
; 0: Bレジスタ
; 1: Cレジスタ
; 2: Dレジスタ
; 3: Eレジスタ
; 4: Hレジスタ
; 5: Lレジスタ
; 6: RES n,(Idx+d)
; 7: Aレジスタ
SET_lIdx_dl_X	macro	target
	bsr	SET_lIdx_dl			* SET n,(Idx+d) を実行
	; 実行結果が d0 に入っているので、それをXレジスタにストア
	move.b	d0,target
	endm
;---------------------------------------------------------------------------------------
SET_lIdx_dl_B:
	SET_lIdx_dl_X	b(a3)
	jmp	(a6)

SET_lIdx_dl_C:
	SET_lIdx_dl_X	c(a3)
	jmp	(a6)

SET_lIdx_dl_D:
	SET_lIdx_dl_X	d(a3)
	jmp	(a6)

SET_lIdx_dl_E:
	SET_lIdx_dl_X	e(a3)
	jmp	(a6)

SET_lIdx_dl_H:
	SET_lIdx_dl_X	h(a3)
	jmp	(a6)

SET_lIdx_dl_L:
	SET_lIdx_dl_X	l(a3)
	jmp	(a6)

SET_lIdx_dl_A:
	SET_lIdx_dl_X	d4
	jmp	(a6)



*	------ ＲＥＳ n,(Idx+d) ------
RES_lIdx_dl_dispatch:
	bsr	RES_lIdx_dl			* RES n,(Idx+d) が部品として使うため RES_lIdx_dl は rts のまま
	jmp	(a6)

RES_lIdx_dl:
	andi.w	#%00000000_11100000,d1	* BIT_n_? の n を d1にロード
	lsr.w	#5,d1
	move.w	d0,-(sp)			* Idx + d をプッシュ
	move.w	d1,-(sp)
	read_mem_8	rd8f69,rd8s69,rd8e69
	move.w	(sp)+,d1
	bclr.l	d1,d0				* (Idx + d)の nビット目をクリア
	move.b	d0,d1
	move.w	(sp)+,d0
	move.b	d1,-(sp)			* 結果を残しておく
	write_mem_8	wr8f45,wr8s45,wr8e45
	move.b	(sp)+,d0			* 結果を d0に入れて戻る(RES n,(Idx+d),Xのため)
	rts

*	------ ＲＥＳ n,(Idx+d),X ------
;---------------------------------------------------------------------------------------
; 未定義命令。RES n,(Idx+d)の実行後、結果をXレジスタにストアする命令。
; XはOP Codeの下位3ビットで指定され、以下のように対応している。
; 0: Bレジスタ
; 1: Cレジスタ
; 2: Dレジスタ
; 3: Eレジスタ
; 4: Hレジスタ
; 5: Lレジスタ
; 6: RES n,(Idx+d)
; 7: Aレジスタ
RES_lIdx_dl_X	macro	target
	bsr	RES_lIdx_dl			* RES n,(Idx+d) を実行
	; 実行結果が d0 に入っているので、それをXレジスタにストア
	move.b	d0,target
	endm
;---------------------------------------------------------------------------------------
	
RES_lIdx_dl_B:
	RES_lIdx_dl_X	b(a3)
	jmp	(a6)

RES_lIdx_dl_C:
	RES_lIdx_dl_X	c(a3)
	jmp	(a6)

RES_lIdx_dl_D:
	RES_lIdx_dl_X	d(a3)
	jmp	(a6)

RES_lIdx_dl_E:
	RES_lIdx_dl_X	e(a3)
	jmp	(a6)

RES_lIdx_dl_H:
	RES_lIdx_dl_X	h(a3)
	jmp	(a6)

RES_lIdx_dl_L:
	RES_lIdx_dl_X	l(a3)
	jmp	(a6)

RES_lIdx_dl_A:
	RES_lIdx_dl_X	d4
	jmp	(a6)



*****************************************************
*
*		Ｉ/Ｏ関係のルーチン
*
*****************************************************

*	------ ＩＮ ------
IN_A_n_h:
	lea.l	11(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	IN_A_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	IN_A_n_o
	lea.l	IN_A_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
IN_A_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
IN_A_n:	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	bsr	input
	move.b	d0,d4
	jmp	(a6)

;---------------------------------------------------------------------------------------
; IN r,(C) の挙動
; * S : 読み込んだ値のbit7
; * Z : 読み込んだ値が0なら1。それ以外の時は0
; * F5: 変化しない
; * H : 0
; * F3: 変化しない
; * PV: 読み込んだ値のパリティ
; * N : 0
; * C : 変化しない
IN_X_C	macro
* S,Z,F5,F3,P/V は読んだ値だけから決まり、H=0、N=0、C は変化しない。
* 表を 1 回引けば揃う。
	move.b	c(a3),d0
	bsr	input
	moveq.l	#0,d3
	move.b	d0,d3			* 読んだ値
	move.b	szp53p(a3,d3.w),d3		* S,Z,F5,F3,P/V を一度に引く
	andi.b	#%00000001,d6		* Ｃ だけ残す
	or.b	d3,d6
	endm
;---------------------------------------------------------------------------------------

IN_A_c_h:
	lea.l	12(a5),a5
IN_A_c:	IN_X_C
	move.b	d0,d4
	jmp	(a6)

IN_B_c_h:
	lea.l	12(a5),a5
IN_B_c:	IN_X_C
	move.b	d0,b(a3)
	jmp	(a6)

IN_C_c_h:
	lea.l	12(a5),a5
IN_C_c:	IN_X_C
	move.b	d0,c(a3)
	jmp	(a6)

IN_D_c_h:
	lea.l	12(a5),a5
IN_D_c:	IN_X_C
	move.b	d0,d(a3)
	jmp	(a6)

IN_E_c_h:
	lea.l	12(a5),a5
IN_E_c:	IN_X_C
	move.b	d0,e(a3)
	jmp	(a6)

IN_H_c_h:
	lea.l	12(a5),a5
IN_H_c:	IN_X_C
	move.b	d0,h(a3)
	jmp	(a6)

IN_L_c_h:
	lea.l	12(a5),a5
IN_L_c:	IN_X_C
	move.b	d0,l(a3)
	jmp	(a6)

IN_F_c_h:
	lea.l	12(a5),a5
IN_F_c:	IN_X_C
	; IN F,(C) は、読み込んだ値に対してフラグが変化するだけでどこにも結果は保存されない
	jmp	(a6)

*	------ ＩＮＩ ------
; INI の挙動
; * S : 不変(?)
; * Z : Bレジスタをデクリメントした結果が0なら1。それ以外の時は0
; * F5: 変化しない
; * H : 変化しない
; * F3: 変化しない
; * PV: 変化しない
; * N : 1
; * C : 変化しない
INI_dispatch_h:
	lea.l	16(a5),a5
INI_dispatch:
	bsr	INI			* INIR が部品として使うため INI は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
INI:* この命令が変えるのは Z と N だけ。
	andi.b	#%10111111,d6		* Ｚ を落とす
	ori.b	#%00000010,d6		* N=1 にセット
	move.b	c(a3),d0
	bsr	input
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f46,wr8s46,wr8e46
	addq.w	#1,hl(a3)
	subq.b	#1,b(a3)
	bne	@f
	ori.w	#%01000000,d6		* Z をセット
@@:	rts

*	------ ＩＮＤ ------
IND_dispatch_h:
	lea.l	16(a5),a5
IND_dispatch:
	bsr	IND			* INDR が部品として使うため IND は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
IND:* この命令が変えるのは Z と N だけ。
	andi.b	#%10111111,d6		* Ｚ を落とす
	ori.b	#%00000010,d6		* N=1 にセット
	move.b	c(a3),d0
	bsr	input
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f47,wr8s47,wr8e47
	subq.w	#1,hl(a3)
	subq.b	#1,b(a3)
	bne	@f
	ori.w	#%01000000,d6		* Z をセット
@@:	rts

*	------ ＩＮＩＲ ------
INIR_h:
	lea.l	21(a5),a5
INIR:	bsr	INI
	cmpi.b	#0,b(a3)
	bne	@f
	; 最終読み込みの場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)

*	------ ＩＮＤＲ ------
INDR_h:
	lea.l	21(a5),a5
INDR:	bsr	IND
	cmpi.b	#0,b(a3)
	bne	@f
	; 最終読み込みの場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)

	
*	------ ＯＵＴ ------
OUT_n_A_h:
	lea.l	11(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	OUT_n_A(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	OUT_n_A_o
	lea.l	OUT_n_A(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
OUT_n_A_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
OUT_n_A:
	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	move.b	d4,d1
	bsr	output
	jmp	(a6)

;---------------------------------------------------------------------------------------
; OUT (C),r の挙動
; フラグ変化はしない
OUT_C_X	macro
	move.b	c(a3),d0
	bsr	output
	endm
;---------------------------------------------------------------------------------------

OUT_c_A_h:
	lea.l	12(a5),a5
OUT_c_A:
	move.b	d4,d1
	OUT_C_X
	jmp	(a6)

OUT_c_B_h:
	lea.l	12(a5),a5
OUT_c_B:
	move.b	b(a3),d1
	OUT_C_X
	jmp	(a6)

OUT_c_C_h:
	lea.l	12(a5),a5
OUT_c_C:
	move.b	c(a3),d1
	OUT_C_X
	jmp	(a6)

OUT_c_D_h:
	lea.l	12(a5),a5
OUT_c_D:
	move.b	d(a3),d1
	OUT_C_X
	jmp	(a6)

OUT_c_E_h:
	lea.l	12(a5),a5
OUT_c_E:
	move.b	e(a3),d1
	OUT_C_X
	jmp	(a6)

OUT_c_H_h:
	lea.l	12(a5),a5
OUT_c_H:
	move.b	h(a3),d1
	OUT_C_X
	jmp	(a6)

OUT_c_L_h:
	lea.l	12(a5),a5
OUT_c_L:
	move.b	l(a3),d1
	OUT_C_X
	jmp	(a6)

*	------ ＯＵＴＩ ------
; OUTI の挙動
; * S : 不変(?)
; * Z : Bレジスタをデクリメントした結果が0なら1。それ以外の時は0
; * F5: 変化しない
; * H : 変化しない
; * F3: 変化しない
; * PV: 変化しない
; * N : 1
; * C : 変化しない
OUTI_dispatch_h:
	lea.l	16(a5),a5
OUTI_dispatch:
	bsr	OUTI			* OTIR が部品として使うため OUTI は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
OUTI:* この命令が変えるのは Z と N だけ。
	andi.b	#%10111111,d6		* Ｚ を落とす
	ori.b	#%00000010,d6		* N=1 にセット
	move.w	hl(a3),d0
	read_mem_8	rd8f70,rd8s70,rd8e70
	move.b	d0,d1		* 書き込む値
	OUT_C_X
	addq.w	#1,hl(a3)
	subq.b	#1,b(a3)
	bne	@f
	ori.w	#%01000000,d6		* Z をセット
@@:	rts

*	------ ＯＵＴＤ ------
OUTD_dispatch_h:
	lea.l	16(a5),a5
OUTD_dispatch:
	bsr	OUTD			* OTDR が部品として使うため OUTD は rts のまま
	jmp	(a6)

	.dc.w	16			* サイクル数
	.dc.w	2-1			* 命令語長-1
OUTD:* この命令が変えるのは Z と N だけ。
	andi.b	#%10111111,d6		* Ｚ を落とす
	ori.b	#%00000010,d6		* N=1 にセット
	move.w	hl(a3),d0
	read_mem_8	rd8f71,rd8s71,rd8e71
	move.b	d0,d1		* 書き込む値
	OUT_C_X
	subq.w	#1,hl(a3)
	subq.b	#1,b(a3)
	bne	@f
	ori.w	#%01000000,d6		* Z をセット
@@:	rts

*	------ ＯＴＩＲ ------
OTIR_h:
	lea.l	21(a5),a5
OTIR:	bsr	OUTI
	cmpi.b	#0,b(a3)
	bne	@f
	; 最終書き込みの場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)

*	------ ＯＴＤＲ ------
OTDR_h:
	lea.l	21(a5),a5
OTDR:	bsr	OUTD
	cmpi.b	#0,b(a3)
	bne	@f
	; 最終書き込みの場合はサイクル数が16なので5サイクル引く
	subq.l	#5,a5
	jmp	(a6)
@@:	subq.w	#2,d7
	subq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	@f			* PC -2 でページ境界をまたいだか？
	PC_page_dec			* またいだ時
@@:	jmp	(a6)


*****************************************************************
*
*	ポートからの読み込み
*
*  (引数)
*	.d0.b	ポート番号
*  (帰り値)
*	.d0.b	読み込んだ値
*
*	d1,d2,d3 破壊可能性あり
*
*****************************************************************	
*
*	I/O ハンドラの呼び出し規約
*
*	引数はレジスタで渡す。d0.b がポート番号、d1.b が書き込む値である。
*	スタックには積まない。C で書かれたハンドラは ms_iomap.has の
*	io_default_in / io_default_out が引数を積み替える。
*
*	ms_io_input_table / ms_io_output_table の先が壊してよいのは
*	d0-d3 / a0-a2 と a5 である。d4-d7 / a3 / a4 は壊してはならない。
*
*	a5 だけは入口で退避する。ms_vdp.has の write_vdp_* が
*	ms_vdp_t へのポインタとして使うため。
*
*	C で書かれたハンドラは m68k の ABI により d2-d7 / a2-a5 を保存する。
*	アセンブラで書かれたハンドラを足すときは、この契約を守ること。
*
input:
	move.l	a5,-(sp)		* I/O ハンドラが壊すのは a5 だけ（下記の契約）
	andi.l	#$ff,d0				* 上位バイトを０でクリア
	lea.l	ms_io_input_table,a0
	move.w	d0,d2			* d2 は呼び出し規約上スクラッチ
	add.w	d2,d2
	add.w	d2,d2
	movea.l	(a0,d2.w),a0			* d0 は破壊しない。この後 C関数の引数として渡す
.ifdef	DEBUG
	bsr	print_debug_in
.endif
	jsr	(a0)				* 引数はレジスタ渡し（d0＝ポート番号）
	movea.l	(sp)+,a5
	rts

*****************************************************************
*
*	ポートへの書き込み
*
*  (引数)
*	.d0.b	ポート番号
*	.d1.b	書き込む値
*
*	d1 破壊
*
*****************************************************************	
output:
	move.l	a5,-(sp)		* I/O ハンドラが壊すのは a5 だけ（下記の契約）

	andi.l	#$ff,d0				* 上位バイトを０でクリア
	andi.l	#$ff,d1				* 上位バイトを０でクリア
	lea	ms_io_output_table,a0
	move.w	d0,d2			* d2 は呼び出し規約上スクラッチ
	add.w	d2,d2
	add.w	d2,d2
	movea.l	(a0,d2.w),a0			* d0 は破壊しない。この後 C関数の引数として渡す
.ifdef	DEBUG
	bsr	print_debug_out
.endif
	jsr	(a0)				* 引数はレジスタ渡し（d0＝ポート番号、d1＝値）
	movea.l	(sp)+,a5
	tst.w	ms_cpu_needs_refresh_PC		* ページ切り替えが起きた時だけ張り直す
	bne	1f
	rts
1:	jmp	refresh_PC_if_needed

print_debug_in:
	cmp.w	#MS_LOG_TRACE,debug_log_level
	;bge	@f
	rts
@@:	movem.l	d0-d3/a0-a3,-(sp)
	move.b	d0,d2
	lsr.w	#4,d0
	lea.l	HEX,a0
	move.b	(a0,d0.w),debug_in_number+0	* ポート番号の上位4bit
	andi.w	#$0f,d2
	move.b	(a0,d2.w),debug_in_number+1	* ポート番号の下位4bit

	pea.l	debug_in_msg
	DOS	__PRINT
	lea.l	4(sp),sp
	movem.l	(sp)+,d0-d3/a0-a3
	rts

print_debug_out:
	cmp.w	#MS_LOG_TRACE,debug_log_level		* TRACE以上の時
	;bge	@f
	rts
@@:	movem.l	d0-d3/a0-a3,-(sp)
	move.b	d0,d2
	lsr.w	#4,d0
	lea.l	HEX,a0
	move.b	(a0,d0.w),debug_out_number+0	* ポート番号の上位4bit
	andi.w	#$0f,d2
	move.b	(a0,d2.w),debug_out_number+1	* ポート番号の下位4bit
	move.w	d1,d2
	lsr.w	#4,d1
	lea.l	HEX,a0
	move.b	(a0,d1.w),debug_out_value+0	* 書き込む値の上位4bit
	andi.w	#$0f,d2
	move.b	(a0,d2.w),debug_out_value+1	* 書き込む値の下位4bit

	pea.l	debug_out_msg
	DOS	__PRINT
	lea.l	4(sp),sp
	movem.l	(sp)+,d0-d3/a0-a3
	rts

	.data


debug_in_msg:
	.dc.b	'I/O read P:0x'
debug_in_number:
	.dc.b	'00'
	.dc.b	0x0d,0x0a,0x00

debug_out_msg:
	.dc.b	'I/O write P:0x'
debug_out_number:
	.dc.b	'00'
	.dc.b	' V:0x'
debug_out_value:
	.dc.b	'00'
	.dc.b	0x0d,0x0a,0x00



*************** ワークエリア ******************

	.data
	.even

PC_page:
	.dc.w	0	* 現在ＰＣが存在するページ

emu_loop_func:
	.dc.l	0	* エミュレータのループ関数のアドレス

	.even				* ロングワードなので偶数境界に置く
step_ctx:			* ms_cpu_step が cpu context を控える場所
	.dc.l	0

ms_cpu_registers_ptr:
	.dc.l	registers

* ページポインタ配列。a3 の負オフセット（±127）で引けるよう base の直前に置く
	.quad
ms_cpu_mem_ptr_array:
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0

; データ読み出し／書き込みの高速パス用ポインタ配列（8Kバイト単位）
; NULL は「そのページは C のドライバを経由する」ことを意味する。
; 初期値 0（全ページ C 経由）が安全側であり、C 側が更新するまで直接アクセスは行われない。
ms_cpu_mem_rptr_array:
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
ms_cpu_mem_wptr_array:
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0
	.dc.l	0

* CPU のメインループが毎命令触る 2 つ。a3 の負オフセットで引く。
* .quad により cpu_sub_emu_yield は 4 の倍数に置かれ、base も 4 の倍数になる。
	.quad
cpu_sub_emu_yield:		* cpu_yield, sub_yield, emu_yield を同時にロングワードアクセスするときはこちらのラベルを使用する
cpu_yield:
	.dc.b	0
sub_yield:
	.dc.b	0
emu_yield:
	.dc.w	0
emu_counter:
	.dc.b	0,0,0
* a3 は emu_counter の最下位バイトを指す。毎命令の加算を addq.b #1,(a3) の
* 一語で済ませるため。レジスタはすべて base からの差で定義してあるので、
* base の位置が変わっても参照先は変わらない
base:			* a3 の指すアドレス
	.dc.b	0		* emu_counter の最下位バイト
registers:
	.dc.b	0	* a
	.dc.b	0	* f
	.dc.b	0	* b
	.dc.b	0	* c
	.dc.b	0	* d
	.dc.b	0	* e
	.dc.b	0	* h
	.dc.b	0	* l

	.dc.b	0	* ix_h
	.dc.b	0	* ix_l
	.dc.b	0	* iy_h
	.dc.b	0	* iy_l

	.dc.b	0	* s
	.dc.b	0	* p

pair_registers:		* 裏レジスタの保存場所
	.dc.b	0	* a'
	.dc.b	0	* f'
	.dc.b	0	* b'
	.dc.b	0	* c'
	.dc.b	0	* d'
	.dc.b	0	* e'
	.dc.b	0	* h'
	.dc.b	0	* l'


r_:	.dc.b	0	* Ｒレジスタ
i_:	.dc.b	0	* Ｉレジスタ

wz_:
w_:	.dc.b	0	* Ｗレジスタ
z_:	.dc.b	0	* Ｚレジスタ

target_16_:		* 各命令の演算で使用する値を保持する領域
	.dc.b	0
target_8_:
	.dc.b	0

* 演算結果 1 バイトから S,Z,F5,F3,P/V(パリティ) を一度に引く表。
* 値は F レジスタのビット位置そのままで、bit4(H) / bit1(N) / bit0(C) は常に 0。
* a3 の正オフセット（±127）で引けるよう base の近くに置く
szp53p_tbl:
	.dc.b	$44,$00,$00,$04,$00,$04,$04,$00,$08,$0C,$0C,$08,$0C,$08,$08,$0C
	.dc.b	$00,$04,$04,$00,$04,$00,$00,$04,$0C,$08,$08,$0C,$08,$0C,$0C,$08
	.dc.b	$20,$24,$24,$20,$24,$20,$20,$24,$2C,$28,$28,$2C,$28,$2C,$2C,$28
	.dc.b	$24,$20,$20,$24,$20,$24,$24,$20,$28,$2C,$2C,$28,$2C,$28,$28,$2C
	.dc.b	$00,$04,$04,$00,$04,$00,$00,$04,$0C,$08,$08,$0C,$08,$0C,$0C,$08
	.dc.b	$04,$00,$00,$04,$00,$04,$04,$00,$08,$0C,$0C,$08,$0C,$08,$08,$0C
	.dc.b	$24,$20,$20,$24,$20,$24,$24,$20,$28,$2C,$2C,$28,$2C,$28,$28,$2C
	.dc.b	$20,$24,$24,$20,$24,$20,$20,$24,$2C,$28,$28,$2C,$28,$2C,$2C,$28
	.dc.b	$80,$84,$84,$80,$84,$80,$80,$84,$8C,$88,$88,$8C,$88,$8C,$8C,$88
	.dc.b	$84,$80,$80,$84,$80,$84,$84,$80,$88,$8C,$8C,$88,$8C,$88,$88,$8C
	.dc.b	$A4,$A0,$A0,$A4,$A0,$A4,$A4,$A0,$A8,$AC,$AC,$A8,$AC,$A8,$A8,$AC
	.dc.b	$A0,$A4,$A4,$A0,$A4,$A0,$A0,$A4,$AC,$A8,$A8,$AC,$A8,$AC,$AC,$A8
	.dc.b	$84,$80,$80,$84,$80,$84,$84,$80,$88,$8C,$8C,$88,$8C,$88,$88,$8C
	.dc.b	$80,$84,$84,$80,$84,$80,$80,$84,$8C,$88,$88,$8C,$88,$8C,$8C,$88
	.dc.b	$A0,$A4,$A4,$A0,$A4,$A0,$A0,$A4,$AC,$A8,$A8,$AC,$A8,$AC,$AC,$A8
	.dc.b	$A4,$A0,$A0,$A4,$A0,$A4,$A4,$A0,$A8,$AC,$AC,$A8,$AC,$A8,$A8,$AC

; CPUのメインループを極力高速化するため、Z80の割り込みや、エミュレータの割り込み(キーボード処理など)を
; yieldフラグを見て分岐するようにしています。
; yieldフラグには cpu_yield、sub_yield、emu_yieldがあり、すべてが0の場合は、CPUのメインループが
; 割り込まれずに実行されます。
; このフラグは、以下のような動作をします。
;
; ● cpu_yield, sub_yield
; cpu_yield、sub_yieldに1以上をセットすると、1命令処理するごとにカウントダウンし、0になるタイミングで、
; 以下の動作をします:
;   * EI状態で、VDPからの割り込み要求があるなら、割り込みを発生させる
;   * DI状態なら無視する(割り込みは取りこぼされる)
;
; 通常はX68000側のVSYNC割り込みでcpu_yieldに1をセットし、即座にZ80側の割り込みがかかるようにします。
; タイミング調整が必要になった場合は、このフラグを使って調整可能です。
; 走査線割り込みをサポートする場合は、sub_yieldをセットしますこのフラグに1以上の値をセットして
; 走査線割り込みのタイミングを 調整することが可能です。
;
; ● emu_yield
; emu_yieldに1以上をセットすると、1命令処理するごとにカウントダウンし、0になるタイミングで、
; 以下の動作をします:
;    * X68000側のキーボード入力の処理を行う
;
; 通常はX68000側のVSYNC割り込みで cpu_yieldより100くらい大きめの値をセットします。これにより、
; cpu_yieldの方が先に処理され、Z80の割り込み処理ルーチンが優先的に動くようになります。
; emu_yieldの頻度を調整したい場合は、VSYNC割り込み以外のタイマー割り込みを使ってセットするように
; しても良いです。
debug_log_level:
	.dc.w	0		* ms.c の main() の最初で上書きしている

;	割り込み許可状態を示すフラグ
;	0 ・・・ DI
;	1 ・・・ EI
interrupt_enable:
	.dc.b	0

;	最後に実行した命令のオペコード (最初の1バイトのみ)
;	正確には命令フェッチした直後にセットされるので、メインループの中やエミュレータの
;	割り込み処理の中では「最後に実行した命令」ですが、各命令の処理中は
;	「今実行中の命令」となります。
	.even				* ロングワードなので偶数境界に置く
ei_at:				* EI を実行した時点の emu_counter
	.dc.l	0

last_opcode:
	.dc.b	0

interrupt_mode:
	.dc.b	0		* インタラプトモード 0, 1, 2

	.even

cpu_in_interrupt:		* CPUが割り込み処理中の時 0以外の値が入っている（実際は割り込み処理の戻り先アドレス）
interrupt_return:
	.dc.w	0		* 割り込み処理の戻り先アドレス。割り込みが終わったら0クリアされます。
vdp_draw_pending:
	.dc.w	0

cpu_in_interrupt_d:		* 直前の cpu_in_interrupt。上のワードと合わせて 1 ロングワードで読む
	.dc.w	0

	.end
