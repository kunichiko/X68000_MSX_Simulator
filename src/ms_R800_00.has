********************************************************************
*
*	＄ＥＤライン命令
*
********************************************************************
;	EDライン命令のサイクル数は不定なので0にしておき、各命令ごとに加算する
;	EDラインの命令語長は2-4バイトなので、ここは2にしておき、各命令ごとに加算する
*
*	前置き ED。境界判定は「またがない」を不成立側にして、常用経路を 2 サイクル安くする。
*	コールドパスは本体の手前へ出し、常用経路が本体へ落ちるようにする。
*
ED_edge:
	lea.l	ED(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2

ED_h:
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	bra	ED_edge			* 検証用: 常にエッジ処理を通す
	.else
	bgt	ED_edge
	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
ED:	* オペランド列から第二オペコードを取り出す
	clr.w	d0
	move.b	(a4)+,d0
	subi.w	#$40,d0
	bcs	other			* ＄３ｆ以下の時は特殊命令へ
	add.w	d0,d0
	add.w	d0,d0
	movea.l	ED_JPT(pc,d0.w),a0	* 表は前置きの先頭を指している
	jmp	(a0)
ED_JPT:	.dc.l	IN_B_c_h			* $40
	.dc.l	OUT_c_B_h
	.dc.l	SBC_HL_BC_h
	.dc.l	LD_lnnl_BC_h
	.dc.l	NEG_h
	.dc.l	RETN_h
	.dc.l	IM_0_h
	.dc.l	LD_I_A_h
	.dc.l	IN_C_c_h			* $48
	.dc.l	OUT_c_C_h
	.dc.l	ADC_HL_BC_h
	.dc.l	LD_BC_lnnl_h
	.dc.l	none_ED_h
	.dc.l	RETI_h
	.dc.l	none_ED_h
	.dc.l	LD_R_A_h			* $4f

	.dc.l	IN_D_c_h			* $50
	.dc.l	OUT_c_D_h
	.dc.l	SBC_HL_DE_h
	.dc.l	LD_lnnl_DE_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	IM_1_h
	.dc.l	LD_A_I_h
	.dc.l	IN_E_c_h			* $58
	.dc.l	OUT_c_E_h
	.dc.l	ADC_HL_DE_h
	.dc.l	LD_DE_lnnl_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	IM_2_h
	.dc.l	LD_A_R_h			* $5f

	.dc.l	IN_H_c_h			* $60
	.dc.l	OUT_c_H_h
	.dc.l	SBC_HL_HL_h
	.dc.l	LD_lnnl_HL_2_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	RRD_lHLl_h
	.dc.l	IN_L_c_h			* $68
	.dc.l	OUT_c_L_h
	.dc.l	ADC_HL_HL_h
	.dc.l	LD_HL_lnnl_2_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	RLD_lHLl_h		* $6f

	.dc.l	IN_F_c_h			* $70
	.dc.l	none_ED_h
	.dc.l	SBC_HL_SP_h
	.dc.l	LD_lnnl_SP_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	IN_A_c_h			* $78
	.dc.l	OUT_c_A_h
	.dc.l	ADC_HL_SP_h
	.dc.l	LD_SP_lnnl_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $7f

	.dc.l	none_ED_h			* $80
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $88
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $8f

	.dc.l	none_ED_h			* $90
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $98
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $9f

	.dc.l	LDI_dispatch_h			* $a0
	.dc.l	CPI_dispatch_h
	.dc.l	INI_dispatch_h
	.dc.l	OUTI_dispatch_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	LDD_dispatch_h			* $a8
	.dc.l	CPD_dispatch_h
	.dc.l	IND_dispatch_h
	.dc.l	OUTD_dispatch_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $af

	.dc.l	LDIR_h			* $b0
	.dc.l	CPIR_h
	.dc.l	INIR_h
	.dc.l	OTIR_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	LDDR_h			* $b8
	.dc.l	CPDR_h
	.dc.l	INDR_h
	.dc.l	OTDR_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $bf

	.dc.l	none_ED_h			* $c0
	.dc.l	MULB_A_B_h
	.dc.l	none_ED_h
	.dc.l	MULW_HL_BC_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $c8
	.dc.l	MULB_A_C_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $cf

	.dc.l	none_ED_h			* $d0
	.dc.l	MULB_A_D_h
	.dc.l	none_ED_h
	.dc.l	MULW_HL_DE_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $d8
	.dc.l	MULB_A_E_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $df

	.dc.l	none_ED_h			* $e0
	.dc.l	MULB_A_H_h
	.dc.l	none_ED_h
	.dc.l	MULW_HL_HL_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $e8
	.dc.l	MULB_A_L_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $ef

	.dc.l	none_ED_h			* $f0
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	MULW_HL_SP_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $f8
	.dc.l	MULB_A_A_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h
	.dc.l	none_ED_h			* $ff

none_ED_h:
	lea.l	8(a5),a5
none_ED:				* おかしな命令を実行しました
	move.w	d0,d1
	lsr.w	#4,d0
	lea.l	HEX,a0
	move.b	(a0,d0.w),number_ed+0
	andi.w	#$0f,d1
	move.b	(a0,d1.w),number_ed+1

	pea.l	errms_ed
	DOS	__PRINT
	lea.l	4(sp),sp
	move.b	#$ff,d0
	jmp	(a6)

errms_ed:
	.dc.b	'おかしな命令を実行しました。0xed,0x'
number_ed:
	.dc.b	'00'
	.dc.b	0x0d,0x0a,0x00

	.even

*
*	６８０ｘ０ネイティブルーチンの呼びだし
*
*
	.dc.w	0			* サイクル数
	.dc.w	2-1			* 命令語長-1
other:					* ＭＳ用に拡張した命令
	; この時点の d0 には、0x00-0x3f の値に -0x40 した値が入っている
	move.b	d0,-(sp)
	move.l	native_jpt_add,d1
	beq	none_ED			* ネイティブルーチンがセットされていなければ未定義エラー
	;	AF レジスタをセット
@@:
	move.b	d4,a(a3)
	move.b	d6,f(a3)

	move.b	(sp)+,d0
	add.w	#$20,d0			* 0x20を足してプラスの場合、つまり元々0x20-0x3fの時は CALL
	bpl	CALL68

JP68:	add.w	#$20,d0			* 0x20を足すと、元々の0x00-0x1fの値が得られる
	lsl.w	#8,d0			* d0 = d0 * 256
	move.b	(a4)+,d0		* d0 = ルーチン番号 (0x0000-0x1fff)
	addq.w	#1,d7			* 0 になったらページ境界
	bne	@f
	PC_page_inc
@@:
	lsl.w	#2,d0			* d0 = d0 * 4
	movea.l	native_jpt_add,a1
	move.l	0(a1,d0.w),a1

	movem.l	d4-d6/a3-a4,-(sp)
	jsr	(a1)
	movem.l	(sp)+,d4-d6/a3-a4

	move.w	d0,d7			* d0.w に戻り先の番地が入っている
	PC_page_set
	bra	next_jp_call_68

CALL68:	add.w	#$20,d0			* d0には、元々の0x20-0x3fが入っている
	lsl.w	#8,d0			* d0 = d0 * 256
	move.b	(a4)+,d0		* d0 = ルーチン番号 (0x2000-0x3fff)
	addq.w	#1,d7			* 0 になったらページ境界
	bne	@f
	PC_page_inc
@@:
	lsl.w	#2,d0			* d0 = d0 * 4
	lea.l	native_jpt_add,a1
	move.l	0(a1,d0.w),a1

	movem.l	d4-d6/a3-a4,-(sp)
	jsr	(a1)
	movem.l	(sp)+,d4-d6/a3-a4

*
*	フラグの描き戻しなどの後処理
*
next_jp_call_68:
	move.b	a(a3),d4		* Aレジスタをセット
	move.b	f(a3),d6		* フラグのロード
	andi.l	#000_00000000_11111111,d6	* フラグのダーティビットをクリア
	jmp	(a6)
	


*	------ ＲＬＤ,ＲＲＤ ------
;
; RLD, RRD の挙動は以下の通り
; * S : 結果の最上位ビット
; * Z : 結果が0なら1。それ以外の時は0
; * F5: 結果のAレジスタのbit5
; * H : 0
; * F3: 結果のAレジスタのbit3
; * PV: 結果のAレジスタのパリティ
; * N : 0
; * C : 変化しない
RLD_lHLl_h:
	lea.l	18(a5),a5
RLD_lHLl:
	move.w	hl(a3),d0		* d0.w = |00|00|(H|L)|
	read_mem_8	rd8f36,rd8s36,rd8e36
	andi.w	#%00000000_11111111,d0

	lsl.w	#4,d0			* d0.w = |00|(H|L)|00|
	move.b	d4,d1
	andi.w 	#%00000000_00001111,d1
	or.b	d0,d1			* d1.w = |00|(H|L)|Al|

	andi.b	#%11110000,d4		* d4.b = |Ah|00|
	lsr.w	#8,d0			* d0.b = |00|(H|
	or.b	d0,d4			* d4.b = |Ah|(H|

	move.w	hl(a3),d0
	write_mem_8	wr8f22,wr8s22,wr8e22

* S,Z,F5,F3,P/V は結果の A だけから決まる。H=0、N=0、C は変化しない
	move.b	szp53p(a3,d4.w),d3		* S,Z,F5,F3,P/V を一度に引く
	andi.b	#%00000001,d6		* Ｃ だけ残す
	or.b	d3,d6
	jmp	(a6)

RRD_lHLl_h:
	lea.l	18(a5),a5
RRD_lHLl:
	move.w	hl(a3),d0		* d0.w = |??|??|(H|L)|
	read_mem_8	rd8f37,rd8s37,rd8e37

	move.b	d4,d1
	lsl.w	#8,d1			* d1.w = |Ah|Al|00|00|
	move.b	d0,d1			* d1.w = |Ah|Al|(H|L)|

	lsr.w	#4,d1			* d1.w = |00|Ah|Al|(H|
	andi.w 	#%00000000_00001111,d0	
					* d0.w = |00|00|00|L)| 
	andi.b	#%11110000,d4		* d4.b =       |Ah|00|
	or.b	d0,d4			* d4.b =       |Ah|L)|

	move.w	hl(a3),d0
	write_mem_8	wr8f23,wr8s23,wr8e23

* S,Z,F5,F3,P/V は結果の A だけから決まる。H=0、N=0、C は変化しない
	move.b	szp53p(a3,d4.w),d3		* S,Z,F5,F3,P/V を一度に引く
	andi.b	#%00000001,d6		* Ｃ だけ残す
	or.b	d3,d6

	jmp	(a6)

*	------ ＩＭ ------
IM_0_h:
	lea.l	8(a5),a5
IM_0:	move.b	#0,interrupt_mode
	jmp	(a6)

IM_1_h:
	lea.l	8(a5),a5
IM_1:	move.b	#1,interrupt_mode
	jmp	(a6)

IM_2_h:
	lea.l	8(a5),a5
IM_2:	move.b	#2,interrupt_mode
	jmp	(a6)

*	------ ＬＤ ＸＸ,(nn) ------
LD_BC_lnnl_h:
	lea.l	20(a5),a5
	addq.w	#2,d7			* オペランドのぶん PC を進める
	addq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	LD_BC_lnnl_h9
	PC_page_inc
LD_BC_lnnl_h9:
LD_BC_lnnl:
	* オペランド列からnnを取り出す
	move.b	-1(a4),d1		* オペランドの上位バイト
	ror.w	#8,d1
	move.b	-2(a4),d1		* オペランドの下位バイト
	move.w	d1,d0			* d0.w = nn
	read_mem_16	rd16f7,rd16s7,rd16e7
	move.w	d0,bc(a3)
	jmp	(a6)

LD_DE_lnnl_h:
	lea.l	20(a5),a5
	addq.w	#2,d7			* オペランドのぶん PC を進める
	addq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	LD_DE_lnnl_h9
	PC_page_inc
LD_DE_lnnl_h9:
LD_DE_lnnl:
	* オペランド列からnnを取り出す
	move.b	-1(a4),d1		* オペランドの上位バイト
	ror.w	#8,d1
	move.b	-2(a4),d1		* オペランドの下位バイト
	move.w	d1,d0			* d0.w = nn
	read_mem_16	rd16f8,rd16s8,rd16e8
	move.w	d0,de(a3)
	jmp	(a6)

LD_HL_lnnl_2_h:
	lea.l	20(a5),a5
	addq.w	#2,d7			* オペランドのぶん PC を進める
	addq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	LD_HL_lnnl_2_h9
	PC_page_inc
LD_HL_lnnl_2_h9:
