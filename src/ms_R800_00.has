	jmp	(a6)

*	------ ＲＥＴ ------
RET_h:
	lea.l	10(a5),a5
RET:	move.w	sp_(a3),d0
	read_mem_16	rd16f4,rd16s4,rd16e4
	addq.w	#2,sp_(a3)
	cmp.w	interrupt_return,d0	* 割り込み発生時にセットした戻り先アドレスに戻ったか？
	bne	@f
	bsr	int_ret_notify		* 割り込みから戻ったことを知らせる
@@:	move.w	d0,d7
	PC_page_set
	jmp	(a6)

RET_C_h:
	lea.l	11(a5),a5
RET_C:
@@:
	btst.l	#0,d6		* Ｃｙフラグをテスト
	bne	RET		* Ｃｙが１ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)
	
RET_NC_h:
	lea.l	11(a5),a5
RET_NC:
@@:
	btst.l	#0,d6		* Ｃｙフラグをテスト
	beq	RET		* Ｃｙが０ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)

RET_Z_h:
	lea.l	11(a5),a5
RET_Z:
@@:
	btst.l	#6,d6		* Zフラグをテスト
	bne	RET		* Zが1ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)

RET_NZ_h:
	lea.l	11(a5),a5
RET_NZ:
@@:
	btst.l	#6,d6		* Zフラグをテスト
	beq	RET		* Zが0ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)

RET_M_h:
	lea.l	11(a5),a5
RET_M:
@@:
	btst.l	#7,d6		* Sフラグをテスト
	bne	RET		* Sが1ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)

RET_P_h:
	lea.l	11(a5),a5
RET_P:
@@:
	btst.l	#7,d6		* Sフラグをテスト
	beq	RET		* Sが0ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)

RET_PE_h:
	lea.l	11(a5),a5
RET_PE:
	btst.l	#2,d6		* PVフラグをテスト
	bne	RET		* PVが偶数(=1)ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)

RET_PO_h:
	lea.l	11(a5),a5
RET_PO:
	btst.l	#2,d6		* PVフラグをテスト
	beq	RET		* PVが奇数(=0)ならリターン
	;　条件不成立時はサイクル数が5なので、6引く
	subq.l	#6,a5
	jmp	(a6)

*	------ ＤＪＮＺ ------
DJNZ_h:
	lea.l	13(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	DJNZ(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	DJNZ_o
	lea.l	DJNZ(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
DJNZ_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
DJNZ:	subq.b	#1,b(a3)	* b = b-1
	bne	JR		* b != 0 ならブランチ
	;　ループしない時はサイクル数が8なので、5引く
	addq.w	#1,a4			* 分岐しない時はオペランドを読まないので進めておく
	subq.l	#5,a5
	jmp	(a6)


*	------ ＰＵＳＨ  ＰＯＰ ------
;---------------------------------------------------------------------------------------
PUSH_XX	macro	lbl_f, lbl_s, lbl_e
	subq.w	#2,sp_(a3)		; スタックを2バイト減らす
	move.w	sp_(a3),d0
	move.w	target_16(a3),d1
	write_mem_16	lbl_f,lbl_s,lbl_e	; スタックに書き込む
	endm
;---------------------------------------------------------------------------------------

;---------------------------------------------------------------------------------------
POP_XX	macro	lbl_f, lbl_s, lbl_e
	move.w	sp_(a3),d0		; スタックから読み込む
	read_mem_16	lbl_f,lbl_s,lbl_e
	addq.w	#2,sp_(a3)		; スタックを2バイト増やす
	endm
;---------------------------------------------------------------------------------------

PUSH_AF_h:
	lea.l	11(a5),a5
PUSH_AF:
@@:
	move.b	d4,d1
	lsl.w	#8,d1
	move.b	d6,d1
	move.w	d1,target_16(a3)
	PUSH_XX	pu1f,pu1s,pu1e
	jmp	(a6)

POP_AF_h:
	lea.l	10(a5),a5
POP_AF:
	POP_XX	po1f,po1s,po1e
	move.w	d0,d4			; Aレジスタのロード
	lsr.w	#8,d4			; 位置合わせ
	move.b	d0,d6			; フラグのロード
	jmp	(a6)

PUSH_BC_h:
	lea.l	11(a5),a5
PUSH_BC:
	move.w	bc(a3),target_16(a3)
	PUSH_XX	pu2f,pu2s,pu2e
	jmp	(a6)

POP_BC_h:
	lea.l	10(a5),a5
POP_BC:
	POP_XX	po2f,po2s,po2e
	move.w	d0,bc(a3)
	jmp	(a6)

PUSH_DE_h:
	lea.l	11(a5),a5
PUSH_DE:
	move.w	de(a3),target_16(a3)
	PUSH_XX	pu3f,pu3s,pu3e
	jmp	(a6)

POP_DE_h:
	lea.l	10(a5),a5
POP_DE:
	POP_XX	po3f,po3s,po3e
	move.w	d0,de(a3)
	jmp	(a6)

PUSH_HL_h:
	lea.l	11(a5),a5
PUSH_HL:
	move.w	hl(a3),target_16(a3)
	PUSH_XX	pu4f,pu4s,pu4e
	jmp	(a6)

POP_HL_h:
	lea.l	10(a5),a5
POP_HL:
	POP_XX	po4f,po4s,po4e
	move.w	d0,hl(a3)
	jmp	(a6)

*	------ ＥＸ ------
EX_lSPl_HL_h:
	lea.l	19(a5),a5
EX_lSPl_HL:
	move.w	sp_(a3),d0
	read_mem_16	rd16f6,rd16s6,rd16e6
	move.w	hl(a3),d1
	move.w	d0,hl(a3)
	move.w	sp_(a3),d0
	write_mem_16	wr16f5,wr16s5,wr16e5
	jmp	(a6)

EXX_h:
	addq.w	#4,a5
EXX:	move.l	bc(a3),d0		* d0 = bc, de
	move.w	hl(a3),d1

	move.l	bc_(a3),bc(a3)
	move.w	hl_(a3),hl(a3)

	move.l	d0,bc_(a3)
	move.w	d1,hl_(a3)

	jmp	(a6)

EX_DE_HL_h:
	addq.w	#4,a5
EX_DE_HL:
	move.l	de(a3),d0
	swap	d0
	move.l	d0,de(a3)
	jmp	(a6)

EX_AF_AFd_h:
	addq.w	#4,a5
EX_AF_AFd:
	move.b	d4,d1
	move.b	a_(a3),d4
	move.b	d1,a_(a3)
@@:
	move.b	d6,d1
	move.b	f_(a3),d6
	move.b	d1,f_(a3)

	jmp	(a6)


; CCFの挙動は以下の通り
; * S : 変化しない
; * Z : 変化しない
; * F5: A レジスタの bit5
; * H : 元のCフラグの値
; * F3: A レジスタの bit3
; * PV: 変化しない
; * N : 0
; * C : Cの反転
CCF_h:
	addq.w	#4,a5
* CCF は元の C が要る。H と C だけ確定させれば足りる（全フラグは不要）
CCF:
@@:
	move.b	d6,d0			* 元のCフラグの値を保存
	andi.b	#%00000001,d0		* Cフラグのみを取得
	lsl.b	#4,d0			* C→HCの位置に移動
	move.b	d4,d1			* Aレジスタの値を取得
	andi.b	#%00101000,d1		* AレジスタからF5,F3を取得
	or.b	d1,d0			* F5,F3を混ぜる
	andi.b	#%11000101,d6		* S,Z,P/V,Ｃ だけ残す
	bchg	#0,d6			* Cフラグを反転
	or.b	d0,d6			* F5,H,F3を反映
	jmp	(a6)	

; SCFの挙動は以下の通り
; * S : 変化しない
; * Z : 変化しない
; * F5: A レジスタの bit5
; * H : 0
; * F3: A レジスタの bit3
; * PV: 変化しない
; * N : 0
; * C : 1
SCF_h:
	addq.w	#4,a5
SCF:	move.b	d4,d0			* Aレジスタの値を取得
	andi.b	#%00101000,d0		* AレジスタからF5,F3を取得
	ori.b	#%00000001,d0		* C=1
* S,Z,PV は変わらないのでダーティビットごと残す。全フラグの強制確定が要らない
	andi.b	#%11000100,d6		* S,Z,P/V だけ残す
	or.b	d0,d6			* F5,F3,C を反映
	;
	jmp	(a6)

; CPLの挙動は以下の通り
; * A : 反転
; * S : 変化しない
; * Z : 変化しない
; * F5: 反転後のA レジスタの bit5
; * H : 1
; * F3: 反転後のA レジスタの bit3
; * PV: 変化しない
; * N : 1
; * C : 変化しない
CPL_h:
	addq.w	#4,a5
CPL:	eori.b	#$ff,d4			* Aレジスタの値を反転
	move.b	d4,d0			* 反転後のAレジスタの値を取得
	andi.b	#%00101000,d0		* AレジスタからF5,F3を取得
* S,Z,PV,C は変わらないのでダーティビットごと残す
	andi.b	#%11000101,d6		* S,Z,P/V,Ｃ だけ残す
	ori.b	#%00010010,d6		* N,Hを1に
	or.b	d0,d6			* F5,F3を反映
	;
	jmp	(a6)

DI_h:
	addq.w	#4,a5
DI:	move.b	#0,interrupt_enable
	jmp	(a6)

;
; EIの挙動として、「次の命令までは割り込みがかからずに実行される」というものがあります。
; 割り込み処理ルーチンの最後は通常以下のような並びになっていますが、
;	EI
;	RETI
; この仕様のおかげで、割り込みが許可されるのは RETIによって元の処理に戻った後になります。
; これを実現するためには、EIの命令の直後であることをなんらかのフラグで覚えておく必要があります。
; 今は、「最後に実行したOPコード」を last_opcodeに覚えておくようにして対応しています。
EI_h:
	addq.w	#4,a5
EI:	move.b	#1,interrupt_enable	* 割り込みを許可
	move.l	emu_counter,ei_at	* 「直前の命令は EI だった」の印
	move.b	#1,ei_pending
	cmpi.b	#0,ms_cpu_int
	beq	1f
	move.w	#2,cpu_yield		* 外部割り込み要求がある場合は2サイクル後に割り込み判定をかける
	bsr	force_yield_check	* 次の命令で中断確認へ落とす
	bra	2f
1:	tst.b	ei_force_always
	beq	@f
	bsr	force_yield_check	* 次の命令で必ず中断確認へ落とす
*	高速版は入口そのものを書き換えるため、そのまま帰ると 1 命令も実行せずに
*	中断確認へ落ちてしまう。EI の次の 1 命令は必ず実行されなければならない。
2:	tst.b	cpu_fast_enabled
	beq	@f
	bra	cpu_exec_core		* 書き換え語を踏まずに 1 命令実行する
@@:	jmp	(a6)

;---------------------------------------------------------------------------------------
RST_XXH	macro	value, lbl_f, lbl_s, lbl_e
	;move.w	value,d0
	;bsr	print_debug_rst
	move.l	d7,d1
	andi.w	#PAGEADDRMASK,d1	* 位置は -8192 基準なので上位 3bit を落とす
	lsr.l	#3,d7			* d7 = ppp000??_????????
	andi.w	#%11100000_00000000,d7	* d7 = ppp00000_00000000
	or.w	d7,d1			* d1 = PC (R800) = next instruction
	subq.w	#2,sp_(a3)		* PUSH	
	move.w	sp_(a3),d0
	write_mem_16	lbl_f,lbl_s,lbl_e
	move.w	value,d7
	PC_page_set
	endm
;---------------------------------------------------------------------------------------

RST_00H_h:
	lea.l	11(a5),a5
RST_00H:
	RST_XXH	#$0000,rf1s,rs1s,rs1e
	jmp	(a6)

RST_08H_h:
	lea.l	11(a5),a5
RST_08H:
	RST_XXH	#$0008,rf2s,rs2s,rs2e
	jmp	(a6)

RST_10H_h:
	lea.l	11(a5),a5
RST_10H:
	RST_XXH	#$0010,rf3s,rs3s,rs3e
	jmp	(a6)

RST_18H_h:
	lea.l	11(a5),a5
RST_18H:
	RST_XXH	#$0018,rf4s,rs4s,rs4e
	jmp	(a6)

RST_20H_h:
	lea.l	11(a5),a5
RST_20H:
	RST_XXH	#$0020,rf5s,rs5s,rs5e
	jmp	(a6)

RST_28H_h:
	lea.l	11(a5),a5
RST_28H:
	RST_XXH	#$0028,rf6s,rs6s,rs6e
	jmp	(a6)

RST_30H_h:
	lea.l	11(a5),a5
RST_30H:
	RST_XXH	#$0030,rf7s,rs7s,rs7e
	jmp	(a6)

RST_38H_h:
	lea.l	11(a5),a5
RST_38H:
	RST_XXH	#$0038,rf8s,rs8s,rs8e
	jmp	(a6)

print_debug_rst:
	cmp.w	#MS_LOG_TRACE,debug_log_level
	bge	@f				* ログレベルが TRACE 以上の時
	jmp	(a6)
@@:	movem.l	d0-d3/a0-a3,-(sp)
	move.w	d0,d1
	lsr.w	#4,d0
	lea.l	HEX,a0
	move.b	(a0,d0.w),debug_rst_number+0
	andi.w	#$0f,d1
	move.b	(a0,d1.w),debug_rst_number+1

	pea.l	debug_rst_msg
	DOS	__PRINT
	lea.l	4(sp),sp
	movem.l	(sp)+,d0-d3/a0-a3
	jmp	(a6)

	.data

debug_rst_msg:
	.dc.b	'RST 0x'
debug_rst_number:
	.dc.b	'00'
debug_rst_msg2:
	.dc.b	'が呼ばれました'
	.dc.b	0x0d,0x0a,0x00

	.text

*	------ ＲＬＣＡ ------
*	------ ＲＬＡ ------
*	------ ＲＲＣＡ ------
*	------ ＲＲＡ ------

;---------------------------------------------------------------------------------------
RXXA	macro	isLeft, isCircular
	.if isCircular=0
	; キャリーを経由する形だけ、演算前の C が要る
@@:
	.endif
	.if isCircular
	  ; キャリーを経由せずにローテート
	  .if isLeft
	    rol.b	#1,d4
	  .else
	    ror.b	#1,d4
	  .endif
	.else
	  ; キャリーを経由してローテート
	  ; Xフラグにキャリーをセットし、rox命令を使う
	  btst.l	#0,d6
	  bne	1f
	  andi.b	#%11101111,ccr	; Xフラグをリセット
	  bra	2f
1:  	  ori.b		#%00010000,ccr	; Xフラグをセット
2:
	  .if isLeft
	    roxl.b	#1,d4
	  .else
	    roxr.b	#1,d4
	  .endif
	.endif
	; S・Z・P/V は変化しないので残す。
	; F5・F3 は結果から、C ははみ出したビットから組み立てる。
	scs	d1			* C（Scc は CCR を変えない）
	andi.b	#%00000001,d1
	move.b	d4,d3			* 結果
	andi.b	#%00101000,d3		* F5,F3
	or.b	d3,d1
	andi.b	#%11000100,d6		* S,Z,P/V だけ残す
	or.b	d1,d6
	endm
;---------------------------------------------------------------------------------------

RLCA_h:
	addq.w	#4,a5
RLCA:	RXXA	1, 1
	jmp	(a6)

RRCA_h:
	addq.w	#4,a5
RRCA:	RXXA	0, 1
	jmp	(a6)

RLA_h:
	addq.w	#4,a5
RLA:	RXXA	1, 0
	jmp	(a6)

RRA_h:
	addq.w	#4,a5
RRA:	RXXA	0, 0
	jmp	(a6)

*	------ ＨＡＬＴ ------
HALT_h:
	addq.w	#4,a5
HALT:
	; pea.l	halt_msg
	; DOS	__PRINT
	; lea.l	4(sp),sp
9:	move.l	cpu_sub_emu_yield,d0	* X68000側の割り込みがかかるまで待機
	beq	9b
	; 一時的に割り込み禁止
	move.w	sr,d0
	move.w	d0,-(sp)
	or.w	#%00000111_00000000,d0
	move.w	d0,sr

	cmpi.b	#0,interrupt_enable
	beq	8f		* DIなら割り込まない(永遠に出られない？ NMIなら出られるようにすべき？)
	; あらためて割り込み要求端子の値(ms_cpu_int)を見て割り込み要求があるかどうかを見る
	cmpi.b	#0,ms_cpu_int
	beq	8f
	bsr	INT		* 割り込みがかかったので割り込み処理を実施
	move.w	#0,d0
	bsr	add_interrupt_history
	move.l	emu_counter,emu_counter_latch	* この時点の値を覚えておく
	move.w	(sp)+,sr	* ここで割り込み許可に戻す
	jmp	(a6)			* HALT命令終了

8:	; HALT中でも特殊キーの処理を回したいので、yieldチェック
	add.l	#1,emu_counter
	bsr	get_emu_yield_func
	cmpi.l	#0,d0
	bne	@f
	move.w	(sp)+,sr		* ここで割り込み許可に戻す
	bra	9b

@@:	; タイミングが来たのでC側の処理を呼び出す
	movea.l	d0,a0			* 処理ルーチンのアドレス
	move.l	emu_counter,d0
	sub.l	emu_counter_latch,d0
	move.w	(sp)+,sr		* ここで割り込み許可に戻す
	movem.l	d1-d7/a0-a6,-(sp)
	move.l	d0,-(sp)		* カウンタ差分を引数として渡す
	move.l	d7,-(sp)		* PCを引数として渡す
	jsr	(a0)
	lea.l	8(sp),sp
	movem.l	(sp)+,d1-d7/a0-a6
	move.l	d0,d0
	beq	9b
	; 0以外が帰ってきたのでエミュレータを終了
	; ハンドラは戻り番地を積まれていないので、SP はそのまま
	bra	emu_end

halt_msg:
	.dc.b	'HALT',0x0d,0x0a,0x00,0x00

	.even

*
*	＄ＣＢライン命令
*
*	  c    b   
*	%1100_1011_cccc_crrr
*
*		ccccc ・ 00000	RLC
*			 00001	RRC
*			 00010	RL
*			 00011	RR
*			 00100	SLA
*			 00101	SRA
*			 00110	SLI		* undifined instruction
*			 00111	SRL
*
*			 01000
*			   |	BIT 0～7
*			 01111
*
*			 10000
*			   |	RES 0～7
*			 10111
*
*			 11000
*			   |	SET 0～7
*			 11111
*
*		rrr ・・ 000 - b
*			 001 - c
*			 010 - d
*			 011 - e
*			 100 - h
*			 101 - l
*			 110 - (hl)
*			 111 - a
*
*
;	CBラインのSET命令はほとんどサイクル数=8
CB_h:
	addq.w	#8,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	CB(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	CB_o
	lea.l	CB(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
CB_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
CB:	* オペランド列から第二オペコードを取り出す
	move.b	(a4)+,d0
@@:
	bclr.l	#7,d0			* ００Ｈ～７ＦＨの命令かどうか
	beq	case2			* そうなら case2へ
case1:
	bclr.l	#6,d0
	beq	RES			* ＲＥＳ命令

;	------ ＳＥＴ ------
SET:	move.b	d0,d1
	andi.w	#%00000000_00111000,d0		* BIT_n_? の n を d0にロード
	lsr.w	#3,d0

	andi.w	#%00000000_00000111,d1		* レジスタの値をロード
	addq.w	#2,d1
	bclr.l	#3,d1
	bne	SET_aorhl			* SET A, SET (HL)の時
	bset.b	d0,a(a3,d1.w)			* レジスタの nビット目をセット
	jmp	(a6)

SET_aorhl:
	tst.w	d1
	beq	set_lhll
	bset.l	d0,d4				* A レジスタの nビット目をセット
	jmp	(a6)
set_lhll
	; (HL) の場合はサイクル数が15なので7を足す
	addq.l	#7,a5
	move.w	d0,-(sp)
	move.w	hl(a3),d0
	read_mem_8	rd8f25,rd8s25,rd8e25
	move.w	(sp)+,d1
	bset.l	d1,d0				* (HL)の nビット目をセット
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f12,wr8s12,wr8e12
	jmp	(a6)

;	------ ＲＥＳ ------
RES:	move.b	d0,d1
	andi.w	#%00000000_00111000,d0		* BIT_n_? の n を d0にロード
	lsr.w	#3,d0

	andi.w	#%00000000_00000111,d1		* レジスタの値をロード
	addq.w	#2,d1
	bclr.l	#3,d1
	bne	RES_aorhl			* RES A, RES (HL)の時
	bclr.b	d0,a(a3,d1.w)			* レジスタの nビット目をクリア
	jmp	(a6)
RES_aorhl:
	tst.w	d1
	beq	RES_lhll
	bclr.l	d0,d4				* A レジスタの nビット目をクリア
	jmp	(a6)
RES_lhll
	; (HL) の場合はサイクル数が15なので7を足す
	addq.l	#7,a5
	move.w	d0,-(sp)
	move.w	hl(a3),d0
	read_mem_8	rd8f26,rd8s26,rd8e26
	move.w	(sp)+,d1
	bclr.l	d1,d0				* (HL)の nビット目をセット
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f13,wr8s13,wr8e13
	jmp	(a6)

;	------ CASE2 ------
case2:
	bclr.l	#6,d0
	beq	rot_sft			* ローテート、シフト関係の命令

;	------ ＢＩＴ ------
; ＢＩＴ命令の挙動は以下の通り
; * S : BIT 7,?の時だけ、対象のbit7が1なら1。それ以外の時は0
; * Z : 対象のbitが0なら1。それ以外の時は0
; * F5: 対象のbit5
; * H : 1
; * F3: 対象のbit3
; * PV: Zフラグと同じ
; * N : 0
; * C : 変化しない
; ただし、対象が(HL)の場合だけ、F5,F3は内部のWZレジスタの上位8bitの値(bit13,11)が入るらしい
BIT:	move.w	d0,-(sp)
@@:
	andi.b	#%00000001,d6		* Ｃ だけ残す
	ori.b	#%00010000,d6		* H をセット
	move.w	(sp)+,d0
	move.w	d0,d1
	andi.w	#%00000000_00111000,d0	* BIT_n_? の n を d0にロード
	lsr.w	#3,d0
	moveq.l	#1,d2
	lsl	d0,d2			* 対象位置のビットをセット

	andi.w	#%00000000_00000111,d1
	addq.w	#2,d1
	andi.w	#%00000111,d1
	cmpi.w	#1,d1
	beq	BIT_a			* BIT Aの時
	blt	BIT_lhll		* BIT (HL)の時
	move.b	a(a3,d1.w),d0		* B,C,D,E,H,Lのいずれかのレジスタの値をロード
	move.b	d0,d1			* F5,F3に反映させるレジスタ値をd1にロード
	bra	@f
BIT_a:
	move.b	d4,d0			* Aレジスタの値をロード
	move.b	d0,d1			* F5,F3に反映させるレジスタ値をd1にロード
	bra	@f
BIT_lhll:
	; (HL) の場合はサイクル数が12なので4を足す
	addq.l	#4,a5
	move.w	d2,-(sp)
	move.w	hl(a3),d0
	read_mem_8	rd8f27,rd8s27,rd8e27
	move.w	(sp)+,d2
	move.b	w(a3),d1		* F5,F3に反映させるレジスタ値をd1にロード  (hl)の時は wレジスタが使われるらしい
@@:
	andi.b	#%00101000,d1		* F5,F3を取得
	or.b	d1,d6			* F5,F3をFレジスタに反映
	and.b	d2,d0			* レジスタの nビット目をテストするためにマスク
	bne	1f
	ori.b	#%01000100,d6		* Z,P/V をセット
1:	andi.b	#%10000000,d0		* bit7のみ残す
	or.b	d0,d6			* bit7を Sフラグに反映
	jmp	(a6)


;	------ ローテート,シフト ------
rot_sft:
	andi.w	#%0000_0000_0011_1111,d0	* 命令にジャンプ
	add.w	d0,d0
	move.w	Rot_Sft_JPT(pc,d0.w),d0
	jmp	Rot_Sft_JPT(pc,d0.w)

Rot_Sft_JPT:
	.dc.w	RLC_B-Rot_Sft_JPT	* $00
	.dc.w	RLC_C-Rot_Sft_JPT
	.dc.w	RLC_D-Rot_Sft_JPT
	.dc.w	RLC_E-Rot_Sft_JPT
	.dc.w	RLC_H-Rot_Sft_JPT
	.dc.w	RLC_L-Rot_Sft_JPT
	.dc.w	RLC_lHLl-Rot_Sft_JPT
	.dc.w	RLC_A-Rot_Sft_JPT
	.dc.w	RRC_B-Rot_Sft_JPT	* $08
	.dc.w	RRC_C-Rot_Sft_JPT
	.dc.w	RRC_D-Rot_Sft_JPT
	.dc.w	RRC_E-Rot_Sft_JPT
	.dc.w	RRC_H-Rot_Sft_JPT
	.dc.w	RRC_L-Rot_Sft_JPT
	.dc.w	RRC_lHLl-Rot_Sft_JPT
	.dc.w	RRC_A-Rot_Sft_JPT	* $0f

	.dc.w	RL_B-Rot_Sft_JPT	* $10
	.dc.w	RL_C-Rot_Sft_JPT
	.dc.w	RL_D-Rot_Sft_JPT
	.dc.w	RL_E-Rot_Sft_JPT
	.dc.w	RL_H-Rot_Sft_JPT
	.dc.w	RL_L-Rot_Sft_JPT
	.dc.w	RL_lHLl-Rot_Sft_JPT
	.dc.w	RL_A-Rot_Sft_JPT
	.dc.w	RR_B-Rot_Sft_JPT	* $18
	.dc.w	RR_C-Rot_Sft_JPT
	.dc.w	RR_D-Rot_Sft_JPT
	.dc.w	RR_E-Rot_Sft_JPT
	.dc.w	RR_H-Rot_Sft_JPT
	.dc.w	RR_L-Rot_Sft_JPT
	.dc.w	RR_lHLl-Rot_Sft_JPT
	.dc.w	RR_A-Rot_Sft_JPT	* $1f

	.dc.w	SLA_B-Rot_Sft_JPT	* $20
	.dc.w	SLA_C-Rot_Sft_JPT
	.dc.w	SLA_D-Rot_Sft_JPT
	.dc.w	SLA_E-Rot_Sft_JPT
	.dc.w	SLA_H-Rot_Sft_JPT
	.dc.w	SLA_L-Rot_Sft_JPT
	.dc.w	SLA_lHLl-Rot_Sft_JPT
	.dc.w	SLA_A-Rot_Sft_JPT
	.dc.w	SRA_B-Rot_Sft_JPT	* $28
	.dc.w	SRA_C-Rot_Sft_JPT
	.dc.w	SRA_D-Rot_Sft_JPT
	.dc.w	SRA_E-Rot_Sft_JPT
	.dc.w	SRA_H-Rot_Sft_JPT
	.dc.w	SRA_L-Rot_Sft_JPT
	.dc.w	SRA_lHLl-Rot_Sft_JPT
	.dc.w	SRA_A-Rot_Sft_JPT	* $2f

	.dc.w	SLI_B-Rot_Sft_JPT	* $30	SLI 未定義命令(Shift Left Increment)
	.dc.w	SLI_C-Rot_Sft_JPT	*	ビット０に１が入る左シフト
	.dc.w	SLI_D-Rot_Sft_JPT
	.dc.w	SLI_E-Rot_Sft_JPT
	.dc.w	SLI_H-Rot_Sft_JPT
	.dc.w	SLI_L-Rot_Sft_JPT
	.dc.w	SLI_lHLl-Rot_Sft_JPT
	.dc.w	SLI_A-Rot_Sft_JPT
	.dc.w	SRL_B-Rot_Sft_JPT	* $38
	.dc.w	SRL_C-Rot_Sft_JPT
	.dc.w	SRL_D-Rot_Sft_JPT
	.dc.w	SRL_E-Rot_Sft_JPT
	.dc.w	SRL_H-Rot_Sft_JPT
	.dc.w	SRL_L-Rot_Sft_JPT
	.dc.w	SRL_lHLl-Rot_Sft_JPT
	.dc.w	SRL_A-Rot_Sft_JPT	* $3f

;
; RLC, RRC, RL, RR のローテーション(最後にAがついてない方)をまとめたマクロ
;
; フラグの挙動は以下の通り
; * S : 結果の最上位ビット
; * Z : 結果が0なら1。それ以外の時は0
; * F5: 結果のbit5
; * H : 0
; * F3: 結果のbit3
; * PV: 結果のパリティ
; * N : 0
; * C : ローテーションによってはみ出た値
;
RXX_	macro	isLeft, isCircular
	.if isCircular=0
	; キャリーを経由する形だけ、演算前の C が要る
@@:
	.endif
	move.b	target_8(a3),d0
	.if isCircular
	  ; キャリーを経由せずにローテート
	  .if isLeft
	    rol.b	#1,d0
	  .else
	    ror.b	#1,d0
	  .endif
	.else
	  ; キャリーを経由してローテート
	  ; Xフラグにキャリーをセットし、rox命令を使う
	  btst.l	#0,d6
	  bne	1f
	  andi.b	#%11101111,ccr	; Xフラグをリセット
	  bra	2f
1:  	  ori.b		#%00010000,ccr	; Xフラグをセット
2:
	  .if isLeft
	    roxl.b	#1,d0
	  .else
	    roxr.b	#1,d0
	  .endif
	.endif
	; はみ出したビットが C。S,Z,F5,F3,P/V は結果から表 1 回で引ける。H=0、N=0。
	scs	d1			* C（Scc は CCR を変えない）
	andi.b	#%00000001,d1
	moveq.l	#0,d3
	move.b	d0,d3			* 結果
	move.b	szp53p(a3,d3.w),d3		* S,Z,F5,F3,P/V を一度に引く
	or.b	d3,d1
	moveq.l	#0,d6
	move.b	d1,d6
	endm

*	------ ＲＬＣ ------
RLC_A:	move.b	d4,target_8(a3)
	RXX_	1, 1
	move.b	d0,d4
	jmp	(a6)
RLC_B:	move.b	b(a3),target_8(a3)
	RXX_	1, 1
	move.b	d0,b(a3)
	jmp	(a6)
RLC_C:	move.b	c(a3),target_8(a3)
	RXX_	1, 1
	move.b	d0,c(a3)
	jmp	(a6)
RLC_D:	move.b	d(a3),target_8(a3)
	RXX_	1, 1
	move.b	d0,d(a3)
	jmp	(a6)
RLC_E:	move.b	e(a3),target_8(a3)
	RXX_	1, 1
	move.b	d0,e(a3)
	jmp	(a6)
RLC_H:	move.b	h(a3),target_8(a3)
	RXX_	1, 1
	move.b	d0,h(a3)
	jmp	(a6)
RLC_L:	move.b	l(a3),target_8(a3)
	RXX_	1, 1
	move.b	d0,l(a3)
	jmp	(a6)
RLC_lHLl:
	; (HL) の場合はサイクル数が15なので7を足す
	addq.l	#7,a5
	move.w	hl(a3),d0
	read_mem_8	rd8f28,rd8s28,rd8e28
	move.b	d0,target_8(a3)
	RXX_	1, 1
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f14,wr8s14,wr8e14
	jmp	(a6)

*	------ ＲＲＣ ------
RRC_A:	move.b	d4,target_8(a3)
	RXX_	0, 1
	move.b	d0,d4
	jmp	(a6)
RRC_B:	move.b	b(a3),target_8(a3)
	RXX_	0, 1
	move.b	d0,b(a3)
	jmp	(a6)
RRC_C:	move.b	c(a3),target_8(a3)
	RXX_	0, 1
	move.b	d0,c(a3)
	jmp	(a6)
RRC_D:	move.b	d(a3),target_8(a3)
	RXX_	0, 1
	move.b	d0,d(a3)
	jmp	(a6)
RRC_E:	move.b	e(a3),target_8(a3)
	RXX_	0, 1
	move.b	d0,e(a3)
	jmp	(a6)
RRC_H:	move.b	h(a3),target_8(a3)
	RXX_	0, 1
	move.b	d0,h(a3)
	jmp	(a6)
RRC_L:	move.b	l(a3),target_8(a3)
	RXX_	0, 1
	move.b	d0,l(a3)
	jmp	(a6)
RRC_lHLl:
	; (HL) の場合はサイクル数が15なので7を足す
	addq.l	#7,a5
	move.w	hl(a3),d0
	read_mem_8	rd8f29,rd8s29,rd8e29
	move.b	d0,target_8(a3)
	RXX_	0, 1
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f15,wr8s15,wr8e15
	jmp	(a6)

*	------ ＲＬ ------
RL_A:	move.b	d4,target_8(a3)
	RXX_	1, 0
	move.b	d0,d4
	jmp	(a6)
RL_B:	move.b	b(a3),target_8(a3)
	RXX_	1, 0
	move.b	d0,b(a3)
	jmp	(a6)
RL_C:	move.b	c(a3),target_8(a3)
	RXX_	1, 0
	move.b	d0,c(a3)
	jmp	(a6)
RL_D:	move.b	d(a3),target_8(a3)
	RXX_	1, 0
	move.b	d0,d(a3)
	jmp	(a6)
RL_E:	move.b	e(a3),target_8(a3)
	RXX_	1, 0
	move.b	d0,e(a3)
	jmp	(a6)
RL_H:	move.b	h(a3),target_8(a3)
	RXX_	1, 0
	move.b	d0,h(a3)
	jmp	(a6)
RL_L:	move.b	l(a3),target_8(a3)
	RXX_	1, 0
	move.b	d0,l(a3)
	jmp	(a6)
RL_lHLl:
	; (HL) の場合はサイクル数が15なので7を足す
	addq.l	#7,a5
	move.w	hl(a3),d0
	read_mem_8	rd8f30,rd8s30,rd8e30
	move.b	d0,target_8(a3)
	RXX_	1, 0
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f16,wr8s16,wr8e16
	jmp	(a6)

*	------ ＲＲ ------
RR_A:	move.b	d4,target_8(a3)
	RXX_	0, 0
	move.b	d0,d4
	jmp	(a6)
RR_B:	move.b	b(a3),target_8(a3)
	RXX_	0, 0
	move.b	d0,b(a3)
	jmp	(a6)
RR_C:	move.b	c(a3),target_8(a3)
	RXX_	0, 0
	move.b	d0,c(a3)
	jmp	(a6)
RR_D:	move.b	d(a3),target_8(a3)
	RXX_	0, 0
	move.b	d0,d(a3)
	jmp	(a6)
RR_E:	move.b	e(a3),target_8(a3)
	RXX_	0, 0
	move.b	d0,e(a3)
	jmp	(a6)
RR_H:	move.b	h(a3),target_8(a3)
	RXX_	0, 0
	move.b	d0,h(a3)
	jmp	(a6)
RR_L:	move.b	l(a3),target_8(a3)
	RXX_	0, 0
	move.b	d0,l(a3)
	jmp	(a6)
RR_lHLl:
	; (HL) の場合はサイクル数が15なので7を足す
	addq.l	#7,a5
	move.w	hl(a3),d0
	read_mem_8	rd8f31,rd8s31,rd8e31
	move.b	d0,target_8(a3)
	RXX_	0, 0
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f17,wr8s17,wr8e17
	jmp	(a6)

;
; SLA, SRA, SLI, SRL のシフトをまとめたマクロ
;
; フラグの挙動は以下の通り
; * S : 結果の最上位ビット
; * Z : 結果が0なら1。それ以外の時は0
; * F5: 結果のbit5
; * H : 0
; * F3: 結果のbit3
; * PV: 結果のパリティ
; * N : 0
; * C : 命令による(SLA:はみ出た値、SRA:はみ出た値、SLI:はみ出た値、SRL:はみ出た値)
;
; RXXほどの対称性はないのでちょっと分かりづらいが、以下のような動作をする
; * SLA: 左に1ビットシフト、bit0には0が入る、はみ出た値は C フラグにセット
; * SRA: 右に1ビットシフト、bit7は元の値の最上位ビット、はみ出た値は C フラグにセット
; * SLI: 左に1ビットシフト、bit0には1が入る、はみ出た値は C フラグにセット(未定義命令)
; * SRL: 右に1ビットシフト、bit7は0、はみ出た値は C フラグにセット
;
; 以上を１つのマクロで実現するため、isLeft, insert という２つの引数を使っている
; * isLeft: 1の時は左シフト、0の時は右シフト
; * insert : 0の時は0を挿入、1の時は1を挿入、2の時は 最上位ビットの値を挿入
SXX	macro	isLeft, insert
	; 差し込むのは 0／1／bit7 のいずれかで、演算前の C は要らない
	move.b	target_8(a3),d0
	.if insert=0
	  andi.b	#%11101111,ccr	; Xフラグをリセット
	.elseif insert=1
	  ori.b		#%00010000,ccr	; Xフラグをセット
	.else
	  btst	#7,d0
	  bne	1f
	  andi.b	#%11101111,ccr	; Xフラグをリセット
	  bra	2f
1: 	  ori.b		#%00010000,ccr	; Xフラグをセット
2:
	.endif
	.if isLeft
	  roxl.b	#1,d0			; Xフラグを使えるのはローテートだけなのでローテートを使う
	.else
	  roxr.b	#1,d0			; Xフラグを使えるのはローテートだけなのでローテートを使う	
	.endif

	; はみ出したビットが C。S,Z,F5,F3,P/V は結果から表 1 回で引ける。H=0、N=0。
	scs	d1			* C（Scc は CCR を変えない）
	andi.b	#%00000001,d1
	moveq.l	#0,d3
	move.b	d0,d3			* 結果
	move.b	szp53p(a3,d3.w),d3		* S,Z,F5,F3,P/V を一度に引く
	or.b	d3,d1
	moveq.l	#0,d6
	move.b	d1,d6
	endm

*	------ ＳＬＡ ------
SLA_A:
	move.b	d4,target_8(a3)
	SXX	1, 0
	move.b	d0,d4
	jmp	(a6)
SLA_B:
	move.b	b(a3),target_8(a3)
	SXX	1, 0
	move.b	d0,b(a3)
	jmp	(a6)
SLA_C:
	move.b	c(a3),target_8(a3)
	SXX	1, 0
	move.b	d0,c(a3)
	jmp	(a6)
SLA_D:
	move.b	d(a3),target_8(a3)
	SXX	1, 0
	move.b	d0,d(a3)
	jmp	(a6)
SLA_E:
	move.b	e(a3),target_8(a3)
	SXX	1, 0
	move.b	d0,e(a3)
	jmp	(a6)
SLA_H:
	move.b	h(a3),target_8(a3)
	SXX	1, 0
	move.b	d0,h(a3)
	jmp	(a6)
SLA_L:
	move.b	l(a3),target_8(a3)
	SXX	1, 0
	move.b	d0,l(a3)
	jmp	(a6)
SLA_lHLl:
	; (HL) の場合はサイクル数が15なので7を足す
	addq.l	#7,a5
	move.w	hl(a3),d0
	read_mem_8	rd8f32,rd8s32,rd8e32
	move.b	d0,target_8(a3)
	SXX	1, 0
	move.b	d0,d1
	move.w	hl(a3),d0
	write_mem_8	wr8f18,wr8s18,wr8e18
	jmp	(a6)

*	------ ＳＲＡ ------
