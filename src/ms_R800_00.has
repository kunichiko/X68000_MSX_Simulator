OR_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f21,rd8s21,rd8e21
	_OR_X	or
	jmp	(a6)

OR_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	OR_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	OR_n_o
	lea.l	OR_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
OR_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
OR_n:	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	_OR_X	or
	jmp	(a6)

*	------ ＣＰ ------
;---------------------------------------------------------------------------------------
; CP X の挙動は以下の通り
; * S : 結果の最上位ビット
; * Z : 結果が0の時 1、それ以外の時 0
; * F5: 引く n の bit5 (SUBとは動作が違う)
; * H : 演算の結果
; * F3: 引く n の bit3 (SUBとは動作が違う)
; * PV: 演算の結果のオーバーフロー
; * N : 1
; * C : 演算の結果のキャリー
CP_A_X	macro
* フラグを 8 つとも確定させる。ダーティビットは一つも立てない。
*   H  ＝ (第1項 ^ 第2項 ^ 結果) の bit4
*   C  ＝ 68000 の演算が立てる X（ANDI は X を変えないので roxl で拾える）
*   P/V ＝ 68000 の演算が立てる V
*   S・F5・F3 ＝ 結果のビットをそのまま取る
*   Z  ＝ 結果がゼロか
* CP の F5・F3 は結果ではなく第2オペランドから取る（Z80 の仕様）。
	move.b	d4,d1			* 第1項
	eor.b	d0,d1			* 第1項 ^ 第2項
	move.b	d4,d3			* A を d3 へ。結果はここだけに作る
	sub.b	d0,d3			* 比較（A は壊さない）。C・V・X が確定する
	svs	d2			* ★d2 は DD/FD の識別に使われるが、CP の呼び出し元では
	andi.b	#%00000010,d2		*   すでに用済み（ix/iy を選び終えている）
	roxl.b	#1,d2			* V→bit2、X(＝C)→bit0
	eor.b	d3,d1
	andi.b	#%00010000,d1		* bit4 ＝ H
	or.b	d2,d1
	andi.b	#%00101000,d0		* 第2オペランドの F5,F3（CP は結果から取らない）
	or.b	d0,d1
	move.b	d3,d2			* 結果
	andi.b	#%10000000,d2		* S
	tst.b	d3
	bne	@f
	ori.b	#%01000000,d2		* Z
@@:	or.b	d2,d1
	ori.b	#%00000010,d1		* N=1
	moveq.l	#0,d6			* ダーティも F も全部落とす
	move.b	d1,d6
	endm
;---------------------------------------------------------------------------------------

CP_A_h:
	addq.w	#4,a5
CP_A:
* A と A の比較なので結果は必ず 0。A は変わらない。
* CP の F5,F3 は結果ではなく第2オペランド（＝A）から取る。
	move.b	d4,d6			* d6 の bit8 以上は常に 0 なのでバイト転送でよい
	andi.b	#%00101000,d6		* F5,F3
	ori.b	#%01000010,d6		* Z=1, N=1
	jmp	(a6)

CP_B_h:
	addq.w	#4,a5
CP_B:	move.b	b(a3),d0
	CP_A_X
	jmp	(a6)

CP_C_h:
	addq.w	#4,a5
CP_C:	move.b	c(a3),d0
	CP_A_X
	jmp	(a6)

CP_D_h:
	addq.w	#4,a5
CP_D:	move.b	d(a3),d0
	CP_A_X
	jmp	(a6)

CP_E_h:
	addq.w	#4,a5
CP_E:	move.b	e(a3),d0
	CP_A_X
	jmp	(a6)

CP_H_h:
	addq.w	#4,a5
CP_H:	move.b	h(a3),d0
	CP_A_X
	jmp	(a6)

CP_L_h:
	addq.w	#4,a5
CP_L:	move.b	l(a3),d0
	CP_A_X
	jmp	(a6)

CP_lHLl_h:
	addq.w	#7,a5
CP_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f22,rd8s22,rd8e22
	CP_A_X
	jmp	(a6)

CP_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	CP_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	CP_n_o
	lea.l	CP_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
CP_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
CP_n:	* オペランド列からnを取り出す
	move.b	(a4)+,d0
	CP_A_X
	jmp	(a6)

*	------ ＩＮＣ ------
;---------------------------------------------------------------------------------------
INC_X	macro
* フラグをその場で組み立てる。C は変化しないので残す。
*   H  ＝ (元の値 ^ 結果) の bit4（+1 の bit4 は 0 なので元 ^ 結果で出る）
*   P/V ＝ 元が $7F のとき（符号付き桁溢れ）
	move.b	target_8(a3),d0		* 元の値
	move.b	d0,d1
	addq.b	#1,d0			* 演算実行
	eor.b	d0,d1			* 元 ^ 結果
	andi.b	#%00010000,d1		* bit4 ＝ H
	cmpi.b	#$80,d0			* 結果が $80 ＝ $7F からの桁溢れ
	bne	@f
	ori.b	#%00000100,d1		* P/V
@@:	move.b	d0,d3
	andi.b	#%10101000,d3		* S,F5,F3
	tst.b	d0
	bne	@f
	ori.b	#%01000000,d3		* Z
@@:	or.b	d3,d1
	andi.b	#%00000001,d6		* Ｃ だけ残す
	or.b	d1,d6
	endm
;---------------------------------------------------------------------------------------

INC_A_h:
	addq.w	#4,a5
INC_A:	move.b	d4,target_8(a3)
	INC_X
	move.b	d0,d4			* 結果を反映
	jmp	(a6)

INC_B_h:
	addq.w	#4,a5
INC_B:	move.b	b(a3),target_8(a3)
	INC_X
	move.b	d0,b(a3)		* 結果を反映
	jmp	(a6)

INC_C_h:
	addq.w	#4,a5
INC_C:	move.b	c(a3),target_8(a3)
	INC_X
	move.b	d0,c(a3)		* 結果を反映
	jmp	(a6)

INC_D_h:
	addq.w	#4,a5
INC_D:	move.b	d(a3),target_8(a3)
	INC_X
	move.b	d0,d(a3)		* 結果を反映
	jmp	(a6)

INC_E_h:
	addq.w	#4,a5
INC_E:	move.b	e(a3),target_8(a3)
	INC_X
	move.b	d0,e(a3)		* 結果を反映
	jmp	(a6)

INC_H_h:
	addq.w	#4,a5
INC_H:	move.b	h(a3),target_8(a3)
	INC_X
	move.b	d0,h(a3)		* 結果を反映
	jmp	(a6)

INC_L_h:
	addq.w	#4,a5
INC_L:	move.b	l(a3),target_8(a3)
	INC_X
	move.b	d0,l(a3)		* 結果を反映
	jmp	(a6)

INC_lHLl_h:
	lea.l	11(a5),a5
INC_lHLl:
	move.w	hl(a3),d0		* d0にHLの値をロード
	read_mem_8	rd8f23,rd8s23,rd8e23
	move.b	d0,target_8(a3)		* D0 には (HL)の値が入っている
	INC_X
	move.b	d0,d1			* インクリメントした結果が d0に入っているので d1 に退避
	move.w	hl(a3),d0		* d0 には HL の値が入っている
	write_mem_8	wr8f48,wr8s48,wr8e48	* (HL) に結果を書き込む
	jmp	(a6)

;---------------------------------------------------------------------------------------
; INC_XX
;---------------------------------------------------------------------------------------

INC_BC_h:
	addq.w	#6,a5
INC_BC:	addq.w	#1,bc(a3)
	jmp	(a6)

INC_DE_h:
	addq.w	#6,a5
INC_DE:	addq.w	#1,de(a3)
	jmp	(a6)

INC_HL_h:
	addq.w	#6,a5
INC_HL:	addq.w	#1,hl(a3)
	jmp	(a6)

INC_SP_h:
	addq.w	#6,a5
INC_SP:	addq.w	#1,sp_(a3)
	jmp	(a6)

*	------ ＤＥＣ ------
;---------------------------------------------------------------------------------------
DEC_X	macro
* INC_X と同じ理屈で即時化する。C は変化しないのでダーティビットごと残す。
*   H  ＝ (元の値 ^ 結果) の bit4（借りの発生）
*   P/V ＝ 元が $80 のとき（符号付き桁溢れ）
	move.b	target_8(a3),d0		* 元の値
	move.b	d0,d1
	subq.b	#1,d0			* 演算実行
	eor.b	d0,d1			* 元 ^ 結果
	andi.b	#%00010000,d1		* bit4 ＝ H
	cmpi.b	#$7f,d0			* 結果が $7F ＝ $80 からの桁溢れ
	bne	@f
	ori.b	#%00000100,d1		* P/V
@@:	move.b	d0,d3
	andi.b	#%10101000,d3		* S,F5,F3
	tst.b	d0
	bne	@f
	ori.b	#%01000000,d3		* Z
@@:	or.b	d3,d1
	ori.b	#%00000010,d1		* N=1
	andi.b	#%00000001,d6		* Ｃ だけ残す
	or.b	d1,d6
	endm
;---------------------------------------------------------------------------------------

DEC_A_h:
	addq.w	#4,a5
DEC_A:	move.b	d4,target_8(a3)
	DEC_X
	move.b	d0,d4			* 結果を反映
	jmp	(a6)

DEC_B_h:
	addq.w	#4,a5
DEC_B:	move.b	b(a3),target_8(a3)
	DEC_X
	move.b	d0,b(a3)		* 結果を反映
	jmp	(a6)

DEC_C_h:
	addq.w	#4,a5
DEC_C:	move.b	c(a3),target_8(a3)
	DEC_X
	move.b	d0,c(a3)		* 結果を反映
	jmp	(a6)

DEC_D_h:
	addq.w	#4,a5
DEC_D:	move.b	d(a3),target_8(a3)
	DEC_X
	move.b	d0,d(a3)		* 結果を反映
	jmp	(a6)

DEC_E_h:
	addq.w	#4,a5
DEC_E:	move.b	e(a3),target_8(a3)
	DEC_X
	move.b	d0,e(a3)		* 結果を反映
	jmp	(a6)

DEC_H_h:
	addq.w	#4,a5
DEC_H:	move.b	h(a3),target_8(a3)
	DEC_X
	move.b	d0,h(a3)		* 結果を反映
	jmp	(a6)

DEC_L_h:
	addq.w	#4,a5
DEC_L:	move.b	l(a3),target_8(a3)
	DEC_X
	move.b	d0,l(a3)		* 結果を反映
	jmp	(a6)

DEC_lHLl_h:
	lea.l	11(a5),a5
DEC_lHLl:
	move.w	hl(a3),d0		* d0にHLの値をロード
	read_mem_8	rd8f24,rd8s24,rd8e24
	move.b	d0,target_8(a3)		* d0 には (HL)の値が入っている
	DEC_X
	move.b	d0,d1			* デクリメントした結果が d0に入っているので d1 に退避
	move.w	hl(a3),d0		* d0 には HL の値が入っている
	write_mem_8	wr8f49,wr8s49,wr8e49	* (HL) に結果を書き込む
	jmp	(a6)

;---------------------------------------------------------------------------------------
; DEC_XX
;---------------------------------------------------------------------------------------

DEC_BC_h:
	addq.w	#6,a5
DEC_BC:	subq.w	#1,bc(a3)
	jmp	(a6)

DEC_DE_h:
	addq.w	#6,a5
DEC_DE:	subq.w	#1,de(a3)
	jmp	(a6)

DEC_HL_h:
	addq.w	#6,a5
DEC_HL:	subq.w	#1,hl(a3)
	jmp	(a6)

DEC_SP_h:
	addq.w	#6,a5
DEC_SP:	subq.w	#1,sp_(a3)
	jmp	(a6)


*	DAAの仕様は http://z80-heaven.wikidot.com/instructions-set:daa を参照
*	これによると以下の動きをするらしい：
*	* 直前の演算が加算の時(N=0の時):
*	  1. 下位4ビットに9より大きな値(0xa-f)が入っているか、Hフラグが1の時、0x06を加算する
*	  2. 上位4ビットに9より大きな値(0xa-f)が入っているか、Cフラグが1の時、0x60を加算する
*	* 直前の演算が減算の時(N=1の時):
*	  1. 下位4ビットに9より大きな値(0xa-f)が入っているか、Hフラグが1の時、0x06を減算する
*	  2. 上位4ビットに9より大きな値(0xa-f)が入っているか、Cフラグが1の時、0x60を減算する
*
*	● フラグ変化:
*	* S : 結果のAレジスタが、正なら0、負なら1
*	* Z : 結果のAレジスタが、0なら1、それ以外なら0
*	* F5: 結果のAレジスタの、bit5
*	* H : (ちょっと複雑なので後述)
*	* F3: 結果のAレジスタの、bit3
*	* PV: 結果のAレジスタの、パリティが偶数なら1、奇数なら0)
*	* N : 変化しない
*	* C : 2の操作(0x60の加算or減算)が発生したら1、それ以外なら0
*
*	● Hフラグ変化:
*	DAA後のHフラグは、直前の演算が加算の時(N=0の時)と、減算の時(N=1の時)で異なる。
*	* 加算の時:
*	  補正前に下位4ビットに9より大きな値(0xa-f)が入っていた場合に H フラグがセットされる
*	  →これはBCDの補正処理(+6)によって、下位4ビットが一周する(キャリーが発生する)ことを意味する
*	* 減算の時:
*	  補正前に下位4ビットに6より小さい値(0x0-5)が入っていた場合かつ、Hフラグが立っていた時に H フラグがセットされる
*	  →これはBCDの補正処理(-6)によって、下位4ビットが一周する(キャリーが発生する)ことを意味する
*
*	なので、全体をまとめると、以下のように実装すればいいことになる
*	1. 補正係数を correct = 0とする
*	2. 下位4ビットに9より大きな値(0xa-f)が入っているか、Hフラグが1の時、correct に 0x06 を加算する
*	3. Aレジスタにに0x99より大きな値が入っているか、Cフラグが1の時、correct に 0x60 を加算する
*	4. Nフラグを見て、Aレジスタにcorrectを加算 or 減算する(N=0なら加算、N=1なら減算)
*       5. S,Z,F5,H,F3 は、Aレジスタとcorrectの ADD または SUB の結果と同じになる
*       6. PVは演算結果のパリティになる
*       7. Cは上位4ビットの補正があった場合に1、それ以外は0になる
*
*	------ ＤＡＡ ------
DAA_h:
	addq.w	#4,a5
DAA:
1:
	clr.w	d0			* 補正係数を 0 に初期化
	move.b	d4,d1
	andi.b	#$0f,d1			* 下位4ビットを取り出す
	cmpi.b	#$09,d1			* 下位4ビットが9より大きい？
	bgt	2f
	btst	#4,d6			* H フラグを調べる
	beq	3f
2:	moveq.l	#$06,d0			* 補正係数に 0x06
3:	clr.w	d1
	move.b	d4,d1
	cmpi.w	#$99,d1			* 0x99より大きい？
	bgt	4f
	btst	#0,d6			* C フラグを調べる
	beq	5f
4:	addi.b	#$60,d0			* 補正係数に 0x60 を加算
5:	move.b	d4,d1			* 補正前の Ａ
	btst.l	#1,d6			* N フラグを調べる
	bne	6f
	add.b	d0,d4			* 補正係数を加算
	bra	7f
6:	sub.b	d0,d4			* 補正係数を減算
7:	eor.b	d4,d1			* 補正前 ^ 補正後 → bit4 ＝ H
	andi.b	#%00010000,d1
	andi.b	#$f0,d0			* 上位4ビットの補正があったか
	beq	8f
	addq.b	#1,d1			* Ｃ をセット
8:	or.b	szp53p(a3,d4.w),d1	* S,Z,F5,F3,P/V
	andi.b	#%00000010,d6		* Ｎ だけ残す
	or.b	d1,d6
	jmp	(a6)


*	------ ＪＰ ------
JP_h:
	lea.l	10(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	JP(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_3
	.else
	ble.s	JP_o
	lea.l	JP(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_3
JP_o:	addq.w	#2,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
JP:	* オペランド列からnnを取り出す
	move.b	(a4)+,d0		* オペランドの下位バイト
	move.b	(a4)+,d1		* オペランドの上位バイト
	lsl.w	#8,d1			* 上位へ送る。下位バイトは 0 になる
	move.b	d0,d1			* 下位バイトを入れる
	move.w	d1,d7
	PC_page_set
	jmp	(a6)

JP_lHLl_h:
	addq.w	#4,a5
JP_lHLl:
	move.w	hl(a3),d7
	PC_page_set
	jmp	(a6)

JP_C_h:
	lea.l	10(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	JP_C(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_3
	.else
	ble.s	JP_C_o
	lea.l	JP_C(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_3
JP_C_o:	addq.w	#2,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
JP_C:
@@:
	btst.l	#0,d6		* Cフラグをテスト
	bne	JP		* Cが１ならジャンプ
	addq.w	#2,a4			* 分岐しない時はオペランドを読まないので進めておく
	jmp	(a6)

JP_NC_h:
	lea.l	10(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	JP_NC(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_3
	.else
	ble.s	JP_NC_o
	lea.l	JP_NC(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_3
JP_NC_o:	addq.w	#2,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
JP_NC:
@@:
	btst.l	#0,d6		* Cフラグをテスト
	beq	JP		* Cが０ならジャンプ
	addq.w	#2,a4			* 分岐しない時はオペランドを読まないので進めておく
	jmp	(a6)

JP_Z_h:
	lea.l	10(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
