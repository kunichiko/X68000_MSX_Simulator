LD_A_H:	move.b	h(a3),d4
	jmp	(a6)

LD_A_L_h:
	addq.w	#4,a5
LD_A_L:	move.b	l(a3),d4
	jmp	(a6)

LD_A_lHLl_h:
	addq.w	#7,a5
LD_A_lHLl:
	move.w	hl(a3),d0
	read_mem_8	rd8f5,rd8s5,rd8e5
	move.b	d0,d4
	jmp	(a6)

LD_A_lBCl_h:
	addq.w	#7,a5
LD_A_lBCl:
	move.w	bc(a3),d0
	read_mem_8	rd8f6,rd8s6,rd8e6
	move.b	d0,d4
	jmp	(a6)

LD_A_lDEl_h:
	addq.w	#7,a5
LD_A_lDEl:
	move.w	de(a3),d0
	read_mem_8	rd8f7,rd8s7,rd8e7
	move.b	d0,d4
	jmp	(a6)

LD_A_lnnl_h:
	lea.l	13(a5),a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	LD_A_lnnl(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_3
	.else
	ble.s	LD_A_lnnl_o
	lea.l	LD_A_lnnl(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_3
LD_A_lnnl_o:	addq.w	#2,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
LD_A_lnnl:
	* オペランド列からnnを取り出す
	move.b	(a4)+,d0		* オペランドの下位バイト
	move.b	(a4)+,d1		* オペランドの上位バイト
	lsl.w	#8,d1			* 上位へ送る。下位バイトは 0 になる
	move.b	d0,d1			* 下位バイトを入れる
	move.w	d1,d0
	read_mem_8	rd8f8,rd8s8,rd8e8
	move.b	d0,d4
	jmp	(a6)

LD_A_n_h:
	addq.w	#7,a5
	cmpi.w	#-4,d7	* オペランドがページ境界をまたぐか？
	.ifdef	EDGEALWAYS
	lea.l	LD_A_n(pc),a0		* 検証用: 常にエッジ処理を通す
	jmp	cpu_edge_2
	.else
	ble.s	LD_A_n_o
	lea.l	LD_A_n(pc),a0		* コールドパス。本体の先頭を渡す
	jmp	cpu_edge_2
LD_A_n_o:	addq.w	#1,d7			* 残りの PC 前進。a4 は (a4)+ で進む
	.endif
LD_A_n:	* オペランド列からnを取り出す
	move.b	(a4)+,d4
	jmp	(a6)

