LD_SP_lnnl_h:
	lea.l	20(a5),a5
	addq.w	#2,d7			* オペランドのぶん PC を進める
	addq.w	#2,a4
	btst.l	#PAGEADDRBIT,d7		* 位置が負のままなら境界を越えていない
	bne	LD_SP_lnnl_h9
	PC_page_inc
LD_SP_lnnl_h9:
LD_SP_lnnl:
	* オペランド列からnnを取り出す
	move.b	-1(a4),d1		* オペランドの上位バイト
	ror.w	#8,d1
	move.b	-2(a4),d1		* オペランドの下位バイト
	move.w	d1,d0			* d0.w = nn
	read_mem_16	rd16f10,rd16s10,rd16e10
	move.w	d0,sp_(a3)
	jmp	(a6)

*	------ ＬＤ (nn),ＸＸ ------
LD_lnnl_BC_h:
